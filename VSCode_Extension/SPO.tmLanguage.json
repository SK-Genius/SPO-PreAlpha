{
	"scopeName": "source.spo",
	"name": "SPO",
	"patterns": [
		{ "include": "#strings" },
		{ "include": "#numbers" },
		{ "include": "#keywords" },
		{ "include": "#enumMembers" },
		{ "include": "#idents" }
	],
	"repository": {
		"strings": {
			"patterns": [
				{ "name": "string.quoted.double.spo", "begin": "\"", "end": "\"" }
			]
		},
		"keywords": {
			"patterns": [
				{ "name": "keyword.control.spo", "match": "\u00A7[^\\(\\)\\[\\]\\{\\}.,\\:;\u00A7\u20AC\\s]+" }
			]
		},
		"enumMembers": {
			"patterns": [
				{ "name": "constant.language.atom.spo", "match": "#([^\\(\\)\\[\\]\\{\\}.,\\:;\u00A7\u20AC\\s]|(\\.\\.\\.))+" }
			]
		},
		"idents": {
			"patterns": [
				{ "name": "variable.other.spo", "match": "([^\\(\\)\\[\\]\\{\\}.,\\:;\u00A7\u20AC\\s]|(\\.\\.\\.))+" }
			]
		},
		"numbers": {
			"patterns": [
				{ "name": "constant.numeric.spo", "match": "\\b(\\d+(?:'\\d+)*(?:\\.\\d+(?:'\\d+)*)?)\\b" }
			]
		}
	}
}
