{
	"comments": { "lineComment": "//", "blockComment": ["/*","*/"] },
	"brackets": [
		[ "{", "}" ],
		[ "[", "]" ],
		[ "(", ")" ]
	],
	"surroundingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"" }
	]
}
