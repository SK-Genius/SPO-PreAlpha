§IMPORT (
	{
		...<...: §DEF ...<... € [[§INT, §INT] => §BOOL]
		...+...: §DEF ...+... € [[§INT, §INT] => §INT]
		...-...: §DEF ...-... € [[§INT, §INT] => §INT]
	}
	§DEF n € §INT
)

§RECURSIVE {
	§DEF Fib... = (§DEF x € §INT) => §IF x MATCH {
		(§DEF a & a .< 2) => a
		§DEF a => (.Fib(a .- 2)) .+ (.Fib(a .- 1))
	}
}

§EXPORT .Fib n
