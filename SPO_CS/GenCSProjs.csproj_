<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<OutputType>Exe</OutputType>
		<!-- Exe | Library | Module | Winexe -->
		
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<DefineConstants>noMY_TRACE;DISABLE_DEBUGGER_HIDDEN</DefineConstants>
		<InvariantGlobalization>true</InvariantGlobalization>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
		<AnalysisLevel>preview-all</AnalysisLevel>
		<NoWarn>659,661,8604,8618</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	
	<ItemGroup>
		<Compile Include="GenCSProjs.cs" />
		<Compile Include="src\_GlobalUsings.cs" />
		<Compile Include="src\Common\*.cs" />
	</ItemGroup>
	
</Project>
