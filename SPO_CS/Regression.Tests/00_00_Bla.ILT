§TYPES
	t_0 := [INT | EMPTY_TYPE]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [t_1, t_0]
	t_3 := [#Result INT]
	t_4 := [EMPTY_TYPE | t_3]
	t_5 := [t_2 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [t_2 => INT]
	t_8 := [EMPTY_TYPE => t_7]
	t_9 := [EMPTY_TYPE, t_8]
	t_10 := [t_9, t_8]
	t_11 := [t_10, t_8]
	t_12 := [t_11, t_8]
	t_13 := [t_2 => t_3]
	t_14 := [t_12 => t_13]
	t_15 := [t_12, t_14]
	t_16 := [EMPTY_TYPE => INT]
	t_17 := [t_15 => t_16]

§DEF d_0 € t_6
	r_1 := §TRY ARG AS_PAIR
	r_2 := §1ST r_1
	r_3 := §2ND r_1
	r_4 := §TRY r_2 AS_PAIR
	r_5 := §1ST r_4
	r_6 := §2ND r_4
	r_7 := §TRY r_5 AS_EMPTY
	r_8 := §TRY r_6 AS_EMPTY
	r_9 := §TRY r_3 AS_EMPTY
	r_10 := 1
	r_11 := +#Result r_10
	§RETURN r_11 IF TRUE

§DEF d_1 € t_6
	r_1 := §TRY ARG AS_PAIR
	r_2 := §1ST r_1
	r_3 := §2ND r_1
	r_4 := §TRY r_2 AS_PAIR
	r_5 := §1ST r_4
	r_6 := §2ND r_4
	r_7 := §TRY r_5 AS_EMPTY
	r_8 := §TRY r_6 AS_EMPTY
	r_9 := 2
	r_10 := +#Result r_9
	§RETURN r_10 IF TRUE

§DEF d_2 € t_6
	r_1 := §TRY ARG AS_PAIR
	r_2 := §1ST r_1
	r_3 := §2ND r_1
	r_4 := §TRY r_2 AS_PAIR
	r_5 := §1ST r_4
	r_6 := §2ND r_4
	r_7 := §TRY r_5 AS_EMPTY
	r_8 := §TRY r_3 AS_EMPTY
	r_9 := 3
	r_10 := +#Result r_9
	§RETURN r_10 IF TRUE

§DEF d_3 € t_6
	r_1 := §TRY ARG AS_PAIR
	r_2 := §1ST r_1
	r_3 := §2ND r_1
	r_4 := §TRY r_2 AS_PAIR
	r_5 := §1ST r_4
	r_6 := §2ND r_4
	r_7 := §TRY r_5 AS_EMPTY
	r_8 := 4
	r_9 := +#Result r_8
	§RETURN r_9 IF TRUE

§DEF d_4 € t_14
	d_3 := §2ND ENV
	r_9 := §1ST ENV
	d_2 := §2ND r_9
	r_10 := §1ST r_9
	d_1 := §2ND r_10
	r_11 := §1ST r_10
	d_0 := §2ND r_11
	r_12 := §1ST r_11
	r_1 := .d_0 EMPTY
	r_2 := .r_1 ARG
	§RETURN r_2 IF_NOT_EMPTY
	r_3 := .d_1 EMPTY
	r_4 := .r_3 ARG
	§RETURN r_4 IF_NOT_EMPTY
	r_5 := .d_2 EMPTY
	r_6 := .r_5 ARG
	§RETURN r_6 IF_NOT_EMPTY
	r_7 := .d_3 EMPTY
	r_8 := .r_7 ARG
	§RETURN r_8 IF_NOT_EMPTY
	§RETURN EMPTY IF TRUE

§DEF d_5 € t_17
	d_4 := §2ND ENV
	r_12 := §1ST ENV
	d_3 := §2ND r_12
	r_13 := §1ST r_12
	d_2 := §2ND r_13
	r_14 := §1ST r_13
	d_1 := §2ND r_14
	r_15 := §1ST r_14
	d_0 := §2ND r_15
	r_16 := §1ST r_15
	r_1 := 1
	_X := r_1
	r_2 := 2
	_Y := r_2
	r_3 := EMPTY, _X
	r_4 := r_3, _Y
	r_5 := EMPTY, d_0
	r_6 := r_5, d_1
	r_7 := r_6, d_2
	r_8 := r_7, d_3
	r_9 := .d_4 r_8
	r_10 := .r_9 r_4
	r_11 := -#Result r_10
	§RETURN r_11 IF TRUE
