§IMPORT {
	...*...: §DEF ...*... € [[§INT, §INT] => §INT]
}

§DEF tArray = [§GENERIC t [§RECURSIVE tArray [[] | [tArray; t]]]]

§RECURSIVE {
	§DEF ...MapEachWith... = (
		§DEF tIn € [[]]
		§DEF tOut € [[]]
	) <=> (
		§DEF aArray € [.tArray tIn]
		§DEF aMap... € [tIn => tOut]
	) => §IF aArray MATCH {
		() => ()
		(aTail € [.tArray tIn]; §DEF aHead € tIn) => (aTail .MapEachWith aMap...; .aMap aHead)
	}
}

§EXPORT (
	(1, 2, 3) .MapEachWith (
		§DEF a € §INT => 2 .* a
	)
)
