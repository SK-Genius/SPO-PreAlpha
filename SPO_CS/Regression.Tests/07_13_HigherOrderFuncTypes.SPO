§IMPORT {
	...*...: §DEF ...*... € [[§INT, §INT] => §INT]
}

§DEF tStack = [§GENERIC t [§RECURSIVE tStack [[] | [t, tStack]]]]

§DEF ...Append... = (
	§DEF t € [[]]
) <=> (
	§DEF aTail € [.tStack t]
	§DEF aHead € t
) => (aHead, aTail)

§RECURSIVE {
	§DEF ...MapEachWith... = (
		§DEF tIn € [[]]
		§DEF tOut € [[]]
	) <=> (
		§DEF aStack € [.tStack tIn]
		§DEF aMap... € [tIn => tOut]
	) => §IF aStack MATCH {
		() => ()
		(§DEF aHead, aTail) => (aTail .MapEachWith aMap...) .Append (.aMap aHead)
	}
}

§EXPORT (
	() .Append 1 §>.Append 2 §>.Append 3 §>.MapEachWith (
		§DEF a € §INT => 2 .* a
	)
)
