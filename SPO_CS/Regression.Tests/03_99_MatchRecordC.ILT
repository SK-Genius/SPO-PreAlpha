§DEF d_0 € t_7
	r_1 := §TRY ARG AS_RECORD
	r_2 := {r_1} #_First
	r_3 := §TRY r_2 AS_INT
	r_4 := 0
	r_5 := §INT r_3 == r_4
	r_6 := §BOOL r_5 ^ TRUE
	§RETURN EMPTY IF r_6
	r_7 := {r_1} #_Second
	_Value := r_7
	r_8 := +#Result _Value
	§RETURN r_8 IF TRUE

§DEF d_1 € t_7
	r_1 := §TRY ARG AS_RECORD
	r_2 := {r_1} #_First
	_Value := r_2
	r_3 := {r_1} #_Second
	r_4 := +#Result _Value
	§RETURN r_4 IF TRUE

§DEF d_2 € t_29
	d_1 := §2ND ENV
	r_5 := §1ST ENV
	d_0 := §2ND r_5
	r_6 := §1ST r_5
	r_1 := .d_0 EMPTY
	r_2 := .r_1 ARG
	§RETURN r_2 IF_NOT_EMPTY
	r_3 := .d_1 EMPTY
	r_4 := .r_3 ARG
	§RETURN r_4 IF_NOT_EMPTY
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_52
	d_2 := §2ND ENV
	r_12 := §1ST ENV
	d_1 := §2ND r_12
	r_13 := §1ST r_12
	d_0 := §2ND r_13
	r_14 := §1ST r_13
	r_1 := 0
	r_2 := +#_First r_1
	r_3 := {EMPTY} + r_2
	r_4 := 5
	r_5 := +#_Second r_4
	r_6 := {r_3} + r_5
	r_7 := EMPTY, d_0
	r_8 := r_7, d_1
	r_9 := .d_2 r_8
	r_10 := .r_9 r_6
	r_11 := -#Result r_10
	§RETURN r_11 IF TRUE
