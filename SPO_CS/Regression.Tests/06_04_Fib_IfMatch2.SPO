§IMPORT {
	...<...: §DEF ...<... € [[§INT, §INT] => §BOOL]
	...+...: §DEF ...+... € [[§INT, §INT] => §INT]
	...-...: §DEF ...-... € [[§INT, §INT] => §INT]
}

§RECURSIVE {
	§DEF Fib... = (
		§DEF a € §INT
	) => §IF a MATCH {
		(§DEF N & N .< 2) : a
		§DEF N : (.Fib(N .- 2)) .+ (.Fib(N .- 1))
	}
}

§EXPORT (
	.Fib 0
	.Fib 1
	.Fib 2
	.Fib 3
	.Fib 4
	.Fib 5
	.Fib 6
)