§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [§FREE]
	t_2 := [t_0, t_1]
	t_3 := [t_2 | EMPTY_TYPE]
	t_4 := [§REC t_1 => t_3]
	t_5 := [t_0, t_4]
	t_6 := [t_5 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE => t_5]
	t_9 := [t_7 => t_8]

§DEF d_0 € t_7
	r_1 := §2ND ARG
	_aTail := r_1
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	_aHead := r_3
	r_4 := §1ST r_2
	r_5 := EMPTY, _aHead
	r_6 := r_5, _aTail
	§RETURN r_6 IF TRUE

§DEF d_1 € t_9
	d_0 := ENV
	_t := [§FREE]
	r_1 := [INT_TYPE, _t]
	r_2 := [r_1 | EMPTY_TYPE]
	r_3 := [§REC _t => r_2]
	_tStack := r_3
	r_4 := .d_0 EMPTY
	_Push...To... := r_4
	r_5 := 3
	r_6 := EMPTY, r_5
	r_7 := 2
	r_8 := EMPTY, r_7
	r_9 := 1
	r_10 := EMPTY, r_9
	r_11 := r_10, EMPTY
	r_12 := ._Push...To... r_11
	r_13 := r_8, r_12
	r_14 := ._Push...To... r_13
	r_15 := r_6, r_14
	r_16 := ._Push...To... r_15
	§RETURN r_16 IF TRUE
