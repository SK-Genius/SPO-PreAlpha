§IMPORT {
	...<...: §DEF ...<... € [[§INT, §INT] => §BOOL]
	...+...: §DEF ...+... € [[§INT, §INT] => §INT]
	...-...: §DEF ...-... € [[§INT, §INT] => §INT]
}

§DEF If...Then...Else... = (
	§DEF c € §BOOL
	§DEF i € [[] => §INT]
	§DEF e € [[] => §INT]
) => {
	§RETURN (.i) IF c
	§RETURN (.e)
}

§RECURSIVE {
	§DEF Fib... = (
		§DEF a € §INT
	) => .If (a .< 2) Then (
		() => a
	) Else (
		() => (.Fib(a .- 2)) .+ (.Fib(a .- 1))
	)
}

§EXPORT (
	.Fib 0
	.Fib 1
	.Fib 2
	.Fib 3
	.Fib 4
	.Fib 5
	.Fib 6
)	
