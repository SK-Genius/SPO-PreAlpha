§DEF d_0 € t_41
	r_1 := 0
	§RETURN r_1 IF TRUE

§DEF d_1 € t_38
	d_0 := ENV
	r_1 := .d_0 EMPTY
	r_2 := §TRY ARG AS_INT
	r_3 := 1
	r_4 := §INT r_2 == r_3
	r_5 := §BOOL r_4 ^ TRUE
	§RETURN EMPTY IF r_5
	r_6 := .r_1 r_2
	§RETURN r_6 IF TRUE

§DEF d_2 € t_41
	_b := ARG
	§RETURN _b IF TRUE

§DEF d_3 € t_44
	d_2 := §2ND ENV
	r_5 := §1ST ENV
	d_1 := §2ND r_5
	r_6 := §1ST r_5
	d_0 := §2ND r_6
	r_7 := §1ST r_6
	r_1 := .d_1 d_0
	r_2 := .r_1 ARG
	§RETURN r_2 IF_NOT_EMPTY
	r_3 := .d_2 EMPTY
	r_4 := .r_3 ARG
	§RETURN r_4 IF_NOT_EMPTY
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_47
	d_3 := §2ND ENV
	r_7 := §1ST ENV
	d_2 := §2ND r_7
	r_8 := §1ST r_7
	d_1 := §2ND r_8
