§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [EMPTY_TYPE, INT]
	t_4 := [t_3, INT]
	t_5 := [t_4, INT]
	t_6 := [t_5 => INT]
	t_7 := [t_2 => t_6]
	t_8 := [EMPTY_TYPE, INT]
	t_9 := [t_8, INT]
	t_10 := [t_9 => INT]
	t_11 := [EMPTY_TYPE, INT]
	t_12 := [t_11, INT]
	t_13 := [t_12, INT]
	t_14 := [t_13 => INT]
	t_15 := [t_10 => t_14]
	t_16 := [EMPTY_TYPE, INT]
	t_17 := [t_16, INT]
	t_18 := [t_17 => INT]
	t_19 := [#_...*... t_18]
	t_20 := [{EMPTY_TYPE} + t_19]
	t_21 := [t_20 => INT]
	t_22 := [t_15 => t_21]

§DEF d_0 € t_15
	_...*... := ENV
	r_1 := §2ND ARG
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	r_4 := §1ST r_2
	r_5 := §2ND r_4
	_a := r_5
	r_6 := §1ST r_4
	r_7 := 2
	r_8 := EMPTY, r_7
	r_9 := r_8, _a
	r_10 := ._...*... r_9
	§RETURN r_10 IF TRUE

§DEF d_1 € t_22
	d_0 := ENV
	r_1 := {ARG} #_...*...
	_...*... := r_1
	r_2 := .d_0 _...*...
	_F... := r_2
	r_3 := 3
	r_4 := EMPTY, r_3
	r_5 := 5
	r_6 := r_4, r_5
	r_7 := 7
	r_8 := r_6, r_7
	r_9 := ._F... r_8
	§RETURN r_9 IF TRUE
