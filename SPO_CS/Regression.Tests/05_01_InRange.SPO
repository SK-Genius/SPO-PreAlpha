§IMPORT {
	...<=...: §DEF ...<=... € [[§INT, §INT] => §BOOL]
	...&...: §DEF ...&... € [[§BOOL, §BOOL] => §BOOL]
}

§DEF ...<=...<=... = (
	§DEF aMin € §INT
	§DEF aVal € §INT
	§DEF aMax € §INT
) => (aMin .<= aVal) .& (aVal .<= aMax)

§EXPORT (
	1 .<= 1 <= 1
	1 .<= 2 <= 3
	3 .<= 2 <= 1
	3 .<= 1 <= 5
	3 .<= 4 <= 5
	3 .<= 6 <= 5
)
