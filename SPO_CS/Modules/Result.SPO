§DEF tResult... = [
	§GENERIC tError [
		§GENERIC tValue [#Value tValue | #Error tError]
	]
]

§DEF OK... = (
	§DEF tError € §TYPE
	§DEF tValue € §TYPE
) <=> (
	_ € tError
	§DEF Value € tValue
) => #Value Value

§DEF Fail... = (
	§DEF tError € §TYPE
	§DEF tValue € §TYPE
) <=> (
	§DEF Error € tError
	_ € tValue
) => #Error Error

§DEF ...>>... = (
	§DEF tError € §TYPE
	§DEF tIn € §TYPE
	§DEF tOut € §TYPE
) <=> (
	§DEF Value € [.(.tResult tError) tIn]
	§DEF OnValue... € [tIn => tOut]
) => §IF Value MATCH {
	(#Error §DEF Error): (#Error Error)
	(#Value §DEF Inner): (#Value (.OnValue Inner))
}

§DEF ...Or... = (
	§DEF tError € §TYPE
	§DEF tValue € §TYPE
) <=> (
	§DEF Value € [.(.tResult tError) tValue]
	§DEF Fallback € tValue
) => §IF Value MATCH {
	(#Error _): Fallback
	(#Value §DEF Inner): Inner
}

§DEF Contract = [
	§SIG_WITH F € [§TYPE => [§TYPE => §TYPE]] IN [<
		OK...: [
			§GENERIC tError [
				§GENERIC tValue [
					[tError, tValue] => [.(.F tError) tValue]
				]
			]
		]
		Fail...: [
			§GENERIC tError [
				§GENERIC tValue [
					[tError, tValue] => [.(.F tError) tValue]
				]
			]
		]
		...>>...: [
			§GENERIC tError [
				§GENERIC tIn [
					§GENERIC tOut [
						[
							[.(.F tError) tIn]
							tIn => tOut
						] => [.(.F tError) tOut]
					]
				]
			]
		]
		...Or...: [
			§GENERIC tError [
				§GENERIC tValue [
					[
						[.(.F tError) tValue]
						tValue
					] => tValue
				]
			]
		]
	>]
]

§EXPORT §SIG Contract WITH tResult... IN {
	OK...: OK...
	Fail...: Fail...
	...>>...: ...>>...
	...Or...: ...Or...
}