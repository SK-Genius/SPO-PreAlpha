[
	§SIG_WITH F € [§LOAD "../Types/TypeConstructor.SIG"] IN [<
		Some...: [§GENERIC t [t => [.F t]]]
		None...: [§GENERIC t [t => [.F t]]]
		...>>...: [
			§GENERIC tIn [
				§GENERIC tOut [
					[
						.F tIn
						tIn => tOut
					] => [.F tOut]
				]
			]
		]
		...Or...: [
			§GENERIC t [
				[
					.F t
					t
				] => t
			]
		]
	>]
]
