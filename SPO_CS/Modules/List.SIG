[
	§SIG_WITH tList € [§TYPE => §TYPE] IN [<
		EmptyList...: [§GENERIC t [t => [.tList t]]]
		List...: [§GENERIC t [t => [.tList t]]]
		...Push...: [§GENERIC t [[.tList t, t] => [.tList t]]]
		...Prepend...: [§GENERIC t [[.tList t, t] => [.tList t]]]
		...TryPop: [§GENERIC t [[.tList t] => [[.tList t, t] | []]]]
		...Count: [§GENERIC t [[.tList t] => §INT]]
		...IsEmpty: [§GENERIC t [[.tList t] => §BOOL]]
		...TryFirst: [§GENERIC t [[.tList t] => [t | []]]]
		...TryLast: [§GENERIC t [[.tList t] => [t | []]]]
		...TryGet...: [§GENERIC t [[.tList t, §INT] => [t | []]]]
		...TrySetAt...: [§GENERIC t [[.tList t, [§INT, t]] => [[.tList t] | []]]]
		...TryUpdateAt...: [§GENERIC t [[.tList t, [§INT, t => t]] => [[.tList t] | []]]]
		...Map...: [
			§GENERIC tIn [§GENERIC tOut [[.tList tIn, tIn => tOut] => [.tList tOut]]]
		]
		...MapWithIndex...: [
			§GENERIC tIn [§GENERIC tOut [[.tList tIn, [§INT, tIn] => tOut] => [.tList tOut]]]
		]
		...WithIndex: [§GENERIC t [[.tList t] => [.tList [§INT, t]]]]
		...Reduce...: [
			§GENERIC t [§GENERIC tResult [[.tList t, [tResult, [tResult, t] => tResult]] => tResult]]
		]
		...TryReduce...: [§GENERIC t [[.tList t, [t, t] => t] => [t | []]]]
		...Where...: [§GENERIC t [[.tList t, t => §BOOL] => [.tList t]]]
		...Reverse: [§GENERIC t [[.tList t] => [.tList t]]]
		...Take...: [§GENERIC t [[.tList t, §INT] => [.tList t]]]
		...TakeWhile...: [§GENERIC t [[.tList t, t => §BOOL] => [.tList t]]]
		...TakeUntil...: [§GENERIC t [[.tList t, t => §BOOL] => [.tList t]]]
		...Skip...: [§GENERIC t [[.tList t, §INT] => [.tList t]]]
		...SkipWhile...: [§GENERIC t [[.tList t, t => §BOOL] => [.tList t]]]
		...SkipUntil...: [§GENERIC t [[.tList t, t => §BOOL] => [.tList t]]]
		...Every...: [§GENERIC t [[.tList t, §INT] => [.tList t]]]
		...CollapseRepeats...: [§GENERIC t [[.tList t, [t, t] => §BOOL] => [.tList t]]]
		...SortBy...: [§GENERIC t [[.tList t, [t, t] => §INT] => [.tList t]]]
		...Join...: [§GENERIC t [[.tList t, [[t, t] => t, t]] => t]]
		...Any: [[.tList §BOOL] => §BOOL]
		...All: [[.tList §BOOL] => §BOOL]
		...Any...: [§GENERIC t [[.tList t, t => §BOOL] => §BOOL]]
		...All...: [§GENERIC t [[.tList t, t => §BOOL] => §BOOL]]
		Concat...: [§GENERIC t [[.tList t, .tList t] => [.tList t]]]
		...Flatten: [§GENERIC t [[.tList [.tList t]] => [.tList t]]]
		ZipShort...: [
			§GENERIC tA [§GENERIC tB [[.tList tA, .tList tB] => [.tList [tA, tB]]]]
		]
		ZipLongest...: [
			§GENERIC tA [§GENERIC tB [[.tList tA, .tList tB] => [.tList [[tA | []], [tB | []]]]]]
		]
		...==...With...: [§GENERIC t [[.tList t, .tList t, [[t, t] => §BOOL]] => §BOOL]]
		==With...: [§GENERIC t [[[t, t] => §BOOL] => [[.tList t, .tList t] => §BOOL]]]
	>]
]