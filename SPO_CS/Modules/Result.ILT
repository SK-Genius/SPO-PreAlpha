	r_304 := [§ALL r_298 => r_303]
	r_305 := +#_OK... _OK...
	r_306 := {EMPTY} + r_305
	r_307 := +#_Fail... _Fail...
	r_308 := {r_306} + r_307
	r_309 := +#_...>>... _...>>...
	r_310 := {r_308} + r_309
	r_311 := +#_...>>?... _...>>?...
	r_312 := {r_310} + r_311
	r_313 := +#_...Or... _...Or...
	r_314 := {r_312} + r_313
	r_315 := +#_...OrDo... _...OrDo...
	r_316 := {r_314} + r_315
	r_317 := +#_...OrTry... _...OrTry...
	r_318 := {r_316} + r_317
	r_319 := +#_...MapError... _...MapError...
	r_320 := {r_318} + r_319
	r_321 := +#_...OrFail... _...OrFail...
	r_322 := {r_320} + r_321
	r_323 := r_304, r_322
	r_324 := §SIG r_297 WITH r_323
	§RETURN r_324 IF TRUE
