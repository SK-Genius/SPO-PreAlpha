<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<OutputType>Exe</OutputType>
		<!-- Exe | Library | Module | Winexe -->
		
		<DefineConstants>noMY_TRACE_PARSER;noMY_TRACE_IL;noMY_TRACE_VM;noMY_TRACE_PERF;noDISABLE_DEBUGGER_HIDDEN</DefineConstants>
		<InvariantGlobalization>true</InvariantGlobalization>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
		<AnalysisLevel>preview-all</AnalysisLevel>
		<NoWarn>659,661,8604,8618</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PublishAot>true</PublishAot>
	</PropertyGroup>
	
	<ItemGroup>
		<Compile Remove="GenCSProjs.cs" />
	</ItemGroup>
	
	<ItemGroup>
		<TestSrc Include="**\*.Tests.cs" />
		<Compile Update="@(TestSrc)">
			<DependentUpon>$([System.String]::new('%(Filename)').Replace('.Tests', '')).cs</DependentUpon>
		</Compile>
	</ItemGroup>
	
</Project>
