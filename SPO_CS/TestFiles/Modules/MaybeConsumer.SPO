§IMPORT {
	Maybe: §SIG [§LOAD "../../Modules/Maybe.SIG"] WITH §DEF F € [§TYPE => §TYPE] IN {
		Some...: §DEF Some...
		None...: §DEF None...
		...>>...: §DEF ...>>...
		...Or...: §DEF ...Or...
	}
}

§DEF X € [.F §INT] = .Some 1
§DEF Y € [.F §INT] = .None 0
§DEF ToTrue = §DEF _ € §INT => §TRUE
§DEF ToFalse = §DEF _ € §INT => §FALSE

§EXPORT (
	X §>.>> ToTrue §>.Or §TRUE
	Y §>.>> ToFalse §>.Or §FALSE
	X .Or 0
	Y .Or 0
)
