§IMPORT {
	mMaybe: §SIG [§LOAD "../../Modules/mMaybe.SIG"] WITH §DEF F € [§TYPE => §TYPE] IN {
		Some...: §DEF Some...
		None...: §DEF None...
		...>>...: §DEF ...>>...
		...>>?...: §DEF ...>>?...
		...Or...: §DEF ...Or...
		...OrDo...: §DEF ...OrDo...
		...OrTry...: §DEF ...OrTry...
	}
}

§DEF SomeInt € [.F §INT] = .Some 1
§DEF NoneInt € [.F §INT] = .None 0
§DEF ZeroValue € §INT = 0
§DEF ToTrue = §DEF _ € §INT => §TRUE
§DEF ToFalse = §DEF _ € §INT => §FALSE
§DEF Zero € [[] => §INT] = () => 0
§DEF Two € [[] => §INT] = () => 2

§EXPORT (
	SomeInt §>.>> ToTrue §>.Or §TRUE
	NoneInt §>.>> ToFalse §>.Or §FALSE
	SomeInt .Or ZeroValue
	NoneInt .Or ZeroValue
	SomeInt .OrDo Zero
	NoneInt .OrDo Two
)
