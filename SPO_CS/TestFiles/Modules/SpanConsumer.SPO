§IMPORT {
	Std: {
		...==...: §DEF ...==...
		...>...: §DEF ...>...
	} € [§LOAD "../../Modules/Std.SIG"]
	Span: §SIG [§LOAD "../../Modules/Span.SIG"] WITH §DEF F € [§TYPE => §TYPE] IN {
		...--...: §DEF ...--...
		SpanAt...: §DEF SpanAt...
		...Start: §DEF ...Start
		...End: §DEF ...End
		...&...With...: §DEF ...&...With...
		...==...With...: §DEF ...==...With...
		==With...: §DEF ==With...
	}
}

§DEF A € [.F §INT] = 1 .-- 3
§DEF SameA € [.F §INT] = 1 .-- 3
§DEF B € [.F §INT] = 3 .-- 7
§DEF Point € [.F §INT] = .SpanAt 4
§DEF Merged € [.F §INT] = A .& B With ...>...
§DEF ...Span==... € [[.F §INT, .F §INT] => §BOOL] = .==With ...==...

§EXPORT (
	(A .Start, A .End)
	(Point .Start, Point .End)
	(Merged .Start, Merged .End)
	A .== SameA With ...==...
	A .== B With ...==...
	A .Span== SameA
)