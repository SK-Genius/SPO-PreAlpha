§IMPORT {
	Result: §SIG [§LOAD "../../Modules/Result.SIG"] WITH §DEF F € [§TYPE => [§TYPE => §TYPE]] IN {
		OK...: §DEF OK...
		Fail...: §DEF Fail...
		...>>...: §DEF ...>>...
		...Or...: §DEF ...Or...
	}
}

§DEF Good € [.(.F §FALSE) §INT] = .OK (§FALSE, 1)
§DEF Bad € [.(.F §TRUE) §INT] = .Fail (§TRUE, 0)
§DEF ToTrue = §DEF _ € §INT => §TRUE
§DEF ToFalse = §DEF _ € §INT => §FALSE

§EXPORT (
	Good §>.>> ToTrue §>.Or §TRUE
	Bad §>.>> ToFalse §>.Or §FALSE
	Good .Or 0
	Bad .Or 0
)
