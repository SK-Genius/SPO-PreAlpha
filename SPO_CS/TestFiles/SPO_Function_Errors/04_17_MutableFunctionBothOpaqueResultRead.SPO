§DEF Fixture... = (
	§VAR aSelf € §INT
) : (
	§DEF aOpaque € [§VAR §INT]
) {
	§DEF Pass... = (
		§DEF aValue € [§VAR §INT]
	) => {
		Handle: aValue
		Captured: aOpaque
		Number: 7
	}
	
	{Handle: §DEF Result, Number: §DEF Number} = .Pass aOpaque
	
	§DEF Read = (
		§VAR aTarget € §INT
	) : (
	) => §TO_VAL aTarget
	
	§RETURN §TO_VAL Result
}

§EXPORT ()