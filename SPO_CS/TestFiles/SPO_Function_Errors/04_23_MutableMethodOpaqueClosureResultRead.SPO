§DEF Fixture... = (
	§VAR aSelf € §INT
) : (
	§DEF aOpaque € [§VAR §INT]
) {
	§DEF Pass... = (
		§VAR aObject € §INT
	) : (
		§DEF aValue € [§VAR §INT]
	) => {
		Handle: aValue
		Captured: aOpaque
		Number: 7
	}
	
	aSelf : Pass aSelf => §DEF Returned .
	
	{Handle: §DEF Result, Number: §DEF Number} = Returned
	
	§DEF Read = (
		§VAR aTarget € §INT
	) : (
	) => §TO_VAL aTarget
	
	§RETURN §TO_VAL Result
}

§EXPORT 1