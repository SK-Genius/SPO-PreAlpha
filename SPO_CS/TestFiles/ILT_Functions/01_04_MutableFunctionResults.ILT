§TYPES
	V := [§VAR INT]
	R := [V, INT]
	F := [V => R]
	C := [EMPTY_TYPE : F]
	D := [EMPTY_TYPE => C]
	ReadF := [EMPTY_TYPE => INT]
	Read := [V : ReadF]
	ReadD := [EMPTY_TYPE => Read]
	E := [C, Read]
	Main := [V : F]
	MainD := [E => Main]
	Defs1 := [EMPTY_TYPE, D]
	Defs2 := [Defs1, ReadD]
	Defs3 := [Defs2, MainD]
	Defs4 := [Defs3, MainD]
	Result1 := [EMPTY_TYPE, INT]
	Result2 := [Result1, INT]
	Result := [Result2, INT]
	EntryF := [EMPTY_TYPE => Result]
	Entry := [Defs4 => EntryF]
§DEF pass € D
	seven := 7
	result := ARG, seven
	§RETURN result IF TRUE
§DEF read € ReadD
	value := §VAR OBJ ->
	§RETURN value IF TRUE
§DEF argument_opaque € MainD
	pass := §1ST ENV
	returned := .pass ARG
	§RETURN returned IF TRUE
§DEF argument_allowed € MainD
	pass := §1ST ENV
	read := §2ND ENV
	returned := .pass OBJ
	handle := §1ST returned
	value := §VAR handle ->
	read_pair := handle, read
	forwarded := §OBJ:read_pair EMPTY
	§RETURN returned IF TRUE
§DEF main € Entry
	allowed_def := §2ND ENV
	defs3 := §1ST ENV
	opaque_def := §2ND defs3
	defs2 := §1ST defs3
	read_def := §2ND defs2
	defs1 := §1ST defs2
	pass_def := §2ND defs1
	seven := 7
	nine := 9
	cell := §VAR seven
	other := §VAR nine
	pass := §CLOSURE pass_def EMPTY
	read := §CLOSURE read_def EMPTY
	env := pass, read
	opaque := §CLOSURE opaque_def env
	allowed := §CLOSURE allowed_def env
	pair1 := cell, opaque
	returned1 := §OBJ:pair1 other
	number1 := §2ND returned1
	pair2 := cell, allowed
	returned2 := §OBJ:pair2 other
	number2 := §2ND returned2
	handle := §1ST returned2
	value := §VAR handle ->
	result1 := EMPTY, number1
	result2 := result1, number2
	result := result2, value
	§RETURN result IF TRUE
