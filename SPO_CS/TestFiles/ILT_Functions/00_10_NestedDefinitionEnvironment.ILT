§TYPES
	Bool := [TRUE | FALSE]
	IntInt := [INT, INT]
	IntInt->Int := [IntInt => INT]
	_IntInt->Int := [EMPTY_TYPE => IntInt->Int]
	IntInt->Bool := [IntInt => Bool]
	_IntInt->Bool := [EMPTY_TYPE => IntInt->Bool]
	Env1 := [EMPTY_TYPE, _IntInt->Int]
	Env2 := [Env1, _IntInt->Int]
	Env3 := [Env2, _IntInt->Int]
	Env4 := [Env3, _IntInt->Bool]
	->Int := [EMPTY_TYPE => INT]
	tBla := [Env4 => ->Int]
	Result1 := [EMPTY_TYPE, INT]
	Result2 := [Result1, INT]
	EntryFunc := [EMPTY_TYPE => Result2]
	Defs1 := [EMPTY_TYPE, tBla]
	Defs2 := [Defs1, tBla]
	Defs3 := [Defs2, _IntInt->Int]
	Defs4 := [Defs3, _IntInt->Int]
	Defs5 := [Defs4, _IntInt->Int]
	Defs6 := [Defs5, _IntInt->Bool]
	Entry := [Defs6 => EntryFunc]
§DEF bla € tBla
	_1 := 1
	env4 := §1ST ENV
	env3 := §1ST env4
	env2 := §1ST env3
	add_ := §2ND env2
	add := .add_ EMPTY
	p := _1, _1
	r := .add p
	§RETURN r IF TRUE
§DEF bla2 € tBla
	_1 := 1
	eq_    := §2ND ENV
	env4   := §1ST ENV
	mul_   := §2ND env4
	env3   := §1ST env4
	sub_   := §2ND env3
	env2   := §1ST env3
	add_   := §2ND env2
	env1   := §1ST env2
	add := .add_ EMPTY
	sub := .sub_ EMPTY
	mul := .mul_ EMPTY
	_1_1 := _1, _1
	_2   := .add _1_1
	_2_1 := _2, _1
	_3   := .add _2_1
	_2_2 := _2, _2
	_4   := .add _2_2
	_3_4 := _3, _4
	_12  := .mul _3_4
	§RETURN _12 IF TRUE
§DEF add € _IntInt->Int
	a := §1ST ARG
	b := §2ND ARG
	r := §INT a + b
	§RETURN r IF TRUE

§DEF sub € _IntInt->Int
	a := §1ST ARG
	b := §2ND ARG
	r := §INT a - b
	§RETURN r IF TRUE

§DEF mul € _IntInt->Int
	a := §1ST ARG
	b := §2ND ARG
	r := §INT a * b
	§RETURN r IF TRUE

§DEF eq € _IntInt->Bool
	a := §1ST ARG
	b := §2ND ARG
	r := §INT a == b
	§RETURN r IF TRUE

§DEF entry € Entry
	eq := §2ND ENV
	env5 := §1ST ENV
	mul := §2ND env5
	env4 := §1ST env5
	sub := §2ND env4
	env3 := §1ST env4
	add := §2ND env3
	env2 := §1ST env3
	bla2 := §2ND env2
	env1 := §1ST env2
	bla := §2ND env1
	args1 := EMPTY, add
	args2 := args1, sub
	args3 := args2, mul
	args4 := args3, eq
	f1 := .bla args4
	f2 := .bla2 args4
	r1 := .f1 EMPTY
	r2 := .f2 EMPTY
	result1 := EMPTY, r1
	result2 := result1, r2
	§RETURN result2 IF TRUE
