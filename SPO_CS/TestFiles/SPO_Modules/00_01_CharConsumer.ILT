§TYPES
	t_0 := [#_Char... INT]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [t_1, t_0]
	t_3 := [TRUE | FALSE]
	t_4 := [t_2 => t_3]
	t_5 := [t_0 => t_0]
	t_6 := [#_...==... t_4]
	t_7 := [{EMPTY_TYPE} + t_6]
	t_8 := [#_...ToLower t_5]
	t_9 := [{t_7} + t_8]
	t_10 := [#_...ToUpper t_5]
	t_11 := [{t_9} + t_10]
	t_12 := [#_Char t_11]
	t_13 := [{EMPTY_TYPE} + t_12]
	t_14 := [EMPTY_TYPE, t_3]
	t_15 := [t_14, t_3]
	t_16 := [t_13 => t_15]
	t_17 := [EMPTY_TYPE => t_16]

§DEF d_0 € t_17
	r_1 := {ARG} #_Char
	r_2 := {r_1} #_...==...
	r_3 := §WITH_TYPE t_4 WITH r_2
	_...==... := r_3
	r_4 := {r_1} #_...ToUpper
	r_5 := §WITH_TYPE t_5 WITH r_4
	_...ToUpper := r_5
	r_6 := {r_1} #_...ToLower
	r_7 := §WITH_TYPE t_5 WITH r_6
	_...ToLower := r_7
	r_8 := 97
	r_9 := +#_Char... r_8
	r_10 := ._...ToUpper r_9
	r_11 := EMPTY, r_10
	r_12 := 65
	r_13 := +#_Char... r_12
	r_14 := r_11, r_13
	r_15 := ._...==... r_14
	r_16 := EMPTY, r_15
	r_17 := 65
	r_18 := +#_Char... r_17
	r_19 := ._...ToLower r_18
	r_20 := EMPTY, r_19
	r_21 := 97
	r_22 := +#_Char... r_21
	r_23 := r_20, r_22
	r_24 := ._...==... r_23
	r_25 := r_16, r_24
	§RETURN r_25 IF TRUE
