§TYPES
	t_0 := [#_Char... INT]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [t_1, t_0]
	t_3 := [TRUE | FALSE]
	t_4 := [t_2 => t_3]
	t_5 := [#_...==... t_4]
	t_6 := [{EMPTY_TYPE} + t_5]
	t_7 := [t_0 => t_0]
	t_8 := [#_...ToLower t_7]
	t_9 := [{t_6} + t_8]
	t_10 := [#_...ToUpper t_7]
	t_11 := [{t_9} + t_10]
	t_12 := [#_Char t_11]
	t_13 := [{EMPTY_TYPE} + t_12]
	t_14 := [EMPTY_TYPE, t_3]
	t_15 := [t_14, t_3]
	t_16 := [t_13 => t_15]
	t_17 := [EMPTY_TYPE => t_16]

§DEF d_0 € t_17
	r_1 := {ARG} #_Char
	r_2 := {r_1} #_...==...
	_...==... := r_2
	r_3 := {r_1} #_...ToUpper
	_...ToUpper := r_3
	r_4 := {r_1} #_...ToLower
	_...ToLower := r_4
	r_5 := 97
	r_6 := +#_Char... r_5
	r_7 := ._...ToUpper r_6
	r_8 := EMPTY, r_7
	r_9 := 65
	r_10 := +#_Char... r_9
	r_11 := r_8, r_10
	r_12 := ._...==... r_11
	r_13 := EMPTY, r_12
	r_14 := 65
	r_15 := +#_Char... r_14
	r_16 := ._...ToLower r_15
	r_17 := EMPTY, r_16
	r_18 := 97
	r_19 := +#_Char... r_18
	r_20 := r_17, r_19
	r_21 := ._...==... r_20
	r_22 := r_13, r_21
	§RETURN r_22 IF TRUE
