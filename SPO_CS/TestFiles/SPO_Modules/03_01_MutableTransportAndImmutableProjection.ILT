§TYPES
	t_0 := [§VAR INT]
	t_1 := [#_Cell t_0]
	t_2 := [{EMPTY_TYPE} + t_1]
	t_3 := [#_Fixed INT]
	t_4 := [{t_2} + t_3]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [t_0 => t_0]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [#_TestCellFactory t_5]
	t_9 := [{EMPTY_TYPE} + t_8]
	t_10 := [#_Fresh INT]
	t_11 := [{EMPTY_TYPE} + t_10]
	t_12 := [#_Left INT]
	t_13 := [{t_11} + t_12]
	t_14 := [#_Right INT]
	t_15 := [{t_13} + t_14]
	t_16 := [t_9 => t_15]
	t_17 := [t_7 => t_16]

§DEF d_0 € t_7
	_aValue := ARG
	§RETURN _aValue IF TRUE

§DEF d_1 € t_17
	d_0 := ENV
	r_1 := {ARG} #_TestCellFactory
	r_2 := §WITH_TYPE t_5 WITH r_1
	_Create... := r_2
	r_3 := ._Create... EMPTY
	r_4 := {r_3} #_Cell
	_Left := r_4
	r_5 := {r_3} #_Fixed
	_cLeftFixed := r_5
	r_6 := ._Create... EMPTY
	r_7 := {r_6} #_Cell
	_Right := r_7
	r_8 := {r_6} #_Fixed
	_cRightFixed := r_8
	r_9 := §CLOSURE d_0 EMPTY
	_Identity... := r_9
	r_10 := ._Identity... _Left
	_LeftTransported := r_10
	r_11 := ._Identity... _Right
	_RightTransported := r_11
	r_12 := 1
	§VAR _LeftTransported <- r_12
	r_13 := +#_Left _cLeftFixed
	r_14 := {EMPTY} + r_13
	r_15 := +#_Right _cRightFixed
	r_16 := {r_14} + r_15
	r_17 := §VAR _RightTransported ->
	r_18 := +#_Fresh r_17
	r_19 := {r_16} + r_18
	§RETURN r_19 IF TRUE
