§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [#_...*... t_2]
	t_4 := [{EMPTY_TYPE} + t_3]
	t_5 := [#_...+... t_2]
	t_6 := [{t_4} + t_5]
	t_7 := [#_...-... t_2]
	t_8 := [{t_6} + t_7]
	t_9 := [#_.../... t_2]
	t_10 := [{t_8} + t_9]
	t_11 := [#_Std t_10]
	t_12 := [{EMPTY_TYPE} + t_11]
	t_13 := [t_1, INT]
	t_14 := [t_13, INT]
	t_15 := [t_12 => t_14]
	t_16 := [EMPTY_TYPE => t_15]

§DEF d_0 € t_16
	r_1 := {ARG} #_Std
	r_2 := {r_1} #_...+...
	r_3 := §WITH_TYPE t_2 WITH r_2
	_...+... := r_3
	r_4 := {r_1} #_...-...
	r_5 := §WITH_TYPE t_2 WITH r_4
	_...-... := r_5
	r_6 := {r_1} #_...*...
	r_7 := §WITH_TYPE t_2 WITH r_6
	_...*... := r_7
	r_8 := {r_1} #_.../...
	r_9 := §WITH_TYPE t_2 WITH r_8
	_.../... := r_9
	r_10 := 2
	r_11 := EMPTY, r_10
	r_12 := 5
	r_13 := r_11, r_12
	r_14 := ._...+... r_13
	r_15 := EMPTY, r_14
	r_16 := 7
	r_17 := EMPTY, r_16
	r_18 := 3
	r_19 := r_17, r_18
	r_20 := ._...-... r_19
	r_21 := r_15, r_20
	r_22 := 3
	r_23 := EMPTY, r_22
	r_24 := 4
	r_25 := r_23, r_24
	r_26 := ._...*... r_25
	r_27 := r_21, r_26
	r_28 := 8
	r_29 := EMPTY, r_28
	r_30 := 3
	r_31 := r_29, r_30
	r_32 := ._.../... r_31
	r_33 := r_27, r_32
	§RETURN r_33 IF TRUE
