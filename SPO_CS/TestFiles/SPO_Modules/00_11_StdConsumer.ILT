§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [#_...*... t_2]
	t_4 := [{EMPTY_TYPE} + t_3]
	t_5 := [#_...+... t_2]
	t_6 := [{t_4} + t_5]
	t_7 := [#_...-... t_2]
	t_8 := [{t_6} + t_7]
	t_9 := [#_.../... t_2]
	t_10 := [{t_8} + t_9]
	t_11 := [#_Std t_10]
	t_12 := [{EMPTY_TYPE} + t_11]
	t_13 := [t_1, INT]
	t_14 := [t_13, INT]
	t_15 := [t_12 => t_14]
	t_16 := [EMPTY_TYPE => t_15]

§DEF d_0 € t_16
	r_1 := {ARG} #_Std
	r_2 := {r_1} #_...+...
	_...+... := r_2
	r_3 := {r_1} #_...-...
	_...-... := r_3
	r_4 := {r_1} #_...*...
	_...*... := r_4
	r_5 := {r_1} #_.../...
	_.../... := r_5
	r_6 := 2
	r_7 := EMPTY, r_6
	r_8 := 5
	r_9 := r_7, r_8
	r_10 := ._...+... r_9
	r_11 := EMPTY, r_10
	r_12 := 7
	r_13 := EMPTY, r_12
	r_14 := 3
	r_15 := r_13, r_14
	r_16 := ._...-... r_15
	r_17 := r_11, r_16
	r_18 := 3
	r_19 := EMPTY, r_18
	r_20 := 4
	r_21 := r_19, r_20
	r_22 := ._...*... r_21
	r_23 := r_17, r_22
	r_24 := 8
	r_25 := EMPTY, r_24
	r_26 := 3
	r_27 := r_25, r_26
	r_28 := ._.../... r_27
	r_29 := r_23, r_28
	§RETURN r_29 IF TRUE
