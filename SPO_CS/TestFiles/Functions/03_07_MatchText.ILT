§TYPES
	t_0 := [#_Char... INT]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [#Result INT]
	t_3 := [EMPTY_TYPE | t_2]
	t_4 := [t_1 => t_3]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [t_1 => INT]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE, t_7]
	t_9 := [t_8, t_7]
	t_10 := [t_1 => t_2]
	t_11 := [t_9 => t_10]
	t_12 := [t_9, t_11]
	t_13 := [EMPTY_TYPE => INT]
	t_14 := [t_12 => t_13]

§DEF d_0 € t_5
	r_1 := §TRY ARG AS_PAIR
	r_2 := §1ST r_1
	r_3 := §2ND r_1
	r_4 := §TRY r_2 AS_EMPTY
	r_5 := §TRY_REMOVE #_Char... FROM r_3
	r_6 := §TRY r_5 AS_INT
	r_7 := 65
	r_8 := §INT r_6 == r_7
	r_9 := §BOOL r_8 ^ TRUE
	§RETURN EMPTY IF r_9
	r_10 := 1
	r_11 := +#Result r_10
	§RETURN r_11 IF TRUE

§DEF d_1 € t_5
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_2 € t_11
	d_1 := §2ND ENV
	r_5 := §1ST ENV
	d_0 := §2ND r_5
	r_6 := §1ST r_5
	r_1 := .d_0 EMPTY
	r_2 := .r_1 ARG
	§RETURN r_2 IF_NOT_EMPTY
	r_3 := .d_1 EMPTY
	r_4 := .r_3 ARG
	§RETURN r_4 IF_NOT_EMPTY
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_14
	d_2 := §2ND ENV
	r_9 := §1ST ENV
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	r_1 := 65
	r_2 := +#_Char... r_1
	r_3 := EMPTY, r_2
	r_4 := EMPTY, d_0
	r_5 := r_4, d_1
	r_6 := .d_2 r_5
	r_7 := .r_6 r_3
	r_8 := -#Result r_7
	§RETURN r_8 IF TRUE
