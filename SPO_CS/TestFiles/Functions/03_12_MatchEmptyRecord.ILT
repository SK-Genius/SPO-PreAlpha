§TYPES
	t_0 := [#_Field INT]
	t_1 := [{EMPTY_TYPE} + t_0]
	t_2 := [#Result INT]
	t_3 := [t_1 => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [#_Field INT]
	t_6 := [{EMPTY_TYPE} + t_5]
	t_7 := [t_4 => t_3]
	t_8 := [#_Field INT]
	t_9 := [{EMPTY_TYPE} + t_8]
	t_10 := [EMPTY_TYPE, t_4]
	t_11 := [#_Field INT]
	t_12 := [{EMPTY_TYPE} + t_11]
	t_13 := [t_10, t_7]
	t_14 := [EMPTY_TYPE => INT]
	t_15 := [t_13 => t_14]

§DEF d_0 € t_4
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_7
	d_0 := ENV
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_15
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_1 := 1
	r_2 := +#_Field r_1
	r_3 := {EMPTY} + r_2
	_Value := r_3
	r_4 := .d_1 d_0
	r_5 := .r_4 _Value
	r_6 := -#Result r_5
	§RETURN r_6 IF TRUE
