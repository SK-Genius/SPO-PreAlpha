§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [#Result INT]
	t_3 := [t_1 => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [TRUE | FALSE]
	t_6 := [t_1 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE, t_4]
	t_9 := [t_8, t_7]
	t_10 := [t_9, t_4]
	t_11 := [t_10 => t_3]
	t_12 := [t_10, t_11]
	t_13 := [EMPTY_TYPE => INT]
	t_14 := [t_12 => t_13]

§DEF d_0 € t_4
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	_Second := r_2
	r_5 := +#Result _Second
	§RETURN r_5 IF TRUE

§DEF d_1 € t_7
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := 0
	r_6 := §INT r_4 == r_5
	r_7 := §BOOL r_6 ^ TRUE
	§RETURN FALSE IF r_7
	_Second := r_2
	§RETURN TRUE IF TRUE

§DEF d_2 € t_4
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	_First := r_4
	r_5 := +#Result _First
	§RETURN r_5 IF TRUE

§DEF d_3 € t_11
	d_2 := §2ND ENV
	r_4 := §1ST ENV
	d_1 := §2ND r_4
	r_5 := §1ST r_4
	d_0 := §2ND r_5
	r_6 := §1ST r_5
	r_1 := .d_0 EMPTY
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_1 ARG IF r_2
	r_3 := .d_2 EMPTY
	§TRY_RETURN .r_3 ARG
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_14
	d_3 := §2ND ENV
	r_11 := §1ST ENV
	d_2 := §2ND r_11
	r_12 := §1ST r_11
	d_1 := §2ND r_12
	r_13 := §1ST r_12
	d_0 := §2ND r_13
	r_14 := §1ST r_13
	r_1 := 0
	r_2 := EMPTY, r_1
	r_3 := 5
	r_4 := r_2, r_3
	r_5 := EMPTY, d_0
	r_6 := r_5, d_1
	r_7 := r_6, d_2
	r_8 := .d_3 r_7
	r_9 := .r_8 r_4
	r_10 := -#Result r_9
	§RETURN r_10 IF TRUE
