§TYPES
	t_0 := [#Result INT]
	t_1 := [EMPTY_TYPE | t_0]
	t_2 := [INT => t_1]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [INT => INT]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [EMPTY_TYPE, t_5]
	t_7 := [t_6, t_5]
	t_8 := [INT => t_0]
	t_9 := [t_7 => t_8]
	t_10 := [t_7, t_9]
	t_11 := [EMPTY_TYPE => INT]
	t_12 := [t_10 => t_11]

§DEF d_0 € t_3
	r_1 := §TRY ARG AS_INT
	r_2 := 1
	r_3 := §INT r_1 == r_2
	r_4 := §BOOL r_3 ^ TRUE
	§RETURN EMPTY IF r_4
	r_5 := 0
	r_6 := +#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_1 € t_3
	_Z := ARG
	r_1 := +#Result _Z
	§RETURN r_1 IF TRUE

§DEF d_2 € t_9
	d_1 := §2ND ENV
	r_5 := §1ST ENV
	d_0 := §2ND r_5
	r_6 := §1ST r_5
	r_1 := .d_0 EMPTY
	r_2 := .r_1 ARG
	§RETURN r_2 IF_NOT_EMPTY
	r_3 := .d_1 EMPTY
	r_4 := .r_3 ARG
	§RETURN r_4 IF_NOT_EMPTY
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_12
	d_2 := §2ND ENV
	r_7 := §1ST ENV
	d_1 := §2ND r_7
	r_8 := §1ST r_7
	d_0 := §2ND r_8
	r_9 := §1ST r_8
	r_1 := 1
	_X := r_1
	r_2 := EMPTY, d_0
	r_3 := r_2, d_1
	r_4 := .d_2 r_3
	r_5 := .r_4 _X
	r_6 := -#Result r_5
	_Y := r_6
	§RETURN _Y IF TRUE
