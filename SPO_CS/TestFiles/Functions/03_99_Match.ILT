§TYPES
	t_0 := [#Result INT]
	t_1 := [INT => t_0]
	t_2 := [EMPTY_TYPE => t_1]
	t_3 := [TRUE | FALSE]
	t_4 := [INT => t_3]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [EMPTY_TYPE, t_2]
	t_7 := [t_6, t_5]
	t_8 := [t_7, t_2]
	t_9 := [t_8 => t_1]
	t_10 := [t_8, t_9]
	t_11 := [EMPTY_TYPE => INT]
	t_12 := [t_10 => t_11]

§DEF d_0 € t_2
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_5
	r_1 := 1
	r_2 := §INT ARG == r_1
	r_3 := §BOOL r_2 ^ TRUE
	§RETURN FALSE IF r_3
	§RETURN TRUE IF TRUE

§DEF d_2 € t_2
	_Z := ARG
	r_1 := +#Result _Z
	§RETURN r_1 IF TRUE

§DEF d_3 € t_9
	d_2 := §2ND ENV
	r_4 := §1ST ENV
	d_1 := §2ND r_4
	r_5 := §1ST r_4
	d_0 := §2ND r_5
	r_6 := §1ST r_5
	r_1 := .d_0 EMPTY
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_1 ARG IF r_2
	r_3 := .d_2 EMPTY
	§TRY_RETURN .r_3 ARG
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_12
	d_3 := §2ND ENV
	r_8 := §1ST ENV
	d_2 := §2ND r_8
	r_9 := §1ST r_8
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	r_1 := 1
	_X := r_1
	r_2 := EMPTY, d_0
	r_3 := r_2, d_1
	r_4 := r_3, d_2
	r_5 := .d_3 r_4
	r_6 := .r_5 _X
	r_7 := -#Result r_6
	_Y := r_7
	§RETURN _Y IF TRUE
