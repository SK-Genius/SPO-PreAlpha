§TYPES
	t_0 := [#_First EMPTY_TYPE]
	t_1 := [{EMPTY_TYPE} + t_0]
	t_2 := [#_Second INT]
	t_3 := [{t_1} + t_2]
	t_4 := [TRUE | FALSE]
	t_5 := [#Result t_4]
	t_6 := [t_3 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [#_First EMPTY_TYPE]
	t_9 := [{EMPTY_TYPE} + t_8]
	t_10 := [#_Second INT]
	t_11 := [{t_9} + t_10]
	t_12 := [t_7 => t_6]
	t_13 := [#_First EMPTY_TYPE]
	t_14 := [{EMPTY_TYPE} + t_13]
	t_15 := [#_Second INT]
	t_16 := [{t_14} + t_15]
	t_17 := [EMPTY_TYPE, t_7]
	t_18 := [#_First EMPTY_TYPE]
	t_19 := [{EMPTY_TYPE} + t_18]
	t_20 := [#_Second INT]
	t_21 := [{t_19} + t_20]
	t_22 := [t_17, t_12]
	t_23 := [INT | EMPTY_TYPE]
	t_24 := [EMPTY_TYPE => t_23]
	t_25 := [t_22 => t_24]
	t_26 := [#_First EMPTY_TYPE]
	t_27 := [{EMPTY_TYPE} + t_26]
	t_28 := [#_Second INT]
	t_29 := [{t_27} + t_28]
	t_30 := [#_First EMPTY_TYPE]
	t_31 := [{EMPTY_TYPE} + t_30]
	t_32 := [#_Second INT]
	t_33 := [{t_31} + t_32]
	t_34 := [t_22, t_25]
	t_35 := [EMPTY_TYPE => INT]
	t_36 := [t_34 => t_35]

§DEF d_0 € t_7
	r_1 := {ARG} #_First
	r_2 := {ARG} #_Second
	r_3 := +#Result TRUE
	§RETURN r_3 IF TRUE

§DEF d_1 € t_12
	d_0 := ENV
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_25
	d_1 := §2ND ENV
	r_11 := §1ST ENV
	d_0 := §2ND r_11
	r_12 := §1ST r_11
	§RETURN ARG IF_NOT_EMPTY
	r_1 := +#_First EMPTY
	r_2 := {EMPTY} + r_1
	r_3 := 7
	r_4 := +#_Second r_3
	r_5 := {r_2} + r_4
	r_6 := .d_1 d_0
	r_7 := .r_6 r_5
	r_8 := -#Result r_7
	r_9 := 1
	§RETURN r_9 IF r_8
	r_10 := 0
	§RETURN r_10 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_36
	d_2 := §2ND ENV
	r_6 := §1ST ENV
	d_1 := §2ND r_6
	r_7 := §1ST r_6
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_2 := EMPTY, d_0
	r_3 := r_2, d_1
	r_4 := .d_2 r_3
	r_5 := .r_4 EMPTY
	r_1 := r_5
	§RETURN r_1 IF TRUE
