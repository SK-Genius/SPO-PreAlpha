§DEF d_0 € t_6
	r_1 := §2ND ARG
	_aOnFalse := r_1
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	_aOnTrue := r_3
	r_4 := §1ST r_2
	r_5 := §2ND r_4
	_aCond := r_5
	r_6 := §1ST r_4
	§RETURN r_6 IF_NOT_EMPTY
	r_7 := ._aOnTrue EMPTY
	§RETURN r_7 IF _aCond
	r_8 := ._aOnFalse EMPTY
	§RETURN r_8 IF TRUE

§DEF d_1 € t_7
	_a := ENV
	§RETURN ARG IF_NOT_EMPTY
	§RETURN _a IF TRUE

§DEF d_2 € t_16
	_a := §2ND ENV
	r_14 := §1ST ENV
	_...-... := §2ND r_14
	r_15 := §1ST r_14
	_Fib... := §2ND r_15
	r_16 := §1ST r_15
	_...+... := §2ND r_16
	r_17 := §1ST r_16
	§RETURN ARG IF_NOT_EMPTY
	r_1 := EMPTY, _a
	r_2 := 2
	r_3 := r_1, r_2
	r_4 := ._...-... r_3
	r_5 := ._Fib... r_4
	r_6 := EMPTY, r_5
	r_7 := EMPTY, _a
	r_8 := 1
	r_9 := r_7, r_8
	r_10 := ._...-... r_9
	r_11 := ._Fib... r_10
	r_12 := r_6, r_11
	r_13 := ._...+... r_12
	§RETURN r_13 IF TRUE

§DEF d_3 € t_25
	d_2 := §2ND ENV
