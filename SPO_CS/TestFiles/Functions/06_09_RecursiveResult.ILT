§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [#Result t_1]
	t_3 := [TRUE => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [TRUE | FALSE]
	t_6 := [t_5 => t_1]
	t_7 := [FALSE => t_2]
	t_8 := [t_6 => t_7]
	t_9 := [EMPTY_TYPE, t_4]
	t_10 := [t_9, t_6]
	t_11 := [t_10, t_8]
	t_12 := [t_5 => t_2]
	t_13 := [t_11 => t_12]
	t_14 := [t_11, t_13]
	t_15 := [t_14 => t_6]
	t_16 := [t_9, t_8]
	t_17 := [t_16, t_13]
	t_18 := [t_17, t_15]
	t_19 := [t_6 => t_6]
	t_20 := [t_18 => t_19]
	t_21 := [t_18, t_20]
	t_22 := [EMPTY_TYPE => INT]
	t_23 := [t_21 => t_22]

§DEF d_0 € t_4
	r_1 := 1
	r_2 := EMPTY, r_1
	r_3 := 2
	r_4 := r_2, r_3
	r_5 := +#Result r_4
	§RETURN r_5 IF TRUE

§DEF d_1 € t_8
	_Position... := ENV
	r_1 := ._Position... TRUE
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_2 € t_13
	d_1 := §2ND ENV
	r_3 := §1ST ENV
	_Position... := §2ND r_3
	r_4 := §1ST r_3
	d_0 := §2ND r_4
	r_5 := §1ST r_4
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	r_2 := .d_1 _Position...
	§TRY_RETURN .r_2 ARG
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_15
	d_2 := §2ND ENV
	r_7 := §1ST ENV
	d_1 := §2ND r_7
	r_8 := §1ST r_7
	_Position... := §2ND r_8
	r_9 := §1ST r_8
	d_0 := §2ND r_9
	r_10 := §1ST r_9
	_aAtEnd := ARG
	r_1 := EMPTY, d_0
	r_2 := r_1, _Position...
	r_3 := r_2, d_1
	r_4 := .d_2 r_3
	r_5 := .r_4 _aAtEnd
	r_6 := -#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_4 € t_20
	d_3 := §2ND ENV
	r_6 := §1ST ENV
	d_2 := §2ND r_6
	r_7 := §1ST r_6
	d_1 := §2ND r_7
	r_8 := §1ST r_7
	d_0 := §2ND r_8
	r_9 := §1ST r_8
	_Position... := ARG
	r_1 := EMPTY, d_0
	r_2 := r_1, _Position...
	r_3 := r_2, d_1
	r_4 := r_3, d_2
	r_5 := .d_3 r_4
	§RETURN r_5 IF TRUE

§DEF d_5 € t_23
	d_4 := §2ND ENV
	r_11 := §1ST ENV
	d_3 := §2ND r_11
	r_12 := §1ST r_11
	d_2 := §2ND r_12
	r_13 := §1ST r_12
	d_1 := §2ND r_13
	r_14 := §1ST r_13
	d_0 := §2ND r_14
	r_15 := §1ST r_14
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := r_3, d_3
	§REC r_5 := .d_4 r_4
	_Position... := r_5
	r_6 := ._Position... FALSE
	r_7 := §2ND r_6
	_Y := r_7
	r_8 := §1ST r_6
	r_9 := §2ND r_8
	_X := r_9
	r_10 := §1ST r_8
	§RETURN _X IF TRUE
