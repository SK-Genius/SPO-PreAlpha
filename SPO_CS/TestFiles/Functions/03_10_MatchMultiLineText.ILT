§TYPES
	t_0 := [#_Char... INT]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [#Result INT]
	t_3 := [t_1 => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [FALSE | TRUE]
	t_6 := [t_1 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE, t_4]
	t_9 := [t_8, t_7]
	t_10 := [t_9, t_4]
	t_11 := [t_10 => t_3]
	t_12 := [t_10, t_11]
	t_13 := [EMPTY_TYPE => INT]
	t_14 := [t_12 => t_13]

§DEF d_0 € t_4
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := -#_Char... r_2
	r_4 := 1
	r_5 := +#Result r_4
	§RETURN r_5 IF TRUE

§DEF d_1 € t_7
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := -#_Char... r_2
	r_4 := 65
	r_5 := §INT r_3 == r_4
	r_6 := §BOOL r_5 ^ TRUE
	§RETURN FALSE IF r_6
	§RETURN TRUE IF TRUE

§DEF d_2 € t_4
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_3 € t_11
	d_2 := §2ND ENV
	r_4 := §1ST ENV
	d_1 := §2ND r_4
	r_5 := §1ST r_4
	d_0 := §2ND r_5
	r_6 := §1ST r_5
	r_1 := .d_0 EMPTY
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_1 ARG IF r_2
	r_3 := .d_2 EMPTY
	§TRY_RETURN .r_3 ARG
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_14
	d_3 := §2ND ENV
	r_10 := §1ST ENV
	d_2 := §2ND r_10
	r_11 := §1ST r_10
	d_1 := §2ND r_11
	r_12 := §1ST r_11
	d_0 := §2ND r_12
	r_13 := §1ST r_12
	r_1 := 65
	r_2 := +#_Char... r_1
	r_3 := EMPTY, r_2
	r_4 := EMPTY, d_0
	r_5 := r_4, d_1
	r_6 := r_5, d_2
	r_7 := .d_3 r_6
	r_8 := .r_7 r_3
	r_9 := -#Result r_8
	§RETURN r_9 IF TRUE
