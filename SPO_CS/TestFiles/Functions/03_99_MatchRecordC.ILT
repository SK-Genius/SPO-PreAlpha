§DEF d_0 € t_6
	r_1 := {ARG} #_First
	r_2 := {ARG} #_Second
	_Value := r_2
	r_3 := +#Result _Value
	§RETURN r_3 IF TRUE

§DEF d_1 € t_9
	r_1 := {ARG} #_First
	r_2 := 0
	r_3 := §INT r_1 == r_2
	r_4 := §BOOL r_3 ^ TRUE
	§RETURN FALSE IF r_4
	r_5 := {ARG} #_Second
	_Value := r_5
	§RETURN TRUE IF TRUE

§DEF d_2 € t_6
	r_1 := {ARG} #_First
	_Value := r_1
	r_2 := {ARG} #_Second
	r_3 := +#Result _Value
	§RETURN r_3 IF TRUE

§DEF d_3 € t_29
	d_2 := §2ND ENV
	r_4 := §1ST ENV
	d_1 := §2ND r_4
	r_5 := §1ST r_4
	d_0 := §2ND r_5
	r_6 := §1ST r_5
	r_1 := .d_0 EMPTY
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_1 ARG IF r_2
	r_3 := .d_2 EMPTY
	§TRY_RETURN .r_3 ARG
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_44
	d_3 := §2ND ENV
	r_13 := §1ST ENV
	d_2 := §2ND r_13
	r_14 := §1ST r_13
	d_1 := §2ND r_14
	r_15 := §1ST r_14
	d_0 := §2ND r_15
	r_16 := §1ST r_15
	r_1 := 0
	r_2 := +#_First r_1
	r_3 := {EMPTY} + r_2
	r_4 := 5
	r_5 := +#_Second r_4
	r_6 := {r_3} + r_5
	r_7 := EMPTY, d_0
	r_8 := r_7, d_1
	r_9 := r_8, d_2
	r_10 := .d_3 r_9
	r_11 := .r_10 r_6
	r_12 := -#Result r_11
	§RETURN r_12 IF TRUE
