§TYPES
	t_0 := [#_First INT]
	t_1 := [{EMPTY_TYPE} + t_0]
	t_2 := [#_Second INT]
	t_3 := [{t_1} + t_2]
	t_4 := [#Result INT]
	t_5 := [t_3 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [TRUE | FALSE]
	t_8 := [t_3 => t_7]
	t_9 := [EMPTY_TYPE => t_8]
	t_10 := [#_First INT]
	t_11 := [{EMPTY_TYPE} + t_10]
