§TYPES
	t_0 := [§SIG_HEAD TYPE]
	t_1 := [§SIG_WITH t_0 IN t_0]
	t_2 := [#Result INT]
	t_3 := [t_1 => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [§SIG_HEAD TYPE]
	t_6 := [EMPTY_TYPE, t_5]
	t_7 := [t_6, t_5]
	t_8 := [§SIG_WITH t_5 IN t_7]
	t_9 := [t_8 | INT]
	t_10 := [t_9 => t_2]
	t_11 := [EMPTY_TYPE => t_10]
	t_12 := [EMPTY_TYPE, t_4]
	t_13 := [t_12, t_11]
	t_14 := [t_9 | t_1]
	t_15 := [t_14 => t_2]
	t_16 := [t_13 => t_15]
	t_17 := [t_13, t_16]
	t_18 := [EMPTY_TYPE => INT]
	t_19 := [t_17 => t_18]

§DEF d_0 € t_4
	r_1 := [§SIG_HEAD Type_TYPE]
	r_2 := [§SIG_WITH r_1 IN r_1]
	r_3 := §TRY ARG AS_SIG r_2
	r_4 := §SIG_HEAD r_3
	r_5 := §SIG_BODY r_3
	_Body := r_5
	r_6 := 1
	r_7 := +#Result r_6
	§RETURN r_7 IF TRUE

§DEF d_1 € t_11
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_2 € t_16
	d_1 := §2ND ENV
	r_3 := §1ST ENV
	d_0 := §2ND r_3
	r_4 := §1ST r_3
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_2 ARG
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_19
	d_2 := §2ND ENV
	r_13 := §1ST ENV
	d_1 := §2ND r_13
	r_14 := §1ST r_13
	d_0 := §2ND r_14
	r_15 := §1ST r_14
	r_1 := [§SIG_HEAD Type_TYPE]
	r_2 := [§SIG_WITH r_1 IN r_1]
	_Contract := r_2
	r_3 := [§SIG_HEAD Type_TYPE]
	r_4 := [§SIG_WITH r_3 IN r_3]
	r_5 := 7
	r_6 := INT_TYPE, r_5
	r_7 := §SIG r_4 WITH r_6
	_Value := r_7
	r_8 := EMPTY, d_0
	r_9 := r_8, d_1
	r_10 := .d_2 r_9
	r_11 := .r_10 _Value
	r_12 := -#Result r_11
	§RETURN r_12 IF TRUE
