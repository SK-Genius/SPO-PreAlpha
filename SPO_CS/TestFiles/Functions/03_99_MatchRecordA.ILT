§TYPES
	t_0 := [#_First EMPTY_TYPE]
	t_1 := [{EMPTY_TYPE} + t_0]
	t_2 := [#_Second INT]
	t_3 := [{t_1} + t_2]
	t_4 := [#Result INT]
	t_5 := [t_3 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [#_First EMPTY_TYPE]
	t_8 := [{EMPTY_TYPE} + t_7]
	t_9 := [#_Second INT]
	t_10 := [{t_8} + t_9]
	t_11 := [#_First EMPTY_TYPE]
	t_12 := [{EMPTY_TYPE} + t_11]
	t_13 := [#_Second INT]
	t_14 := [{t_12} + t_13]
	t_15 := [t_6 => t_5]
	t_16 := [#_First EMPTY_TYPE]
	t_17 := [{EMPTY_TYPE} + t_16]
	t_18 := [#_Second INT]
	t_19 := [{t_17} + t_18]
	t_20 := [EMPTY_TYPE, t_6]
	t_21 := [#_First EMPTY_TYPE]
	t_22 := [{EMPTY_TYPE} + t_21]
	t_23 := [#_Second INT]
	t_24 := [{t_22} + t_23]
	t_25 := [#_First EMPTY_TYPE]
	t_26 := [{EMPTY_TYPE} + t_25]
	t_27 := [#_Second INT]
	t_28 := [{t_26} + t_27]
	t_29 := [t_20, t_15]
	t_30 := [EMPTY_TYPE => INT]
	t_31 := [t_29 => t_30]

§DEF d_0 € t_6
	r_1 := {ARG} #_First
	r_2 := {ARG} #_Second
	_Value := r_2
	r_3 := +#Result _Value
	§RETURN r_3 IF TRUE

§DEF d_1 € t_15
	d_0 := ENV
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_31
	d_1 := §2ND ENV
	r_9 := §1ST ENV
	d_0 := §2ND r_9
	r_10 := §1ST r_9
	r_1 := +#_First EMPTY
	r_2 := {EMPTY} + r_1
	r_3 := 2
	r_4 := +#_Second r_3
	r_5 := {r_2} + r_4
	r_6 := .d_1 d_0
	r_7 := .r_6 r_5
	r_8 := -#Result r_7
	§RETURN r_8 IF TRUE
