§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [t_1, INT]
	t_4 := [t_3 => INT]
	t_5 := [t_2 => t_4]
	t_6 := [#_...*... t_2]
	t_7 := [{EMPTY_TYPE} + t_6]
	t_8 := [t_7 => INT]
	t_9 := [t_5 => t_8]

§DEF d_0 € t_5
	_...*... := ENV
	r_1 := §2ND ARG
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	r_4 := §1ST r_2
	r_5 := §2ND r_4
	_a := r_5
	r_6 := §1ST r_4
	§RETURN r_6 IF_NOT_EMPTY
	r_7 := 2
	r_8 := EMPTY, r_7
	r_9 := r_8, _a
	r_10 := ._...*... r_9
	§RETURN r_10 IF TRUE

§DEF d_1 € t_9
	d_0 := ENV
	r_1 := {ARG} #_...*...
	_...*... := r_1
	r_2 := .d_0 _...*...
	_F... := r_2
	r_3 := 3
	r_4 := EMPTY, r_3
	r_5 := 5
	r_6 := r_4, r_5
	r_7 := 7
	r_8 := r_6, r_7
	r_9 := ._F... r_8
	§RETURN r_9 IF TRUE
