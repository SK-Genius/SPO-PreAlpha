§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [TRUE | FALSE]
	t_4 := [t_3 => INT]
	t_5 := [§VAR INT]
	t_6 := [t_5 : t_4]
	t_7 := [t_2 => t_6]
	t_8 := [#_...+... t_2]
	t_9 := [{EMPTY_TYPE} + t_8]
	t_10 := [t_1, INT]
	t_11 := [t_9 => t_10]
	t_12 := [t_7 => t_11]

§DEF d_0 € t_7
	_...+... := ENV
	_aCondition := ARG
	_aCounter := OBJ
	§BEGIN_IF _aCondition
	r_1 := §VAR _aCounter ->
	r_2 := EMPTY, r_1
	r_3 := 1
	r_4 := r_2, r_3
	r_5 := ._...+... r_4
	§VAR _aCounter <- r_5
	r_6 := §VAR _aCounter ->
	§RETURN r_6 IF TRUE
	§RETURN EMPTY IF TRUE
	§END_IF
	r_7 := 99
	§RETURN r_7 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_1 € t_12
	d_0 := ENV
	r_1 := {ARG} #_...+...
	_...+... := r_1
	r_2 := .d_0 _...+...
	_Select... := r_2
	r_3 := 0
	_Counter := §VAR r_3
	r_5 := _Counter, _Select...
	r_4 := §OBJ:r_5 FALSE
	_Skipped := r_4
	r_7 := _Counter, _Select...
	r_6 := §OBJ:r_7 TRUE
	_Selected := r_6
	r_8 := EMPTY, _Skipped
	r_9 := r_8, _Selected
	r_10 := §VAR _Counter ->
	r_11 := r_9, r_10
	§RETURN r_11 IF TRUE
