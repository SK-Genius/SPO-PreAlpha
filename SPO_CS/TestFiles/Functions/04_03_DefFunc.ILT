§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [EMPTY_TYPE, t_2]
	t_4 := [t_3, INT]
	t_5 := [INT => INT]
	t_6 := [t_4 => t_5]
	t_7 := [#_...*... t_2]
	t_8 := [{EMPTY_TYPE} + t_7]
	t_9 := [t_1, INT]
	t_10 := [t_9, INT]
	t_11 := [t_10, INT]
	t_12 := [t_11, INT]
	t_13 := [t_8 => t_12]
	t_14 := [t_6 => t_13]

§DEF d_0 € t_6
	_K := §2ND ENV
	r_4 := §1ST ENV
	_...*... := §2ND r_4
	r_5 := §1ST r_4
	_a := ARG
	r_1 := EMPTY, _K
	r_2 := r_1, _a
	r_3 := ._...*... r_2
	§RETURN r_3 IF TRUE

§DEF d_1 € t_14
	d_0 := ENV
	r_1 := {ARG} #_...*...
	_...*... := r_1
	r_2 := 3
	_K := r_2
	r_3 := EMPTY, _...*...
	r_4 := r_3, _K
	r_5 := .d_0 r_4
	_X... := r_5
	r_6 := 0
	r_7 := ._X... r_6
	r_8 := EMPTY, r_7
	r_9 := 1
	r_10 := ._X... r_9
	r_11 := r_8, r_10
	r_12 := 2
	r_13 := ._X... r_12
	r_14 := r_11, r_13
	r_15 := 3
	r_16 := ._X... r_15
	r_17 := r_14, r_16
	r_18 := 4
	r_19 := ._X... r_18
	r_20 := r_17, r_19
	r_21 := 5
	r_22 := ._X... r_21
	r_23 := r_20, r_22
	§RETURN r_23 IF TRUE
