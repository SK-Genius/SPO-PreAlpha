§TYPES
	t_0 := [EMPTY_TYPE, EMPTY_TYPE]
	t_1 := [TRUE | FALSE]
	t_2 := [t_0, t_1]
	t_3 := [EMPTY_TYPE, t_2]
	t_4 := [t_2, INT]
	t_5 := [t_3, t_4]
	t_6 := [EMPTY_TYPE, INT]
	t_7 := [t_6, t_1]
	t_8 := [#_BLA...BLUB... t_7]
	t_9 := [t_5, t_8]
	t_10 := [t_6, INT]
	t_11 := [#_...<... t_10]
	t_12 := [t_9, t_11]
	t_13 := [EMPTY_TYPE => t_12]
	t_14 := [EMPTY_TYPE => t_13]

§DEF d_0 € t_14
	r_1 := EMPTY, EMPTY
	r_2 := r_1, TRUE
	_A_0 := r_2
	r_3 := EMPTY, EMPTY
	r_4 := r_3, TRUE
	r_5 := 1
	r_6 := r_4, r_5
	_A_1 := r_6
	r_7 := 1
	r_8 := EMPTY, r_7
	r_9 := r_8, TRUE
	r_10 := +#_BLA...BLUB... r_9
	_A_2 := r_10
	r_11 := 1
	r_12 := EMPTY, r_11
	r_13 := 2
	r_14 := r_12, r_13
	r_15 := +#_...<... r_14
	_A_3 := r_15
	r_16 := EMPTY, _A_0
	r_17 := r_16, _A_1
	r_18 := r_17, _A_2
	r_19 := r_18, _A_3
	§RETURN r_19 IF TRUE
