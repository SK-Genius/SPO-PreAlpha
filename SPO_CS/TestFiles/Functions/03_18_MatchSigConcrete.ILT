§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [§SIG_WITH t_0 IN t_0]
	t_2 := [TRUE | FALSE]
	t_3 := [t_2 | INT]
	t_4 := [#Result t_3]
	t_5 := [t_1 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [t_1 => t_2]
	t_8 := [EMPTY_TYPE => t_7]
	t_9 := [§ABSTRACT TYPE]
	t_10 := [EMPTY_TYPE, t_6]
	t_11 := [t_10, t_8]
	t_12 := [t_11, t_6]
	t_13 := [t_12, t_8]
	t_14 := [t_13, t_6]
	t_15 := [t_14 => t_5]
	t_16 := [t_14, t_15]
	t_17 := [EMPTY_TYPE => t_3]
	t_18 := [t_16 => t_17]

§DEF d_0 € t_6
	r_1 := §TRY ARG HAS_HEAD_TYPE t_2
	r_2 := §SIG_HEAD r_1
	r_3 := §SIG_BODY r_1
	_Value := r_3
	r_4 := +#Result _Value
	§RETURN r_4 IF TRUE

§DEF d_1 € t_8
	r_1 := §TRY ARG HAS_HEAD_TYPE t_2
	r_2 := §SIG_HEAD r_1
	r_3 := §SIG_BODY r_1
	_Value := r_3
	§RETURN TRUE IF TRUE

§DEF d_2 € t_6
	r_1 := §TRY ARG HAS_HEAD_TYPE INT_TYPE
	r_2 := §SIG_HEAD r_1
	r_3 := §SIG_BODY r_1
	_Value := r_3
	r_4 := +#Result _Value
	§RETURN r_4 IF TRUE

§DEF d_3 € t_8
	r_1 := §TRY ARG HAS_HEAD_TYPE INT_TYPE
	r_2 := §SIG_HEAD r_1
	r_3 := §SIG_BODY r_1
	_Value := r_3
	§RETURN TRUE IF TRUE

§DEF d_4 € t_6
	r_1 := §SIG_HEAD ARG AS t_9
	r_2 := §SIG_BODY ARG
	r_3 := 0
	r_4 := +#Result r_3
	§RETURN r_4 IF TRUE

§DEF d_5 € t_15
	d_4 := §2ND ENV
	r_6 := §1ST ENV
	d_3 := §2ND r_6
	r_7 := §1ST r_6
	d_2 := §2ND r_7
	r_8 := §1ST r_7
	d_1 := §2ND r_8
	r_9 := §1ST r_8
	d_0 := §2ND r_9
	r_10 := §1ST r_9
	r_1 := .d_0 EMPTY
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_1 ARG IF r_2
	r_3 := .d_2 EMPTY
	r_4 := .d_3 EMPTY
	§TRY_RETURN .r_3 ARG IF r_4
	r_5 := .d_4 EMPTY
	§TRY_RETURN .r_5 ARG
	§RETURN EMPTY IF TRUE

§DEF d_6 € t_18
	d_5 := §2ND ENV
	r_12 := §1ST ENV
	d_4 := §2ND r_12
	r_13 := §1ST r_12
	d_3 := §2ND r_13
	r_14 := §1ST r_13
	d_2 := §2ND r_14
	r_15 := §1ST r_14
	d_1 := §2ND r_15
	r_16 := §1ST r_15
	d_0 := §2ND r_16
	r_17 := §1ST r_16
	_Contract := t_1
	_tBool := t_2
	r_1 := 1
	r_2 := INT_TYPE, r_1
	r_3 := §SIG t_1 WITH r_2
	r_4 := EMPTY, d_0
	r_5 := r_4, d_1
	r_6 := r_5, d_2
	r_7 := r_6, d_3
	r_8 := r_7, d_4
	r_9 := .d_5 r_8
	r_10 := .r_9 r_3
	r_11 := -#Result r_10
	§RETURN r_11 IF TRUE
