§TYPES
	t_0 := [EMPTY_TYPE, EMPTY_TYPE]
	t_1 := [t_0, EMPTY_TYPE]
	t_2 := [#Result INT]
	t_3 := [t_1 => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [t_0, INT]
	t_6 := [t_5 => t_2]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE, INT]
	t_9 := [t_8, EMPTY_TYPE]
	t_10 := [t_9 => t_2]
	t_11 := [EMPTY_TYPE => t_10]
	t_12 := [t_8, INT]
	t_13 := [t_12 => t_2]
	t_14 := [EMPTY_TYPE => t_13]
	t_15 := [EMPTY_TYPE, t_4]
	t_16 := [t_15, t_7]
	t_17 := [t_16, t_11]
	t_18 := [t_17, t_14]
	t_19 := [INT | EMPTY_TYPE]
	t_20 := [EMPTY_TYPE, t_19]
	t_21 := [t_20, t_19]
	t_22 := [t_21 => t_2]
	t_23 := [t_18 => t_22]
	t_24 := [t_18, t_23]
	t_25 := [EMPTY_TYPE => INT]
	t_26 := [t_24 => t_25]

§DEF d_0 € t_4
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := 1
	r_6 := +#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_1 € t_7
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := 2
	r_6 := +#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_2 € t_11
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := 3
	r_6 := +#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_3 € t_14
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := 4
	r_6 := +#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_4 € t_23
	d_3 := §2ND ENV
	r_5 := §1ST ENV
	d_2 := §2ND r_5
	r_6 := §1ST r_5
	d_1 := §2ND r_6
	r_7 := §1ST r_6
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_2 ARG
	r_3 := .d_2 EMPTY
	§TRY_RETURN .r_3 ARG
	r_4 := .d_3 EMPTY
	§TRY_RETURN .r_4 ARG
	§RETURN EMPTY IF TRUE

§DEF d_5 € t_26
	d_4 := §2ND ENV
	r_12 := §1ST ENV
	d_3 := §2ND r_12
	r_13 := §1ST r_12
	d_2 := §2ND r_13
	r_14 := §1ST r_13
	d_1 := §2ND r_14
	r_15 := §1ST r_14
	d_0 := §2ND r_15
	r_16 := §1ST r_15
	r_1 := 1
	_X := r_1
	r_2 := 2
	_Y := r_2
	r_3 := EMPTY, _X
	r_4 := r_3, _Y
	r_5 := EMPTY, d_0
	r_6 := r_5, d_1
	r_7 := r_6, d_2
	r_8 := r_7, d_3
	r_9 := .d_4 r_8
	r_10 := .r_9 r_4
	r_11 := -#Result r_10
	§RETURN r_11 IF TRUE
