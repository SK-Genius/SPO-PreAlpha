	t_19 := [t_15, t_18]
	t_20 := [EMPTY_TYPE, t_19]
	t_21 := [t_20, t_19]
	t_22 := [EMPTY_TYPE, t_10]
	t_23 := [t_22, t_2]
	t_24 := [t_23 | EMPTY_TYPE]
	t_25 := [§REC t_2 => t_24]
	t_26 := [t_22, t_25]
	t_27 := [t_21, t_26]
	t_28 := [EMPTY_TYPE => t_27]
	t_29 := [t_14 => t_28]

§DEF d_0 € t_9
	r_1 := §2ND ARG
	_aTail := r_1
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	_aHead := r_3
	r_4 := §1ST r_2
	§RETURN r_4 IF_NOT_EMPTY
	r_5 := EMPTY, _aHead
	r_6 := r_5, _aTail
	§RETURN r_6 IF TRUE

§DEF d_1 € t_12
	_a := ARG
	§RETURN _a IF TRUE

§DEF d_2 € t_29
	d_1 := §2ND ENV
	r_41 := §1ST ENV
	d_0 := §2ND r_41
	r_42 := §1ST r_41
	_t := [§FREE]
	_tStack := [§FREE]
	r_1 := [_t, _tStack]
	r_2 := [r_1 | EMPTY_TYPE]
	r_3 := [§REC _tStack => r_2]
	r_4 := [§ALL _t => r_3]
	_tStack... := r_4
	r_5 := .d_0 EMPTY
	_Push...To... := r_5
	r_6 := .d_1 EMPTY
	_...AsBool := r_6
	r_7 := 3
	r_8 := EMPTY, r_7
	r_9 := 2
	r_10 := EMPTY, r_9
	r_11 := 1
	r_12 := EMPTY, r_11
	r_13 := r_12, EMPTY
	r_14 := ._Push...To... r_13
	r_15 := r_10, r_14
	r_16 := ._Push...To... r_15
	r_17 := r_8, r_16
	r_18 := ._Push...To... r_17
	r_19 := EMPTY, r_18
	r_20 := 3
	r_21 := EMPTY, r_20
	r_22 := 2
	r_23 := EMPTY, r_22
	r_24 := 1
	r_25 := EMPTY, r_24
	r_26 := r_25, EMPTY
	r_27 := ._Push...To... r_26
	r_28 := r_23, r_27
	r_29 := ._Push...To... r_28
	r_30 := r_21, r_29
	r_31 := ._Push...To... r_30
	r_32 := r_19, r_31
	r_33 := EMPTY, TRUE
	r_34 := ._...AsBool FALSE
	r_35 := EMPTY, r_34
	r_36 := r_35, EMPTY
	r_37 := ._Push...To... r_36
	r_38 := r_33, r_37
	r_39 := ._Push...To... r_38
	r_40 := r_32, r_39
	§RETURN r_40 IF TRUE
