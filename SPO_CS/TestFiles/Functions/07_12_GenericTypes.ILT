	t_7 := [t_6 => t_6]
	t_8 := [§ALL t_0 => t_7]
	t_9 := [EMPTY_TYPE => t_8]
	t_10 := [TRUE | FALSE]
	t_11 := [t_10 => t_10]
	t_12 := [EMPTY_TYPE => t_11]
	t_13 := [EMPTY_TYPE, t_9]
	t_14 := [t_13, t_12]
	t_15 := [EMPTY_TYPE, INT]
