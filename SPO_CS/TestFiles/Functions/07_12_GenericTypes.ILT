§TYPES
	t_0 := [§FREE]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [§FREE]
	t_3 := [t_1, t_2]
	t_4 := [t_3 | EMPTY_TYPE]
	t_5 := [§REC t_2 => t_4]
