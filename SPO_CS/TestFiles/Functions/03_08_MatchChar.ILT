§TYPES
	t_0 := [#_Char... INT]
	t_1 := [#Result INT]
	t_2 := [t_0 => t_1]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [FALSE | TRUE]
	t_5 := [t_0 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [EMPTY_TYPE, t_3]
	t_8 := [t_7, t_6]
	t_9 := [t_8, t_3]
	t_10 := [t_9 => t_2]
	t_11 := [t_9, t_10]
	t_12 := [EMPTY_TYPE => INT]
	t_13 := [t_11 => t_12]

§DEF d_0 € t_3
	r_1 := -#_Char... ARG
	r_2 := 1
	r_3 := +#Result r_2
	§RETURN r_3 IF TRUE

§DEF d_1 € t_6
	r_1 := -#_Char... ARG
	r_2 := 65
	r_3 := §INT r_1 == r_2
	r_4 := §BOOL r_3 ^ TRUE
	§RETURN FALSE IF r_4
	§RETURN TRUE IF TRUE

§DEF d_2 € t_3
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_3 € t_10
	d_2 := §2ND ENV
	r_4 := §1ST ENV
	d_1 := §2ND r_4
	r_5 := §1ST r_4
	d_0 := §2ND r_5
	r_6 := §1ST r_5
	r_1 := .d_0 EMPTY
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_1 ARG IF r_2
	r_3 := .d_2 EMPTY
	§TRY_RETURN .r_3 ARG
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_13
	d_3 := §2ND ENV
	r_9 := §1ST ENV
	d_2 := §2ND r_9
	r_10 := §1ST r_9
	d_1 := §2ND r_10
	r_11 := §1ST r_10
	d_0 := §2ND r_11
	r_12 := §1ST r_11
	r_1 := 65
	r_2 := +#_Char... r_1
	r_3 := EMPTY, d_0
	r_4 := r_3, d_1
	r_5 := r_4, d_2
	r_6 := .d_3 r_5
	r_7 := .r_6 r_2
	r_8 := -#Result r_7
	§RETURN r_8 IF TRUE
