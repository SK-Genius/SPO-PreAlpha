§TYPES
	t_0 := [INT => INT]
	t_1 := [EMPTY_TYPE => t_0]
	t_2 := [EMPTY_TYPE, INT]
	t_3 := [t_2, EMPTY_TYPE]
	t_4 := [t_3 => INT]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [EMPTY_TYPE, EMPTY_TYPE]
	t_7 := [t_6, INT]
	t_8 := [t_7 => INT]
	t_9 := [EMPTY_TYPE => t_8]
	t_10 := [§FREE]
	t_11 := [EMPTY_TYPE, t_10]
	t_12 := [t_10 => t_11]
	t_13 := [§ALL t_10 => t_12]
	t_14 := [EMPTY_TYPE => t_13]
	t_15 := [EMPTY_TYPE, t_1]
	t_16 := [t_15, t_1]
	t_17 := [t_16, t_5]
	t_18 := [t_17, t_9]
	t_19 := [t_18, t_14]
	t_20 := [t_2, INT]
	t_21 := [t_20, INT]
	t_22 := [t_21, INT]
	t_23 := [t_22, t_2]
	t_24 := [EMPTY_TYPE => t_23]
	t_25 := [t_19 => t_24]

§DEF d_0 € t_1
	_Value := ARG
	§RETURN _Value IF TRUE

§DEF d_1 € t_1
	_Value := ARG
	§RETURN _Value IF TRUE

§DEF d_2 € t_5
	r_1 := §2ND ARG
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	_Value := r_3
	r_4 := §1ST r_2
	§RETURN r_4 IF_NOT_EMPTY
	§RETURN _Value IF TRUE

§DEF d_3 € t_9
	r_1 := §2ND ARG
	_Value := r_1
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	r_4 := §1ST r_2
	§RETURN r_4 IF_NOT_EMPTY
	§RETURN _Value IF TRUE

§DEF d_4 € t_14
	_Value := ARG
	r_1 := EMPTY, _Value
	§RETURN r_1 IF TRUE

§DEF d_5 € t_25
	d_4 := §2ND ENV
	r_25 := §1ST ENV
	d_3 := §2ND r_25
	r_26 := §1ST r_25
	d_2 := §2ND r_26
	r_27 := §1ST r_26
	d_1 := §2ND r_27
	r_28 := §1ST r_27
	d_0 := §2ND r_28
	r_29 := §1ST r_28
	r_1 := .d_0 EMPTY
	_...Right := r_1
	r_2 := .d_1 EMPTY
	_Left... := r_2
	r_3 := .d_2 EMPTY
	_...RightWith... := r_3
	r_4 := .d_3 EMPTY
	_Left...Then... := r_4
	r_5 := .d_4 EMPTY
	_...GenericList := r_5
	r_6 := 7
	r_7 := ._...Right r_6
	r_8 := EMPTY, r_7
	r_9 := 8
	r_10 := ._Left... r_9
	r_11 := r_8, r_10
	r_12 := 9
	r_13 := EMPTY, r_12
	r_14 := r_13, EMPTY
	r_15 := ._...RightWith... r_14
	r_16 := r_11, r_15
	r_17 := EMPTY, EMPTY
	r_18 := 10
	r_19 := r_17, r_18
	r_20 := ._Left...Then... r_19
	r_21 := r_16, r_20
	r_22 := 11
	r_23 := ._...GenericList r_22
	r_24 := r_21, r_23
	§RETURN r_24 IF TRUE
