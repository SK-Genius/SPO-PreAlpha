§DEF tStack... = [§GENERIC t [§RECURSIVE tStack [[] | [t, tStack]]]]

§DEF Push...To... = (
	§DEF t € §TYPE
) <=> (
	§DEF aHead € t
	§DEF aTail € [.tStack t]
) => (aHead, aTail)

§DEF ...AsBool = (
	a € §BOOL
) => a

§EXPORT (
	.Push 3 To (.Push 2 To (.Push 1 To ()))
	.Push 3 To §<.Push 2 To §<.Push 1 To ()
	.Push §TRUE To (.Push (§FALSE.AsBool) To ())
)