§TYPES
	t_0 := [EMPTY_TYPE => INT]
	t_1 := [EMPTY_TYPE => t_0]
	t_2 := [EMPTY_TYPE => TRUE]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [EMPTY_TYPE, t_1]
	t_5 := [t_4, t_3]
	t_6 := [EMPTY_TYPE, t_0]
	t_7 := [t_6, t_2]
	t_8 := [t_7 => t_7]
	t_9 := [t_5 => t_8]
	t_10 := [t_5, t_9]
	t_11 := [EMPTY_TYPE, INT]
	t_12 := [t_11, TRUE]
	t_13 := [EMPTY_TYPE => t_12]
	t_14 := [t_10 => t_13]

§DEF d_0 € t_1
	§RETURN ARG IF_NOT_EMPTY
	r_1 := 7
	§RETURN r_1 IF TRUE

§DEF d_1 € t_3
	§RETURN ARG IF_NOT_EMPTY
	§RETURN TRUE IF TRUE

§DEF d_2 € t_9
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	_Flag... := §2ND ARG
	r_1 := §1ST ARG
	_Number... := §2ND r_1
	r_2 := §1ST r_1
	r_3 := .d_0 EMPTY
	r_4 := EMPTY, r_3
	r_5 := .d_1 EMPTY
	r_6 := r_4, r_5
	§RETURN r_6 IF TRUE

§DEF d_3 € t_14
	d_2 := §2ND ENV
	r_10 := §1ST ENV
	d_1 := §2ND r_10
	r_11 := §1ST r_10
	d_0 := §2ND r_11
	r_12 := §1ST r_11
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	§REC r_3 := .d_2 r_2
	_Flag... := §2ND r_3
	r_4 := §1ST r_3
	_Number... := §2ND r_4
	r_5 := §1ST r_4
	r_6 := ._Number... EMPTY
	r_7 := EMPTY, r_6
	r_8 := ._Flag... EMPTY
	r_9 := r_7, r_8
	§RETURN r_9 IF TRUE
