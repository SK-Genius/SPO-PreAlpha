§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [EMPTY_TYPE | t_0]
	t_2 := [§ALL t_0 => t_1]
	t_3 := [EMPTY_TYPE | INT]
	t_4 := [EMPTY_TYPE, t_3]
	t_5 := [t_4, t_3]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [EMPTY_TYPE => t_6]

§DEF d_0 € t_7
	_tMaybe... := t_2
	_X := EMPTY
	r_1 := 1
	_Y := r_1
	r_2 := EMPTY, _X
	r_3 := r_2, _Y
	§RETURN r_3 IF TRUE
