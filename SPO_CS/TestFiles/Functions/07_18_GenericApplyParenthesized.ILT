§TYPES
	t_0 := [EMPTY_TYPE | INT]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [t_1, t_0]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [EMPTY_TYPE => t_3]

§DEF d_0 € t_4
	r_1 := [§FREE]
	r_2 := [EMPTY_TYPE | r_1]
	r_3 := [§ALL r_1 => r_2]
	_tMaybe... := r_3
	_X := EMPTY
	r_4 := 1
	_Y := r_4
	r_5 := EMPTY, _X
	r_6 := r_5, _Y
	§RETURN r_6 IF TRUE
