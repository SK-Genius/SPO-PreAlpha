§TYPES
	t_0 := [TRUE | FALSE]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [t_1, t_0]
	t_3 := [t_2 => t_0]
	t_4 := [EMPTY_TYPE, t_3]
	t_5 := [EMPTY_TYPE, INT]
	t_6 := [t_5, INT]
	t_7 := [t_6 => t_0]
	t_8 := [t_4, t_7]
	t_9 := [t_6, INT]
	t_10 := [t_9 => t_0]
	t_11 := [t_8 => t_10]
	t_12 := [#_...<=... t_7]
	t_13 := [{EMPTY_TYPE} + t_12]
	t_14 := [#_...And... t_3]
	t_15 := [{t_13} + t_14]
	t_16 := [t_15 => t_2]
	t_17 := [t_11 => t_16]

§DEF d_0 € t_11
	_...<=... := §2ND ENV
	r_16 := §1ST ENV
	_...And... := §2ND r_16
	r_17 := §1ST r_16
	r_1 := §2ND ARG
	_aMax := r_1
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	_aVal := r_3
	r_4 := §1ST r_2
	r_5 := §2ND r_4
	_aMin := r_5
	r_6 := §1ST r_4
	§RETURN r_6 IF_NOT_EMPTY
	r_7 := EMPTY, _aMin
	r_8 := r_7, _aVal
	r_9 := ._...<=... r_8
	r_10 := EMPTY, r_9
	r_11 := EMPTY, _aVal
	r_12 := r_11, _aMax
	r_13 := ._...<=... r_12
	r_14 := r_10, r_13
	r_15 := ._...And... r_14
	§RETURN r_15 IF TRUE

§DEF d_1 € t_17
	d_0 := ENV
	r_1 := {ARG} #_...<=...
	_...<=... := r_1
	r_2 := {ARG} #_...And...
	_...And... := r_2
	r_3 := EMPTY, _...And...
	r_4 := r_3, _...<=...
	r_5 := .d_0 r_4
	_...<=...<=... := r_5
	r_6 := 3
	r_7 := EMPTY, r_6
	r_8 := 5
	r_9 := r_7, r_8
	r_10 := 7
	r_11 := r_9, r_10
	r_12 := ._...<=...<=... r_11
	r_13 := EMPTY, r_12
	r_14 := 3
	r_15 := EMPTY, r_14
	r_16 := 1
	r_17 := r_15, r_16
	r_18 := 7
	r_19 := r_17, r_18
	r_20 := ._...<=...<=... r_19
	r_21 := r_13, r_20
	§RETURN r_21 IF TRUE
