§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [TRUE | FALSE]
	t_3 := [t_1 => t_2]
	t_4 := [EMPTY_TYPE, t_3]
	t_5 := [t_4, INT]
	t_6 := [t_1 => INT]
	t_7 := [t_5, t_6]
	t_8 := [INT => INT]
	t_9 := [t_7, t_8]
	t_10 := [t_9, t_6]
	t_11 := [INT | EMPTY_TYPE]
	t_12 := [EMPTY_TYPE => t_11]
	t_13 := [t_10 => t_12]
	t_14 := [t_4, t_6]
	t_15 := [t_14, t_8]
	t_16 := [t_15, t_6]
	t_17 := [t_16, t_13]
	t_18 := [t_17 => t_8]
	t_19 := [t_14, t_6]
	t_20 := [t_19, t_13]
	t_21 := [t_20, t_18]
	t_22 := [t_8 => t_8]
	t_23 := [t_21 => t_22]
	t_24 := [EMPTY_TYPE, t_13]
	t_25 := [t_24, t_18]
	t_26 := [t_25, t_23]
	t_27 := [#_...+... t_6]
	t_28 := [{EMPTY_TYPE} + t_27]
	t_29 := [#_...-... t_6]
	t_30 := [{t_28} + t_29]
	t_31 := [#_...<... t_3]
	t_32 := [{t_30} + t_31]
	t_33 := [#_...==... t_3]
	t_34 := [{t_32} + t_33]
	t_35 := [t_1, INT]
	t_36 := [t_35, INT]
	t_37 := [t_36, INT]
	t_38 := [t_37, INT]
	t_39 := [t_38, INT]
	t_40 := [t_34 => t_39]
	t_41 := [t_26 => t_40]

§DEF d_0 € t_13
	_...-... := §2ND ENV
	r_18 := §1ST ENV
	_Fib... := §2ND r_18
	r_19 := §1ST r_18
	_...+... := §2ND r_19
	r_20 := §1ST r_19
	_a := §2ND r_20
	r_21 := §1ST r_20
	_...<... := §2ND r_21
	r_22 := §1ST r_21
	§RETURN ARG IF_NOT_EMPTY
	r_1 := EMPTY, _a
	r_2 := 2
	r_3 := r_1, r_2
	r_4 := ._...<... r_3
	§RETURN _a IF r_4
	r_5 := EMPTY, _a
	r_6 := 2
	r_7 := r_5, r_6
	r_8 := ._...-... r_7
	r_9 := ._Fib... r_8
	r_10 := EMPTY, r_9
	r_11 := EMPTY, _a
	r_12 := 1
	r_13 := r_11, r_12
	r_14 := ._...-... r_13
	r_15 := ._Fib... r_14
	r_16 := r_10, r_15
	r_17 := ._...+... r_16
	§RETURN r_17 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_1 € t_18
	d_0 := §2ND ENV
	r_9 := §1ST ENV
	_...-... := §2ND r_9
	r_10 := §1ST r_9
	_Fib... := §2ND r_10
	r_11 := §1ST r_10
	_...+... := §2ND r_11
	r_12 := §1ST r_11
	_...<... := §2ND r_12
	r_13 := §1ST r_12
	_a := ARG
	r_2 := EMPTY, _...<...
	r_3 := r_2, _a
	r_4 := r_3, _...+...
	r_5 := r_4, _Fib...
	r_6 := r_5, _...-...
	r_7 := .d_0 r_6
	r_8 := .r_7 EMPTY
	r_1 := r_8
	§RETURN r_1 IF TRUE

§DEF d_2 € t_23
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	_...-... := §2ND r_8
	r_9 := §1ST r_8
	_...+... := §2ND r_9
	r_10 := §1ST r_9
	_...<... := §2ND r_10
	r_11 := §1ST r_10
	_Fib... := ARG
	r_1 := EMPTY, _...<...
	r_2 := r_1, _...+...
	r_3 := r_2, _Fib...
	r_4 := r_3, _...-...
	r_5 := r_4, d_0
	r_6 := .d_1 r_5
	§RETURN r_6 IF TRUE

§DEF d_3 € t_41
	d_2 := §2ND ENV
	r_32 := §1ST ENV
	d_1 := §2ND r_32
	r_33 := §1ST r_32
	d_0 := §2ND r_33
	r_34 := §1ST r_33
	r_1 := {ARG} #_...<...
	_...<... := r_1
	r_2 := {ARG} #_...==...
	_...==... := r_2
	r_3 := {ARG} #_...+...
	_...+... := r_3
	r_4 := {ARG} #_...-...
	_...-... := r_4
	r_5 := EMPTY, _...<...
	r_6 := r_5, _...+...
	r_7 := r_6, _...-...
	r_8 := r_7, d_0
	r_9 := r_8, d_1
	§REC r_10 := .d_2 r_9
	_Fib... := r_10
	r_11 := 0
	r_12 := ._Fib... r_11
	r_13 := EMPTY, r_12
	r_14 := 1
	r_15 := ._Fib... r_14
	r_16 := r_13, r_15
	r_17 := 2
	r_18 := ._Fib... r_17
	r_19 := r_16, r_18
	r_20 := 3
	r_21 := ._Fib... r_20
	r_22 := r_19, r_21
	r_23 := 4
	r_24 := ._Fib... r_23
	r_25 := r_22, r_24
	r_26 := 5
	r_27 := ._Fib... r_26
	r_28 := r_25, r_27
	r_29 := 6
	r_30 := ._Fib... r_29
	r_31 := r_28, r_30
	§RETURN r_31 IF TRUE
