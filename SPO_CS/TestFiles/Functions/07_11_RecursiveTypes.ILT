§TYPES
	t_0 := [§FREE]
	t_1 := [t_0, INT]
	t_2 := [t_1 | EMPTY_TYPE]
	t_3 := [§REC t_0 => t_2]
	t_4 := [EMPTY_TYPE, t_3]
	t_5 := [t_4, INT]
	t_6 := [t_3, INT]
	t_7 := [t_5 => t_6]
	t_8 := [EMPTY_TYPE => t_7]
	t_9 := [EMPTY_TYPE => t_6]
	t_10 := [t_8 => t_9]

§DEF d_0 € t_8
	r_1 := §2ND ARG
	_aHead := r_1
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	_aTail := r_3
	r_4 := §1ST r_2
	§RETURN r_4 IF_NOT_EMPTY
	r_5 := _aTail, _aHead
	§RETURN r_5 IF TRUE

§DEF d_1 € t_10
	d_0 := ENV
	r_1 := [§FREE]
	r_2 := [r_1, INT_TYPE]
	r_3 := [r_2 | EMPTY_TYPE]
	r_4 := [§REC r_1 => r_3]
	_tIntArray := r_4
	r_5 := .d_0 EMPTY
	_...Append... := r_5
	r_6 := EMPTY, EMPTY
	r_7 := 1
	r_8 := r_6, r_7
	r_9 := ._...Append... r_8
	r_10 := EMPTY, r_9
	r_11 := 2
	r_12 := r_10, r_11
	r_13 := ._...Append... r_12
	r_14 := EMPTY, r_13
	r_15 := 3
	r_16 := r_14, r_15
	r_17 := ._...Append... r_16
	§RETURN r_17 IF TRUE
