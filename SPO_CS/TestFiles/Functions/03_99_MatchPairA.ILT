§TYPES
	t_0 := [EMPTY_TYPE, EMPTY_TYPE]
	t_1 := [t_0, INT]
	t_2 := [#Result INT]
	t_3 := [t_1 => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [t_4 => t_3]
	t_6 := [EMPTY_TYPE, t_4]
	t_7 := [t_6, t_5]
	t_8 := [EMPTY_TYPE => INT]
	t_9 := [t_7 => t_8]

§DEF d_0 € t_4
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	_Second := r_2
	r_5 := +#Result _Second
	§RETURN r_5 IF TRUE

§DEF d_1 € t_5
	d_0 := ENV
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_9
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_1 := EMPTY, EMPTY
	r_2 := 2
	r_3 := r_1, r_2
	r_4 := .d_1 d_0
	r_5 := .r_4 r_3
	r_6 := -#Result r_5
	§RETURN r_6 IF TRUE
