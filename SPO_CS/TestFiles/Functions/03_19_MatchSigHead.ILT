§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [§SIG_WITH t_0 IN t_0]
	t_2 := [§ABSTRACT TYPE]
	t_3 := [#Result TYPE]
	t_4 := [t_1 => t_3]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [t_5 => t_4]
	t_7 := [EMPTY_TYPE, t_5]
	t_8 := [t_7, t_6]
	t_9 := [EMPTY_TYPE => TYPE]
	t_10 := [t_8 => t_9]

§DEF d_0 € t_5
	r_1 := §SIG_HEAD ARG AS t_2
	r_2 := §SIG_BODY ARG
	_Head := r_1
	r_3 := +#Result _Head
	§RETURN r_3 IF TRUE

§DEF d_1 € t_6
	d_0 := ENV
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_10
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	_Contract := t_1
	r_1 := 1
	r_2 := INT_TYPE, r_1
	r_3 := §SIG t_1 WITH r_2
	r_4 := .d_1 d_0
	r_5 := .r_4 r_3
	r_6 := -#Result r_5
	§RETURN r_6 IF TRUE
