§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [t_0, EMPTY_TYPE]
	t_2 := [t_1 | INT]
	t_3 := [§REC t_0 => t_2]
	t_4 := [#Result INT]
	t_5 := [INT => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [TRUE | FALSE]
	t_8 := [INT => t_7]
	t_9 := [EMPTY_TYPE => t_8]
	t_10 := [§FREE TYPE]
	t_11 := [t_10, EMPTY_TYPE]
	t_12 := [t_11 | INT]
	t_13 := [§REC t_10 => t_12]
	t_14 := [t_13, EMPTY_TYPE]
	t_15 := [t_14 | INT]
	t_16 := [t_15 => t_4]
	t_17 := [EMPTY_TYPE => t_16]
	t_18 := [EMPTY_TYPE, t_6]
	t_19 := [t_18, t_9]
	t_20 := [t_19, t_17]
	t_21 := [t_13 => t_4]
	t_22 := [t_20 => t_21]
	t_23 := [t_20, t_22]
	t_24 := [t_13 => INT]
	t_25 := [t_23 => t_24]
	t_26 := [t_23, t_25]
	t_27 := [EMPTY_TYPE, INT]
	t_28 := [t_27, INT]
	t_29 := [EMPTY_TYPE => t_28]
	t_30 := [t_26 => t_29]

§DEF d_0 € t_6
	r_1 := 1
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_9
	r_1 := 1
	r_2 := §INT ARG == r_1
	r_3 := §BOOL r_2 ^ TRUE
	§RETURN FALSE IF r_3
	§RETURN TRUE IF TRUE

§DEF d_2 € t_17
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_3 € t_22
	d_2 := §2ND ENV
	r_4 := §1ST ENV
	d_1 := §2ND r_4
	r_5 := §1ST r_4
	d_0 := §2ND r_5
	r_6 := §1ST r_5
	r_1 := .d_0 EMPTY
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_1 ARG IF r_2
	r_3 := .d_2 EMPTY
	§TRY_RETURN .r_3 ARG
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_25
	d_3 := §2ND ENV
	r_7 := §1ST ENV
	d_2 := §2ND r_7
	r_8 := §1ST r_7
	d_1 := §2ND r_8
	r_9 := §1ST r_8
	d_0 := §2ND r_9
	r_10 := §1ST r_9
	_Value := ARG
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := .d_3 r_3
	r_5 := .r_4 _Value
	r_6 := -#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_5 € t_30
	d_4 := §2ND ENV
	r_12 := §1ST ENV
	d_3 := §2ND r_12
	r_13 := §1ST r_12
	d_2 := §2ND r_13
	r_14 := §1ST r_13
	d_1 := §2ND r_14
	r_15 := §1ST r_14
	d_0 := §2ND r_15
	r_16 := §1ST r_15
	_tRecursive := t_3
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := r_3, d_3
	r_5 := .d_4 r_4
	_Match... := r_5
	r_6 := 2
	r_7 := ._Match... r_6
	r_8 := EMPTY, r_7
	r_9 := 1
	r_10 := ._Match... r_9
	r_11 := r_8, r_10
	§RETURN r_11 IF TRUE
