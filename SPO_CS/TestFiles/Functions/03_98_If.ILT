§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => BOOL]
	t_3 := [EMPTY_TYPE, t_2]
	t_4 := [t_3, INT]
	t_5 := [INT | EMPTY_TYPE]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [t_4 => t_6]
	t_8 := [#_...==... t_2]
	t_9 := [{EMPTY_TYPE} + t_8]
	t_10 := [t_9 => INT]
	t_11 := [t_7 => t_10]

§DEF d_0 € t_7
	_X := §2ND ENV
	r_11 := §1ST ENV
	_...==... := §2ND r_11
	r_12 := §1ST r_11
	§RETURN ARG IF_NOT_EMPTY
	r_1 := EMPTY, _X
	r_2 := 1
	r_3 := r_1, r_2
	r_4 := ._...==... r_3
	r_5 := 11
	§RETURN r_5 IF r_4
	r_6 := EMPTY, _X
	r_7 := 2
	r_8 := r_6, r_7
	r_9 := ._...==... r_8
	r_10 := 22
	§RETURN r_10 IF r_9
	§RETURN EMPTY IF TRUE

§DEF d_1 € t_11
	d_0 := ENV
	r_1 := {ARG} #_...==...
	_...==... := r_1
	r_2 := 1
	_X := r_2
	r_4 := EMPTY, _...==...
	r_5 := r_4, _X
	r_6 := .d_0 r_5
	r_7 := .r_6 EMPTY
	r_3 := r_7
	_Y := r_3
	§RETURN _Y IF TRUE
