§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [TRUE | FALSE]
	t_4 := [t_3 => INT]
	t_5 := [t_2 => t_4]
	t_6 := [#_.../... t_2]
	t_7 := [{EMPTY_TYPE} + t_6]
	t_8 := [t_7 => INT]
	t_9 := [t_5 => t_8]

§DEF d_0 € t_5
	_.../... := ENV
	_aCondition := ARG
	§BEGIN_IF _aCondition
	r_1 := 1
	r_2 := EMPTY, r_1
	r_3 := 0
	r_4 := r_2, r_3
	r_5 := ._.../... r_4
	§RETURN r_5 IF TRUE
	§END_IF
	r_6 := 42
	§RETURN r_6 IF TRUE

§DEF d_1 € t_9
	d_0 := ENV
	r_1 := {ARG} #_.../...
	_.../... := r_1
	r_2 := .d_0 _.../...
	_Choose... := r_2
	r_3 := ._Choose... FALSE
	§RETURN r_3 IF TRUE
