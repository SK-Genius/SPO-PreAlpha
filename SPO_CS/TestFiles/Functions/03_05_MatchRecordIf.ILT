§TYPES
	t_0 := [#_First INT]
	t_1 := [{EMPTY_TYPE} + t_0]
	t_2 := [#_Second INT]
	t_3 := [{t_1} + t_2]
	t_4 := [#Result INT]
	t_5 := [t_3 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [#_First INT]
	t_8 := [{EMPTY_TYPE} + t_7]
	t_9 := [#_Second INT]
	t_10 := [{t_8} + t_9]
	t_11 := [t_6 => t_5]
	t_12 := [#_First INT]
	t_13 := [{EMPTY_TYPE} + t_12]
	t_14 := [#_Second INT]
	t_15 := [{t_13} + t_14]
	t_16 := [EMPTY_TYPE, t_6]
	t_17 := [#_First INT]
	t_18 := [{EMPTY_TYPE} + t_17]
	t_19 := [#_Second INT]
	t_20 := [{t_18} + t_19]
	t_21 := [t_16, t_11]
	t_22 := [EMPTY_TYPE => INT]
	t_23 := [t_21 => t_22]

§DEF d_0 € t_6
	r_1 := {ARG} #_Second
	_Value := r_1
	r_2 := +#Result _Value
	§RETURN r_2 IF TRUE

§DEF d_1 € t_11
	d_0 := ENV
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_23
	d_1 := §2ND ENV
	r_10 := §1ST ENV
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	r_1 := 1
	r_2 := +#_First r_1
	r_3 := {EMPTY} + r_2
	r_4 := 2
	r_5 := +#_Second r_4
	r_6 := {r_3} + r_5
	r_7 := .d_1 d_0
	r_8 := .r_7 r_6
	r_9 := -#Result r_8
	§RETURN r_9 IF TRUE
