§TYPES
	t_0 := [EMPTY_TYPE, EMPTY_TYPE]
	t_1 := [t_0, INT]
	t_2 := [TRUE | FALSE]
	t_3 := [#Result t_2]
	t_4 := [t_1 => t_3]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [t_5 => t_4]
	t_7 := [EMPTY_TYPE, t_5]
	t_8 := [t_7, t_6]
	t_9 := [EMPTY_TYPE => INT]
	t_10 := [t_8 => t_9]
	t_11 := [t_8, t_10]
	t_12 := [t_11 => t_9]

§DEF d_0 € t_5
	r_1 := §1ST ARG
	r_2 := §2ND ARG
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := +#Result TRUE
	§RETURN r_5 IF TRUE

§DEF d_1 € t_6
	d_0 := ENV
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_10
	d_1 := §2ND ENV
	r_9 := §1ST ENV
	d_0 := §2ND r_9
	r_10 := §1ST r_9
	§RETURN ARG IF_NOT_EMPTY
	r_1 := EMPTY, EMPTY
	r_2 := 7
	r_3 := r_1, r_2
	r_4 := .d_1 d_0
	r_5 := .r_4 r_3
	r_6 := -#Result r_5
	r_7 := 1
	§RETURN r_7 IF r_6
	r_8 := 0
	§RETURN r_8 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_12
	d_2 := §2ND ENV
	r_6 := §1ST ENV
	d_1 := §2ND r_6
	r_7 := §1ST r_6
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_2 := EMPTY, d_0
	r_3 := r_2, d_1
	r_4 := .d_2 r_3
	r_5 := .r_4 EMPTY
	r_1 := r_5
	§RETURN r_1 IF TRUE
