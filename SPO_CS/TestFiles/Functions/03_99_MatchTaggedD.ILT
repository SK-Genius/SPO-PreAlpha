§TYPES
	t_0 := [#_Box... INT]
	t_1 := [TRUE | FALSE]
	t_2 := [#Result t_1]
	t_3 := [t_0 => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [t_4 => t_3]
	t_6 := [EMPTY_TYPE, t_4]
	t_7 := [t_6, t_5]
	t_8 := [EMPTY_TYPE => INT]
	t_9 := [t_7 => t_8]
	t_10 := [t_7, t_9]
	t_11 := [t_10 => t_8]

§DEF d_0 € t_4
	r_1 := -#_Box... ARG
	r_2 := +#Result TRUE
	§RETURN r_2 IF TRUE

§DEF d_1 € t_5
	d_0 := ENV
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_9
	d_1 := §2ND ENV
	r_8 := §1ST ENV
	d_0 := §2ND r_8
	r_9 := §1ST r_8
	§RETURN ARG IF_NOT_EMPTY
	r_1 := 7
	r_2 := +#_Box... r_1
	r_3 := .d_1 d_0
	r_4 := .r_3 r_2
	r_5 := -#Result r_4
	r_6 := 1
	§RETURN r_6 IF r_5
	r_7 := 0
	§RETURN r_7 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_11
	d_2 := §2ND ENV
	r_6 := §1ST ENV
	d_1 := §2ND r_6
	r_7 := §1ST r_6
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_2 := EMPTY, d_0
	r_3 := r_2, d_1
	r_4 := .d_2 r_3
	r_5 := .r_4 EMPTY
	r_1 := r_5
	§RETURN r_1 IF TRUE
