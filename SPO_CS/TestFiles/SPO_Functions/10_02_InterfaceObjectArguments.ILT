	t_21 := [#_...+... t_13]
	t_22 := [{EMPTY_TYPE} + t_21]
	t_23 := [#_...-... t_13]
	t_24 := [{t_22} + t_23]
	t_25 := [EMPTY_TYPE, t_3]
	t_26 := [t_25, INT]
	t_27 := [t_26, INT]
	t_28 := [t_27, INT]
	t_29 := [t_24 => t_28]
	t_30 := [t_20 => t_29]

§DEF d_0 € t_20
	_...+... := §2ND ENV
	r_26 := §1ST ENV
	_...-... := §2ND r_26
	r_27 := §1ST r_26
	_aAmount := ARG
	r_1 := §2ND OBJ
	_aBookings := r_1
	r_2 := §1ST OBJ
	r_3 := §2ND r_2
	_aTarget := r_3
	r_4 := §1ST r_2
	r_5 := §2ND r_4
	_aSource := r_5
	r_6 := §1ST r_4
	§RETURN r_6 IF_NOT_EMPTY
	r_7 := §VAR _aSource ->
	r_8 := EMPTY, r_7
	r_9 := r_8, _aAmount
	r_10 := ._...-... r_9
	§VAR _aSource <- r_10
	r_11 := §VAR _aTarget ->
	r_12 := EMPTY, r_11
	r_13 := r_12, _aAmount
	r_14 := ._...+... r_13
	§VAR _aTarget <- r_14
	r_15 := §VAR _aBookings ->
	r_16 := EMPTY, r_15
	r_17 := 1
	r_18 := r_16, r_17
	r_19 := ._...+... r_18
	§VAR _aBookings <- r_19
	r_20 := §VAR _aSource ->
	r_21 := EMPTY, r_20
	r_22 := §VAR _aTarget ->
	r_23 := r_21, r_22
	r_24 := §VAR _aBookings ->
	r_25 := r_23, r_24
	§RETURN r_25 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_1 € t_30
	d_0 := ENV
	r_1 := {ARG} #_...+...
	_...+... := r_1
	r_2 := {ARG} #_...-...
	_...-... := r_2
	_iAccount := t_12
	r_3 := EMPTY, _...-...
	r_4 := r_3, _...+...
	r_5 := §CLOSURE d_0 r_4
	_Transfer... := r_5
	r_6 := 100
	_Source := §VAR r_6
	r_7 := 10
	_Target := §VAR r_7
	r_8 := 0
	_Bookings := §VAR r_8
	r_9 := +#_Transfer... _Transfer...
	r_10 := {EMPTY} + r_9
	r_11 := _Source, r_10
	r_12 := §INTERFACE t_12 WITH r_11
	r_13 := §INTERFACE_VIEW t_12 WITH r_12
	_Account := r_13
	r_14 := EMPTY, _Account
	r_15 := r_14, _Target
	r_16 := r_15, _Bookings
	r_17 := 20
	r_18 := +#_Transfer... EMPTY
	r_20 := r_16, r_18
	r_19 := §OBJ:r_20 r_17
	_Result := r_19
	r_21 := EMPTY, _Result
	r_22 := §VAR _Source ->
	r_23 := r_21, r_22
	r_24 := §VAR _Target ->
	r_25 := r_23, r_24
	r_26 := §VAR _Bookings ->
	r_27 := r_25, r_26
	§RETURN r_27 IF TRUE
