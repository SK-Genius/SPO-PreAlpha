§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [EMPTY_TYPE, INT]
	t_2 := [t_1, INT]
	t_3 := [t_2, INT]
	t_4 := [INT => t_3]
	t_5 := [EMPTY_TYPE, t_0]
	t_6 := [§VAR INT]
	t_7 := [t_5, t_6]
	t_8 := [t_7, t_6]
	t_9 := [t_8 : t_4]
	t_10 := [#_Transfer... t_9]
	t_11 := [{EMPTY_TYPE} + t_10]
	t_12 := [§ANY t_0 => t_11]
	t_13 := [t_2 => INT]
	t_14 := [EMPTY_TYPE, t_13]
	t_15 := [t_14, t_13]
	t_16 := [EMPTY_TYPE, t_6]
	t_17 := [t_16, t_6]
	t_18 := [t_17, t_6]
