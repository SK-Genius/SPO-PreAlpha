§TYPES
	t_0 := [§VAR INT]
	t_1 := [t_0 => t_0]
	t_2 := [t_0 : t_1]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [t_2 => t_2]
	t_5 := [EMPTY_TYPE, t_3]
	t_6 := [t_5, t_4]
	t_7 := [EMPTY_TYPE => INT]
	t_8 := [t_6 => t_7]

§DEF d_0 € t_3
	_aValue := ARG
	_aSelf := OBJ
	§RETURN _aValue IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_1 € t_4
	_Relay... := ENV
	_aValue := ARG
	_aSelf := OBJ
	r_2 := _aSelf, _Relay...
	r_1 := §OBJ:r_2 _aValue
	_Returned := r_1
	§RETURN _Returned IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_8
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	§RETURN ARG IF_NOT_EMPTY
	r_1 := §CLOSURE d_0 EMPTY
	_Relay... := r_1
	r_2 := §CLOSURE d_1 _Relay...
	_Forward... := r_2
	r_3 := 7
	_Cell := §VAR r_3
	r_5 := _Cell, _Forward...
	r_4 := §OBJ:r_5 _Cell
	_Returned := r_4
	r_6 := §VAR _Returned ->
	§RETURN r_6 IF TRUE
