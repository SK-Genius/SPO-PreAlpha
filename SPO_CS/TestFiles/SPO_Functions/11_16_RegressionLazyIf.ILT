§TYPES
	t_0 := [TRUE | FALSE]
	t_1 := [EMPTY_TYPE, EMPTY_TYPE]
	t_2 := [EMPTY_TYPE | INT]
	t_3 := [#Result t_2]
	t_4 := [EMPTY_TYPE | t_3]
	t_5 := [t_1 => t_4]
	t_6 := [§VAR INT]
	t_7 := [t_6 : t_5]
	t_8 := [t_0 => t_7]
	t_9 := [EMPTY_TYPE => t_7]
	t_10 := [EMPTY_TYPE, t_0]
	t_11 := [t_10, t_8]
	t_12 := [t_11, t_9]
	t_13 := [t_1 => t_3]
	t_14 := [t_6 : t_13]
	t_15 := [t_12 => t_14]
	t_16 := [EMPTY_TYPE, t_8]
	t_17 := [t_16, t_9]
	t_18 := [t_17, t_15]
	t_19 := [t_0 => t_2]
	t_20 := [t_6 : t_19]
	t_21 := [t_18 => t_20]
	t_22 := [t_18, t_21]
	t_23 := [EMPTY_TYPE, INT]
	t_24 := [t_23, t_2]
	t_25 := [t_24, INT]
	t_26 := [t_25, t_2]
	t_27 := [EMPTY_TYPE => t_26]
	t_28 := [t_22 => t_27]

§DEF d_0 € t_8
	_aChoose := ENV
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	_aSelf := OBJ
	r_1 := §BOOL _aChoose ^ TRUE
	§RETURN EMPTY IF r_1
	r_2 := 7
	§VAR _aSelf <- r_2
	r_3 := +#Result EMPTY
	§RETURN r_3 IF TRUE

§DEF d_1 € t_9
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	_aSelf := OBJ
	r_1 := §BOOL TRUE ^ TRUE
	§RETURN EMPTY IF r_1
	r_2 := §VAR _aSelf ->
	r_3 := +#Result r_2
	§RETURN r_3 IF TRUE

§DEF d_2 € t_15
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	_aChoose := §2ND r_8
	r_9 := §1ST r_8
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	_aSelf := OBJ
	r_1 := §CLOSURE d_0 _aChoose
	r_2 := EMPTY, EMPTY
	§TRY_RETURN .r_1 r_2
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, EMPTY
	§TRY_RETURN .r_3 r_4
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_21
	d_2 := §2ND ENV
	r_9 := §1ST ENV
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	_aChoose := ARG
	_aSelf := OBJ
	r_1 := EMPTY, _aChoose
	r_2 := r_1, d_0
	r_3 := r_2, d_1
	r_4 := §CLOSURE d_2 r_3
	r_5 := EMPTY, EMPTY
	r_6 := OBJ, r_4
	r_7 := §OBJ:r_6 r_5
	r_8 := -#Result r_7
	§RETURN r_8 IF TRUE

§DEF d_4 € t_28
	d_3 := §2ND ENV
	r_17 := §1ST ENV
	d_2 := §2ND r_17
	r_18 := §1ST r_17
	d_1 := §2ND r_18
	r_19 := §1ST r_18
	d_0 := §2ND r_19
	r_20 := §1ST r_19
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := §CLOSURE d_3 r_3
	_Select... := r_4
	r_5 := 0
	_FalseCase := §VAR r_5
	r_7 := _FalseCase, _Select...
	r_6 := §OBJ:r_7 FALSE
	_FalseResult := r_6
	r_8 := 0
	_TrueCase := §VAR r_8
	r_10 := _TrueCase, _Select...
	r_9 := §OBJ:r_10 TRUE
	_TrueResult := r_9
	r_11 := §VAR _FalseCase ->
	r_12 := EMPTY, r_11
	r_13 := r_12, _FalseResult
	r_14 := §VAR _TrueCase ->
	r_15 := r_13, r_14
	r_16 := r_15, _TrueResult
	§RETURN r_16 IF TRUE
