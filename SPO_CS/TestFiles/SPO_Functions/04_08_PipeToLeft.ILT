§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [#_...+... t_2]
	t_4 := [{EMPTY_TYPE} + t_3]
	t_5 := [t_4 => INT]
	t_6 := [EMPTY_TYPE => t_5]

§DEF d_0 € t_6
	r_1 := {ARG} #_...+...
	r_2 := §WITH_TYPE t_2 WITH r_1
	_...+... := r_2
	r_3 := 1
	r_4 := EMPTY, r_3
	r_5 := 2
	r_6 := EMPTY, r_5
	r_7 := 3
	r_8 := EMPTY, r_7
	r_9 := 4
	r_10 := r_8, r_9
	r_11 := ._...+... r_10
	r_12 := r_6, r_11
	r_13 := ._...+... r_12
	r_14 := r_4, r_13
	r_15 := ._...+... r_14
	_X := r_15
	§RETURN _X IF TRUE
