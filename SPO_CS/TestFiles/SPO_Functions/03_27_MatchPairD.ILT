§TYPES
	t_0 := [EMPTY_TYPE, EMPTY_TYPE]
	t_1 := [t_0, INT]
	t_2 := [EMPTY_TYPE, t_1]
	t_3 := [TRUE | FALSE]
	t_4 := [#Result t_3]
	t_5 := [t_2 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [t_6 => t_5]
	t_8 := [EMPTY_TYPE, t_6]
	t_9 := [t_8, t_7]
	t_10 := [t_0 => INT]
	t_11 := [t_9 => t_10]
	t_12 := [t_9, t_11]
	t_13 := [EMPTY_TYPE => INT]
	t_14 := [t_12 => t_13]

§DEF d_0 € t_6
	r_7 := §1ST ARG
	r_6 := §2ND ARG
	r_1 := §1ST r_6
	r_2 := §2ND r_6
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := +#Result TRUE
	§RETURN r_5 IF TRUE

§DEF d_1 € t_7
	d_0 := ENV
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_3
	§TRY_RETURN .r_1 r_2
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_11
	d_1 := §2ND ENV
	r_13 := §1ST ENV
	d_0 := §2ND r_13
	r_14 := §1ST r_13
	r_12 := §1ST ARG
	r_11 := §2ND ARG
	r_1 := EMPTY, EMPTY
	r_2 := 7
	r_3 := r_1, r_2
	r_4 := §CLOSURE d_1 d_0
	r_5 := EMPTY, r_3
	r_6 := OBJ, r_4
	r_7 := §OBJ:r_6 r_5
	r_8 := -#Result r_7
	r_9 := 1
	§RETURN r_9 IF r_8
	r_10 := 0
	§RETURN r_10 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_14
	d_2 := §2ND ENV
	r_8 := §1ST ENV
	d_1 := §2ND r_8
	r_9 := §1ST r_8
	d_0 := §2ND r_9
	r_10 := §1ST r_9
	r_2 := EMPTY, d_0
	r_3 := r_2, d_1
	r_4 := §CLOSURE d_2 r_3
	r_5 := EMPTY, EMPTY
	r_6 := OBJ, r_4
	r_7 := §OBJ:r_6 r_5
	r_1 := r_7
	§RETURN r_1 IF TRUE
