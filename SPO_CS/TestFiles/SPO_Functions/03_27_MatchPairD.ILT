§TYPES
	t_0 := [EMPTY_TYPE, EMPTY_TYPE]
	t_1 := [t_0, INT]
	t_2 := [EMPTY_TYPE, t_1]
	t_3 := [TRUE | FALSE]
	t_4 := [#Result t_3]
	t_5 := [t_2 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [t_6 => t_5]
	t_8 := [EMPTY_TYPE, t_6]
	t_9 := [t_8, t_7]
	t_10 := [#Result INT]
	t_11 := [EMPTY_TYPE | t_10]
	t_12 := [t_0 => t_11]
	t_13 := [t_9 => t_12]
	t_14 := [EMPTY_TYPE => t_12]
	t_15 := [t_9, t_13]
	t_16 := [t_15, t_14]
	t_17 := [t_0 => t_10]
	t_18 := [t_16 => t_17]
	t_19 := [t_16, t_18]
	t_20 := [EMPTY_TYPE => INT]
	t_21 := [t_19 => t_20]

§DEF d_0 € t_6
	r_7 := §1ST ARG
	r_6 := §2ND ARG
	r_1 := §1ST r_6
	r_2 := §2ND r_6
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := +#Result TRUE
	§RETURN r_5 IF TRUE

§DEF d_1 € t_7
	d_0 := ENV
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_3
	§TRY_RETURN .r_1 r_2
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_13
	d_1 := §2ND ENV
	r_14 := §1ST ENV
	d_0 := §2ND r_14
	r_15 := §1ST r_14
	r_13 := §1ST ARG
	r_12 := §2ND ARG
	r_1 := EMPTY, EMPTY
	r_2 := 7
	r_3 := r_1, r_2
	r_4 := §CLOSURE d_1 d_0
	r_5 := EMPTY, r_3
	r_6 := OBJ, r_4
	r_7 := §OBJ:r_6 r_5
	r_8 := -#Result r_7
	r_9 := §BOOL r_8 ^ TRUE
	§RETURN EMPTY IF r_9
	r_10 := 1
	r_11 := +#Result r_10
	§RETURN r_11 IF TRUE

§DEF d_3 € t_14
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	r_1 := §BOOL TRUE ^ TRUE
	§RETURN EMPTY IF r_1
	r_2 := 0
	r_3 := +#Result r_2
	§RETURN r_3 IF TRUE

§DEF d_4 € t_18
	d_3 := §2ND ENV
	r_9 := §1ST ENV
	d_2 := §2ND r_9
	r_10 := §1ST r_9
	d_1 := §2ND r_10
	r_11 := §1ST r_10
	d_0 := §2ND r_11
	r_12 := §1ST r_11
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := §CLOSURE d_2 r_2
	r_4 := EMPTY, EMPTY
	§TRY_RETURN .r_3 r_4
	r_5 := §CLOSURE d_3 EMPTY
	r_6 := EMPTY, EMPTY
	§TRY_RETURN .r_5 r_6
	§RETURN EMPTY IF TRUE

§DEF d_5 € t_21
	d_4 := §2ND ENV
	r_10 := §1ST ENV
	d_3 := §2ND r_10
	r_11 := §1ST r_10
	d_2 := §2ND r_11
	r_12 := §1ST r_11
	d_1 := §2ND r_12
	r_13 := §1ST r_12
	d_0 := §2ND r_13
	r_14 := §1ST r_13
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := r_3, d_3
	r_5 := §CLOSURE d_4 r_4
	r_6 := EMPTY, EMPTY
	r_7 := OBJ, r_5
	r_8 := §OBJ:r_7 r_6
	r_9 := -#Result r_8
	§RETURN r_9 IF TRUE
