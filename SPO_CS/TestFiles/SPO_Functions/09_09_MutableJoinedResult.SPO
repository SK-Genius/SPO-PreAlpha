§DEF OpaqueJoinTransport... = (
	§VAR aSelf € §INT
) : (
	§DEF aOpaque € [§VAR §INT]
	§DEF aFlag € §BOOL
) {
	§DEF Result = §IF {
		aFlag: aSelf
		§TRUE: aOpaque
	}
	
	§RETURN Result
}

§VAR Opaque := 9 .

§VAR Receiver01 :
	= 7
	OpaqueJoinTransport (Opaque, §TRUE) => §DEF Result01
.

§VAR Receiver02 :
	= 7
	OpaqueJoinTransport (Opaque, §FALSE) => §DEF Result02
.

§EXPORT (§TO_VAL Result01, §TO_VAL Result02)