§DEF Create = () => {Value: 7}

§DEF Fixture... = (
	§DEF aValue € [§VAR §INT]
) => {
	§DEF Record = {Handle: aValue, Number: 7}
	§DEF Narrow € [< Number: §INT >] = Record
	
	§DEF Pass... = (
		§DEF aRecord € [< Number: §INT >]
	) => aRecord
	
	§DEF Result = .Pass Narrow
	
	§DEF Observe = (
		§DEF aRecord € [< Number: §INT >]
	) : (
	) => 0
	
	Result : Observe .
	
	§RETURN Result
}

§VAR Cell := 7 .
§DEF Reduced = .Fixture Cell
§DEF Erased € §ANY = Reduced

§EXPORT (
	.Create
	Reduced
	§IF Erased MATCH {
		{Handle: §DEF Hidden}: §TRUE
		_: §FALSE
	}
	§IF Erased MATCH {
		{Number: §DEF Number}: §TRUE
		_: §FALSE
	}
)