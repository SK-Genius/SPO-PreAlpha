§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [EMPTY_TYPE | t_0]
	t_2 := [§ALL t_0 => t_1]
	t_3 := [TYPE => TYPE]
	t_4 := [EMPTY_TYPE | INT]
	t_5 := [EMPTY_TYPE, t_4]
	t_6 := [t_5, t_4]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE => t_7]

§DEF d_0 € t_8
	r_1 := §WITH_TYPE t_3 WITH t_2
	_tMaybe... := r_1
	r_2 := §WITH_TYPE t_4 WITH EMPTY
	_X := r_2
	r_3 := 1
	r_4 := §WITH_TYPE t_4 WITH r_3
	_Y := r_4
	r_5 := EMPTY, _X
	r_6 := r_5, _Y
	§RETURN r_6 IF TRUE
