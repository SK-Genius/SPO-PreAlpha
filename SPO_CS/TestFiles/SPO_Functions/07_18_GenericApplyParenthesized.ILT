§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [EMPTY_TYPE | t_0]
	t_2 := [§ALL t_0 => t_1]
	t_3 := [TYPE => TYPE]
	t_4 := [EMPTY_TYPE | INT]
	t_5 := [EMPTY_TYPE, t_4]
	t_6 := [t_5, t_4]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE => t_7]

§DEF d_0 € t_8
	r_1 := §WITH_TYPE t_3 WITH t_2
	_tMaybe... := r_1
	_X := EMPTY
	r_2 := 1
	_Y := r_2
	r_3 := EMPTY, _X
	r_4 := r_3, _Y
	§RETURN r_4 IF TRUE
