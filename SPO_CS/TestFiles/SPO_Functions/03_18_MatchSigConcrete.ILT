§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [§SIG_WITH t_0 IN t_0]
	t_2 := [TRUE | FALSE]
	t_3 := [EMPTY_TYPE, t_1]
	t_4 := [t_2 | INT]
	t_5 := [#Result t_4]
	t_6 := [t_3 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [t_3 => t_2]
	t_9 := [EMPTY_TYPE => t_8]
	t_10 := [§ABSTRACT TYPE]
	t_11 := [EMPTY_TYPE, t_7]
	t_12 := [t_11, t_9]
	t_13 := [t_12, t_7]
	t_14 := [t_13, t_9]
	t_15 := [t_14, t_7]
	t_16 := [t_15 => t_6]
	t_17 := [t_15, t_16]
	t_18 := [EMPTY_TYPE => t_4]
	t_19 := [t_17 => t_18]

§DEF d_0 € t_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §TRY r_5 HAS_HEAD_TYPE t_2
	r_2 := §SIG_HEAD r_1
	r_3 := §SIG_BODY r_1
	_Value := r_3
	r_4 := +#Result _Value
	§RETURN r_4 IF TRUE

§DEF d_1 € t_9
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	r_1 := §TRY r_4 HAS_HEAD_TYPE t_2
	r_2 := §SIG_HEAD r_1
	r_3 := §SIG_BODY r_1
	_Value := r_3
	§RETURN TRUE IF TRUE

§DEF d_2 € t_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §TRY r_5 HAS_HEAD_TYPE INT_TYPE
	r_2 := §SIG_HEAD r_1
	r_3 := §SIG_BODY r_1
	_Value := r_3
	r_4 := +#Result _Value
	§RETURN r_4 IF TRUE

§DEF d_3 € t_9
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	r_1 := §TRY r_4 HAS_HEAD_TYPE INT_TYPE
	r_2 := §SIG_HEAD r_1
	r_3 := §SIG_BODY r_1
	_Value := r_3
	§RETURN TRUE IF TRUE

§DEF d_4 € t_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §SIG_HEAD r_5 AS t_10
	r_2 := §SIG_BODY r_5
	r_3 := 0
	r_4 := +#Result r_3
	§RETURN r_4 IF TRUE

§DEF d_5 € t_16
	d_4 := §2ND ENV
	r_13 := §1ST ENV
	d_3 := §2ND r_13
	r_14 := §1ST r_13
	d_2 := §2ND r_14
	r_15 := §1ST r_14
	d_1 := §2ND r_15
	r_16 := §1ST r_15
	d_0 := §2ND r_16
	r_17 := §1ST r_16
	r_12 := §1ST ARG
	r_11 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_11
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_11
	§TRY_RETURN .r_1 r_2 IF r_3
	r_5 := §CLOSURE d_2 EMPTY
	r_6 := EMPTY, r_11
	r_7 := §CLOSURE d_3 EMPTY
	r_8 := EMPTY, r_11
	§TRY_RETURN .r_5 r_6 IF r_7
	r_9 := §CLOSURE d_4 EMPTY
	r_10 := EMPTY, r_11
	§TRY_RETURN .r_9 r_10
	§RETURN EMPTY IF TRUE

§DEF d_6 € t_19
	d_5 := §2ND ENV
	r_14 := §1ST ENV
	d_4 := §2ND r_14
	r_15 := §1ST r_14
	d_3 := §2ND r_15
	r_16 := §1ST r_15
	d_2 := §2ND r_16
	r_17 := §1ST r_16
	d_1 := §2ND r_17
	r_18 := §1ST r_17
	d_0 := §2ND r_18
	r_19 := §1ST r_18
	_Contract := t_1
	_tBool := t_2
	r_1 := 1
	r_2 := INT_TYPE, r_1
	r_3 := §SIG t_1 WITH r_2
	r_4 := EMPTY, d_0
	r_5 := r_4, d_1
	r_6 := r_5, d_2
	r_7 := r_6, d_3
	r_8 := r_7, d_4
	r_9 := §CLOSURE d_5 r_8
	r_10 := EMPTY, r_3
	r_11 := OBJ, r_9
	r_12 := §OBJ:r_11 r_10
	r_13 := -#Result r_12
	§RETURN r_13 IF TRUE
