§TYPES
	t_0 := [TRUE | FALSE]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [t_1, t_0]
	t_3 := [t_2 => t_0]
	t_4 := [#_...And... t_3]
	t_5 := [{EMPTY_TYPE} + t_4]
	t_6 := [t_2, t_0]
	t_7 := [t_6, t_0]
	t_8 := [t_5 => t_7]
	t_9 := [EMPTY_TYPE => t_8]

§DEF d_0 € t_9
	r_1 := {ARG} #_...And...
	r_2 := §WITH_TYPE t_3 WITH r_1
	_...And... := r_2
	r_3 := EMPTY, FALSE
	r_4 := r_3, FALSE
	r_5 := ._...And... r_4
	r_6 := EMPTY, r_5
	r_7 := EMPTY, FALSE
	r_8 := r_7, TRUE
	r_9 := ._...And... r_8
	r_10 := r_6, r_9
	r_11 := EMPTY, TRUE
	r_12 := r_11, FALSE
	r_13 := ._...And... r_12
	r_14 := r_10, r_13
	r_15 := EMPTY, TRUE
	r_16 := r_15, TRUE
	r_17 := ._...And... r_16
	r_18 := r_14, r_17
	§RETURN r_18 IF TRUE
