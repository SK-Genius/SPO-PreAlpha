§TYPES
	t_0 := [TRUE | FALSE]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [t_1, t_0]
	t_3 := [t_2 => t_0]
	t_4 := [#_...And... t_3]
	t_5 := [{EMPTY_TYPE} + t_4]
	t_6 := [t_2, t_0]
	t_7 := [t_6, t_0]
	t_8 := [t_5 => t_7]
	t_9 := [EMPTY_TYPE => t_8]

§DEF d_0 € t_9
	r_1 := {ARG} #_...And...
	_...And... := r_1
	r_2 := EMPTY, FALSE
	r_3 := r_2, FALSE
	r_4 := ._...And... r_3
	r_5 := EMPTY, r_4
	r_6 := EMPTY, FALSE
	r_7 := r_6, TRUE
	r_8 := ._...And... r_7
	r_9 := r_5, r_8
	r_10 := EMPTY, TRUE
	r_11 := r_10, FALSE
	r_12 := ._...And... r_11
	r_13 := r_9, r_12
	r_14 := EMPTY, TRUE
	r_15 := r_14, TRUE
	r_16 := ._...And... r_15
	r_17 := r_13, r_16
	§RETURN r_17 IF TRUE
