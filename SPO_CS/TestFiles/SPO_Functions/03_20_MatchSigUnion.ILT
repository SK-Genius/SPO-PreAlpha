§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [§SIG_WITH t_0 IN t_0]
	t_2 := [§ABSTRACT TYPE]
	t_3 := [#Result INT]
	t_4 := [t_1 => t_3]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [§FREE TYPE]
	t_7 := [EMPTY_TYPE, t_6]
	t_8 := [t_7, t_6]
	t_9 := [§SIG_WITH t_6 IN t_8]
	t_10 := [t_9 | INT]
	t_11 := [t_10 => t_3]
	t_12 := [EMPTY_TYPE => t_11]
	t_13 := [EMPTY_TYPE, t_5]
	t_14 := [t_13, t_12]
	t_15 := [t_10 | t_1]
	t_16 := [t_15 => t_3]
	t_17 := [t_14 => t_16]
	t_18 := [t_14, t_17]
	t_19 := [EMPTY_TYPE => INT]
	t_20 := [t_18 => t_19]

§DEF d_0 € t_5
	r_1 := §SIG_HEAD ARG AS t_2
	r_2 := §SIG_BODY ARG
	_Body := r_2
	r_3 := 1
	r_4 := +#Result r_3
	§RETURN r_4 IF TRUE

§DEF d_1 € t_12
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_2 € t_17
	d_1 := §2ND ENV
	r_3 := §1ST ENV
	d_0 := §2ND r_3
	r_4 := §1ST r_3
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_2 ARG
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_20
	d_2 := §2ND ENV
	r_9 := §1ST ENV
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	_Contract := t_1
	r_1 := 7
	r_2 := INT_TYPE, r_1
	r_3 := §SIG t_1 WITH r_2
	_Value := r_3
	r_4 := EMPTY, d_0
	r_5 := r_4, d_1
	r_6 := .d_2 r_5
	r_7 := .r_6 _Value
	r_8 := -#Result r_7
	§RETURN r_8 IF TRUE
