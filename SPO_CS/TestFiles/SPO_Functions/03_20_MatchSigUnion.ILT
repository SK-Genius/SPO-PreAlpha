§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [§SIG_WITH t_0 IN t_0]
	t_2 := [§ABSTRACT TYPE]
	t_3 := [EMPTY_TYPE, t_1]
	t_4 := [#Result INT]
	t_5 := [t_3 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [§FREE TYPE]
	t_8 := [EMPTY_TYPE, t_7]
	t_9 := [t_8, t_7]
	t_10 := [§SIG_WITH t_7 IN t_9]
	t_11 := [t_10 | INT]
	t_12 := [EMPTY_TYPE, t_11]
	t_13 := [t_12 => t_4]
	t_14 := [EMPTY_TYPE => t_13]
	t_15 := [EMPTY_TYPE, t_6]
	t_16 := [t_15, t_14]
	t_17 := [t_11 | t_1]
	t_18 := [EMPTY_TYPE, t_17]
	t_19 := [t_18 => t_4]
	t_20 := [t_16 => t_19]
	t_21 := [t_16, t_20]
	t_22 := [EMPTY_TYPE => INT]
	t_23 := [t_21 => t_22]

§DEF d_0 € t_6
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §SIG_HEAD r_5 AS t_2
	r_2 := §SIG_BODY r_5
	_Body := r_2
	r_3 := 1
	r_4 := +#Result r_3
	§RETURN r_4 IF TRUE

§DEF d_1 € t_14
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_2 € t_20
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_5
	§TRY_RETURN .r_1 r_2
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_5
	§TRY_RETURN .r_3 r_4
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_23
	d_2 := §2ND ENV
	r_11 := §1ST ENV
	d_1 := §2ND r_11
	r_12 := §1ST r_11
	d_0 := §2ND r_12
	r_13 := §1ST r_12
	_Contract := t_1
	r_1 := 7
	r_2 := INT_TYPE, r_1
	r_3 := §SIG t_1 WITH r_2
	_Value := r_3
	r_4 := EMPTY, d_0
	r_5 := r_4, d_1
	r_6 := §CLOSURE d_2 r_5
	r_7 := EMPTY, _Value
	r_8 := OBJ, r_6
	r_9 := §OBJ:r_8 r_7
	r_10 := -#Result r_9
	§RETURN r_10 IF TRUE
