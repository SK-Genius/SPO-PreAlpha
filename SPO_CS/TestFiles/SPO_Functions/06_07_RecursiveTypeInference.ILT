§TYPES
	t_0 := [EMPTY_TYPE, TRUE]
	t_1 := [EMPTY_TYPE, INT]
	t_2 := [t_1, INT]
	t_3 := [#Result t_2]
	t_4 := [t_0 => t_3]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [TRUE | FALSE]
	t_7 := [t_6 => t_2]
	t_8 := [EMPTY_TYPE, FALSE]
	t_9 := [t_8 => t_3]
	t_10 := [t_7 => t_9]
	t_11 := [EMPTY_TYPE, t_5]
	t_12 := [t_11, t_7]
	t_13 := [t_12, t_10]
	t_14 := [EMPTY_TYPE, t_6]
	t_15 := [t_14 => t_3]
	t_16 := [t_13 => t_15]
	t_17 := [t_13, t_16]
	t_18 := [t_17 => t_7]
	t_19 := [t_11, t_10]
	t_20 := [t_19, t_16]
	t_21 := [t_20, t_18]
	t_22 := [t_7 => t_7]
	t_23 := [t_21 => t_22]
	t_24 := [t_21, t_23]
	t_25 := [EMPTY_TYPE => INT]
	t_26 := [t_24 => t_25]

§DEF d_0 € t_5
	r_7 := §1ST ARG
	r_6 := §2ND ARG
	r_1 := 1
	r_2 := EMPTY, r_1
	r_3 := 2
	r_4 := r_2, r_3
	r_5 := +#Result r_4
	§RETURN r_5 IF TRUE

§DEF d_1 € t_10
	_Position... := ENV
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := ._Position... TRUE
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_2 € t_16
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	_Position... := §2ND r_7
	r_8 := §1ST r_7
	d_0 := §2ND r_8
	r_9 := §1ST r_8
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_5
	§TRY_RETURN .r_1 r_2
	r_3 := §CLOSURE d_1 _Position...
	r_4 := EMPTY, r_5
	§TRY_RETURN .r_3 r_4
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_18
	d_2 := §2ND ENV
	r_9 := §1ST ENV
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	_Position... := §2ND r_10
	r_11 := §1ST r_10
	d_0 := §2ND r_11
	r_12 := §1ST r_11
	_aAtEnd := ARG
	r_1 := EMPTY, d_0
	r_2 := r_1, _Position...
	r_3 := r_2, d_1
	r_4 := §CLOSURE d_2 r_3
	r_5 := EMPTY, _aAtEnd
	r_6 := OBJ, r_4
	r_7 := §OBJ:r_6 r_5
	r_8 := -#Result r_7
	§RETURN r_8 IF TRUE

§DEF d_4 € t_23
	d_3 := §2ND ENV
	r_6 := §1ST ENV
	d_2 := §2ND r_6
	r_7 := §1ST r_6
	d_1 := §2ND r_7
	r_8 := §1ST r_7
	d_0 := §2ND r_8
	r_9 := §1ST r_8
	_Position... := ARG
	r_1 := EMPTY, d_0
	r_2 := r_1, _Position...
	r_3 := r_2, d_1
	r_4 := r_3, d_2
	r_5 := §CLOSURE d_3 r_4
	§RETURN r_5 IF TRUE

§DEF d_5 € t_26
	d_4 := §2ND ENV
	r_11 := §1ST ENV
	d_3 := §2ND r_11
	r_12 := §1ST r_11
	d_2 := §2ND r_12
	r_13 := §1ST r_12
	d_1 := §2ND r_13
	r_14 := §1ST r_13
	d_0 := §2ND r_14
	r_15 := §1ST r_14
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := r_3, d_3
	§REC r_5 := .d_4 r_4
	_Position... := r_5
	r_6 := ._Position... FALSE
	r_7 := §2ND r_6
	_cY := r_7
	r_8 := §1ST r_6
	r_9 := §2ND r_8
	_cX := r_9
	r_10 := §1ST r_8
	§RETURN _cX IF TRUE
