§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [INT => EMPTY_TYPE]
	t_4 := [§VAR INT]
	t_5 := [t_4 : t_3]
	t_6 := [t_2 => t_5]
	t_7 := [#_...+... t_2]
	t_8 := [{EMPTY_TYPE} + t_7]
	t_9 := [t_8 => t_1]
	t_10 := [t_6 => t_9]

§DEF d_0 € t_6
	_...+... := ENV
	_a := ARG
	_o := OBJ
	r_1 := §VAR _o ->
	r_2 := EMPTY, r_1
	r_3 := r_2, _a
	r_4 := ._...+... r_3
	§VAR _o <- r_4
	§RETURN EMPTY IF TRUE

§DEF d_1 € t_10
	d_0 := ENV
	r_1 := {ARG} #_...+...
	r_2 := §WITH_TYPE t_2 WITH r_1
	_...+... := r_2
	r_3 := §CLOSURE d_0 _...+...
	_+... := r_3
	r_4 := 1
	_X := §VAR r_4
	r_5 := 2
	r_7 := _X, _+...
	r_6 := §OBJ:r_7 r_5
	r_8 := 3
	_Y := §VAR r_8
	r_9 := 4
	r_11 := _Y, _+...
	r_10 := §OBJ:r_11 r_9
	r_12 := §VAR _X ->
	r_13 := EMPTY, r_12
	r_14 := §VAR _Y ->
	r_15 := r_13, r_14
	§RETURN r_15 IF TRUE
