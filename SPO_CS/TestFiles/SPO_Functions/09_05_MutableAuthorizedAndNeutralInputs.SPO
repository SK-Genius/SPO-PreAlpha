§DEF ReceiverReadWriteAndForward = (
	§VAR aSelf € §INT
) : () {
	§DEF Read = (
		§VAR aTarget € §INT
	) : () => §TO_VAL aTarget
	
	aSelf :
		= 1
		Read => §DEF Value
	.
	
	§RETURN Value
}

§DEF ImmutableClosure = (
	§VAR aSelf € §INT
) : () {
	§DEF Pass... = (§DEF aValue € [§VAR §INT]) => aValue
	
	§RETURN §TO_VAL (.Pass aSelf)
}

§DEF ExplicitHandleArgument = (
	§VAR aSelf € §INT
) : () {
	§DEF Get... = (§DEF aValue € [§VAR §INT]) => aValue
	
	§RETURN §TO_VAL (.Get aSelf)
}

§DEF FreshResult = () => {
	§DEF Make... = () => {
		§VAR Cell := 7 .
		§RETURN Cell
	}
	
	§DEF Result = .Make ()
	
	§RETURN §TO_VAL Result
}

§DEF TypeDescriptor... = (
	§DEF aType € §TYPE
) => {
	§DEF Observe = (§DEF aObject € §TYPE) : () {
		§RETURN 0
	}
	aType : Observe .
	§RETURN aType
}

§DEF OpaqueFunctionTransport... = (
	§DEF aGet... € [[] => [§VAR §INT]]
) => {
	§DEF Result = .aGet ()
	§RETURN §TO_VAL Result
}

§DEF OpaqueFunctionImmutableResult... = (
	§DEF aGet... € [[] => §INT]
) => .aGet ()

§VAR Cell := 7 .
§VAR Opaque := 9 .

§DEF Make... = () => {
	§VAR Fresh := 7 .
	§RETURN Fresh
}

§DEF Number... = () => 11

§VAR Receiver01 :
	= 7
	ReceiverReadWriteAndForward => §DEF Result01
.

§VAR Receiver02 :
	= 7
	ImmutableClosure => §DEF Result02
.

§VAR Receiver03 :
	= 7
	ExplicitHandleArgument => §DEF Result03
.

§EXPORT (
	Result01
	Result02
	Result03
	.FreshResult
	.TypeDescriptor §INT
	.OpaqueFunctionTransport Make...
	.OpaqueFunctionImmutableResult Number...
)