	§RETURN _Result IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_13
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_1 := §CLOSURE d_1 d_0
	_OpaqueResultTransport... := r_1
