§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [t_0, INT]
	t_2 := [t_1 | EMPTY_TYPE]
	t_3 := [§REC t_0 => t_2]
	t_4 := [§FREE TYPE]
	t_5 := [t_4, INT]
	t_6 := [t_5 | EMPTY_TYPE]
	t_7 := [§REC t_4 => t_6]
	t_8 := [EMPTY_TYPE, t_7]
	t_9 := [t_8, INT]
	t_10 := [t_7, INT]
	t_11 := [t_9 => t_10]
	t_12 := [EMPTY_TYPE => t_11]
	t_13 := [EMPTY_TYPE => t_10]
	t_14 := [t_12 => t_13]

§DEF d_0 € t_12
	r_1 := §2ND ARG
	_aHead := r_1
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	_aTail := r_3
	r_4 := §1ST r_2
	§RETURN r_4 IF_NOT_EMPTY
	r_5 := _aTail, _aHead
	§RETURN r_5 IF TRUE

§DEF d_1 € t_14
	d_0 := ENV
	_tIntArray := t_3
	r_1 := .d_0 EMPTY
	_...Append... := r_1
	r_2 := EMPTY, EMPTY
	r_3 := 1
	r_4 := r_2, r_3
	r_5 := ._...Append... r_4
	r_6 := EMPTY, r_5
	r_7 := 2
	r_8 := r_6, r_7
	r_9 := ._...Append... r_8
	r_10 := EMPTY, r_9
	r_11 := 3
	r_12 := r_10, r_11
	r_13 := ._...Append... r_12
	§RETURN r_13 IF TRUE
