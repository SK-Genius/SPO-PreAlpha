§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [t_0, INT]
	t_2 := [t_1 | EMPTY_TYPE]
	t_3 := [§REC t_0 => t_2]
	t_4 := [§FREE TYPE]
	t_5 := [t_4, INT]
	t_6 := [t_5 | EMPTY_TYPE]
	t_7 := [§REC t_4 => t_6]
	t_8 := [EMPTY_TYPE, t_7]
	t_9 := [t_8, INT]
	t_10 := [t_7, INT]
	t_11 := [t_9 => t_10]
	t_12 := [EMPTY_TYPE => t_11]
	t_13 := [EMPTY_TYPE => t_10]
	t_14 := [t_12 => t_13]

§DEF d_0 € t_12
	r_1 := §2ND ARG
	_aHead := r_1
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	_aTail := r_3
	r_4 := §1ST r_2
	§RETURN r_4 IF_NOT_EMPTY
	r_5 := _aTail, _aHead
	§RETURN r_5 IF TRUE

§DEF d_1 € t_14
	d_0 := ENV
	r_1 := §WITH_TYPE Type_TYPE WITH t_3
	_tIntArray := r_1
	r_2 := §CLOSURE d_0 EMPTY
	_...Append... := r_2
	r_3 := EMPTY, EMPTY
	r_4 := 1
	r_5 := r_3, r_4
	r_6 := ._...Append... r_5
	r_7 := EMPTY, r_6
	r_8 := 2
	r_9 := r_7, r_8
	r_10 := ._...Append... r_9
	r_11 := EMPTY, r_10
	r_12 := 3
	r_13 := r_11, r_12
	r_14 := ._...Append... r_13
	§RETURN r_14 IF TRUE
