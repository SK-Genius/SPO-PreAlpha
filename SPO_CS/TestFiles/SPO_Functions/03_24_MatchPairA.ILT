§TYPES
	t_0 := [EMPTY_TYPE, EMPTY_TYPE]
	t_1 := [t_0, INT]
	t_2 := [EMPTY_TYPE, t_1]
	t_3 := [#Result INT]
	t_4 := [t_2 => t_3]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [t_5 => t_4]
	t_7 := [EMPTY_TYPE, t_5]
	t_8 := [t_7, t_6]
	t_9 := [EMPTY_TYPE => INT]
	t_10 := [t_8 => t_9]

§DEF d_0 € t_5
	r_7 := §1ST ARG
	r_6 := §2ND ARG
	r_1 := §1ST r_6
	r_2 := §2ND r_6
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	_Second := r_2
	r_5 := +#Result _Second
	§RETURN r_5 IF TRUE

§DEF d_1 € t_6
	d_0 := ENV
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_3
	§TRY_RETURN .r_1 r_2
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_10
	d_1 := §2ND ENV
	r_9 := §1ST ENV
	d_0 := §2ND r_9
	r_10 := §1ST r_9
	r_1 := EMPTY, EMPTY
	r_2 := 2
	r_3 := r_1, r_2
	r_4 := §CLOSURE d_1 d_0
	r_5 := EMPTY, r_3
	r_6 := OBJ, r_4
	r_7 := §OBJ:r_6 r_5
	r_8 := -#Result r_7
	§RETURN r_8 IF TRUE
