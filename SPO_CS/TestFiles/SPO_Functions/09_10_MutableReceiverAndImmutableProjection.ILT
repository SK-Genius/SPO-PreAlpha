§TYPES
	t_0 := [EMPTY_TYPE => INT]
	t_1 := [§VAR INT]
	t_2 := [t_1 : t_0]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [#_Handle t_1]
	t_5 := [{EMPTY_TYPE} + t_4]
	t_6 := [#_Number INT]
	t_7 := [{t_5} + t_6]
	t_8 := [t_7 => INT]
	t_9 := [EMPTY_TYPE => t_8]
	t_10 := [EMPTY_TYPE, t_3]
	t_11 := [t_10, t_9]
	t_12 := [EMPTY_TYPE, INT]
	t_13 := [t_12, INT]
	t_14 := [EMPTY_TYPE => t_13]
	t_15 := [t_11 => t_14]

§DEF d_0 € t_3
	§RETURN ARG IF_NOT_EMPTY
	_aSelf := OBJ
	_Current := _aSelf
	r_1 := §VAR _Current ->
	§RETURN r_1 IF TRUE

§DEF d_1 € t_9
	_aRecord := ARG
	r_1 := {_aRecord} #_Number
	_Number := r_1
	§RETURN _Number IF TRUE

§DEF d_2 € t_15
	d_1 := §2ND ENV
	r_14 := §1ST ENV
	d_0 := §2ND r_14
	r_15 := §1ST r_14
	r_1 := §CLOSURE d_0 EMPTY
	_Read := r_1
	r_2 := §CLOSURE d_1 EMPTY
	_Number... := r_2
	r_3 := 7
	_Cell := §VAR r_3
	r_5 := _Cell, _Read
	r_4 := §OBJ:r_5 EMPTY
	_Value := r_4
	r_6 := EMPTY, _Value
	r_7 := +#_Handle _Cell
	r_8 := {EMPTY} + r_7
	r_9 := 9
	r_10 := +#_Number r_9
	r_11 := {r_8} + r_10
	r_12 := ._Number... r_11
	r_13 := r_6, r_12
	§RETURN r_13 IF TRUE
