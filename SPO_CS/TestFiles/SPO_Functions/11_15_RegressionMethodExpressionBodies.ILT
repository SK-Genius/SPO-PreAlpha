§TYPES
	t_0 := [EMPTY_TYPE => INT]
	t_1 := [§VAR INT]
	t_2 := [t_1 : t_0]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [#_Self INT]
	t_5 := [{EMPTY_TYPE} + t_4]
	t_6 := [#_Value INT]
	t_7 := [{t_5} + t_6]
	t_8 := [INT => t_7]
	t_9 := [t_1 : t_8]
	t_10 := [EMPTY_TYPE => t_9]
	t_11 := [TRUE | FALSE]
	t_12 := [EMPTY_TYPE, EMPTY_TYPE]
	t_13 := [t_12 => INT]
	t_14 := [t_1 : t_13]
	t_15 := [t_11 => t_14]
	t_16 := [t_11 => INT]
	t_17 := [t_1 : t_16]
	t_18 := [t_15 => t_17]
	t_19 := [EMPTY_TYPE, t_3]
	t_20 := [t_19, t_10]
	t_21 := [t_20, t_15]
	t_22 := [t_21, t_18]
	t_23 := [t_22, t_3]
	t_24 := [EMPTY_TYPE, INT]
	t_25 := [t_24, INT]
	t_26 := [t_24, t_25]
	t_27 := [t_26, INT]
	t_28 := [t_27, INT]
	t_29 := [t_28, INT]
	t_30 := [EMPTY_TYPE => t_29]
	t_31 := [t_23 => t_30]

§DEF d_0 € t_3
	§RETURN ARG IF_NOT_EMPTY
	_aSelf := OBJ
	r_1 := §VAR _aSelf ->
	§RETURN r_1 IF TRUE

§DEF d_1 € t_10
	_aValue := ARG
	_aSelf := OBJ
	r_1 := +#_Value _aValue
	r_2 := {EMPTY} + r_1
	r_3 := §VAR _aSelf ->
	r_4 := +#_Self r_3
	r_5 := {r_2} + r_4
	§RETURN r_5 IF TRUE

§DEF d_2 € t_15
	_aFlag := ENV
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	_aSelf := OBJ
	r_1 := §VAR _aSelf ->
	§RETURN r_1 IF _aFlag
	r_2 := 0
	§RETURN r_2 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_18
	d_2 := ENV
	_aFlag := ARG
	_aSelf := OBJ
	r_2 := §CLOSURE d_2 _aFlag
	r_3 := EMPTY, EMPTY
	r_4 := OBJ, r_2
	r_5 := §OBJ:r_4 r_3
	r_1 := r_5
	§RETURN r_1 IF TRUE

§DEF d_4 € t_3
	§RETURN ARG IF_NOT_EMPTY
	_aSelf := OBJ
	r_1 := §VAR _aSelf ->
	§RETURN r_1 IF TRUE

§DEF d_5 € t_31
	d_4 := §2ND ENV
	r_26 := §1ST ENV
	d_3 := §2ND r_26
	r_27 := §1ST r_26
	d_2 := §2ND r_27
	r_28 := §1ST r_27
	d_1 := §2ND r_28
	r_29 := §1ST r_28
	d_0 := §2ND r_29
	r_30 := §1ST r_29
	r_1 := §CLOSURE d_0 EMPTY
	_Read := r_1
	r_2 := §CLOSURE d_1 EMPTY
	_Box... := r_2
	r_3 := §CLOSURE d_3 d_2
	_Select... := r_3
	r_4 := §CLOSURE d_4 EMPTY
	_ReadBlock := r_4
	r_5 := 7
	_Cell := §VAR r_5
	r_7 := _Cell, _Read
	r_6 := §OBJ:r_7 EMPTY
	_ReadValue := r_6
	r_8 := 9
	r_10 := _Cell, _Box...
	r_9 := §OBJ:r_10 r_8
	_BoxValue := r_9
	r_12 := _Cell, _Select...
	r_11 := §OBJ:r_12 TRUE
	_Selected := r_11
	r_14 := _Cell, _Select...
	r_13 := §OBJ:r_14 FALSE
	_Other := r_13
	r_16 := _Cell, _ReadBlock
	r_15 := §OBJ:r_16 EMPTY
	_BlockValue := r_15
	r_17 := {_BoxValue} #_Value
	_BoxArgument := r_17
	r_18 := {_BoxValue} #_Self
	_BoxReceiver := r_18
	r_19 := EMPTY, _ReadValue
	r_20 := EMPTY, _BoxArgument
	r_21 := r_20, _BoxReceiver
	r_22 := r_19, r_21
	r_23 := r_22, _Selected
	r_24 := r_23, _Other
	r_25 := r_24, _BlockValue
	§RETURN r_25 IF TRUE
