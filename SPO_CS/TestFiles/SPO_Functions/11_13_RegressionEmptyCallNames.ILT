§TYPES
	t_0 := [EMPTY_TYPE => INT]
	t_1 := [EMPTY_TYPE => t_0]
	t_2 := [§VAR INT]
	t_3 := [t_2 : t_0]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [EMPTY_TYPE, t_1]
	t_6 := [t_5, t_1]
	t_7 := [t_6, t_4]
	t_8 := [t_7, t_4]
	t_9 := [EMPTY_TYPE, INT]
	t_10 := [t_9, INT]
	t_11 := [t_10, INT]
	t_12 := [t_11, INT]
	t_13 := [EMPTY_TYPE => t_12]
	t_14 := [t_8 => t_13]

§DEF d_0 € t_1
	§RETURN ARG IF_NOT_EMPTY
	r_1 := 1
	§RETURN r_1 IF TRUE

§DEF d_1 € t_1
	§RETURN ARG IF_NOT_EMPTY
	r_1 := 2
	§RETURN r_1 IF TRUE

§DEF d_2 € t_4
	§RETURN ARG IF_NOT_EMPTY
	_aSelf := OBJ
	r_1 := 3
	§RETURN r_1 IF TRUE

§DEF d_3 € t_4
	§RETURN ARG IF_NOT_EMPTY
	_aSelf := OBJ
	r_1 := 4
	§RETURN r_1 IF TRUE

§DEF d_4 € t_14
	d_3 := §2ND ENV
	r_16 := §1ST ENV
	d_2 := §2ND r_16
	r_17 := §1ST r_16
	d_1 := §2ND r_17
	r_18 := §1ST r_17
	d_0 := §2ND r_18
	r_19 := §1ST r_18
	r_1 := §CLOSURE d_0 EMPTY
	_F := r_1
	r_2 := §CLOSURE d_1 EMPTY
	_F... := r_2
	r_3 := §CLOSURE d_2 EMPTY
	_M := r_3
	r_4 := §CLOSURE d_3 EMPTY
	_M... := r_4
	r_5 := 7
	_Cell := §VAR r_5
	r_7 := _Cell, _M
	r_6 := §OBJ:r_7 EMPTY
	_BareMethod := r_6
	r_9 := _Cell, _M...
	r_8 := §OBJ:r_9 EMPTY
	_ExplicitMethod := r_8
	r_10 := ._F EMPTY
	r_11 := EMPTY, r_10
	r_12 := ._F... EMPTY
	r_13 := r_11, r_12
	r_14 := r_13, _BareMethod
	r_15 := r_14, _ExplicitMethod
	§RETURN r_15 IF TRUE
