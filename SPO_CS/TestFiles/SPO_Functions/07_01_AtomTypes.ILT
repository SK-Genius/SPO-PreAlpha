§TYPES
	t_0 := [TRUE | FALSE]
	t_1 := [EMPTY_TYPE, EMPTY_TYPE]
	t_2 := [t_1, TRUE]
	t_3 := [t_2, FALSE]
	t_4 := [t_3, INT]
	t_5 := [#_Bla EMPTY_TYPE]
	t_6 := [t_4, t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE => t_7]

§DEF d_0 € t_8
	r_1 := §WITH_TYPE EMPTY_TYPE WITH EMPTY
	_A_0 := r_1
	r_2 := §WITH_TYPE t_0 WITH TRUE
	_A_1 := r_2
	r_3 := §WITH_TYPE t_0 WITH FALSE
	_A_2 := r_3
	r_4 := 0
	_A_3 := r_4
	r_5 := +#_Bla EMPTY
	_A_4 := r_5
	r_6 := EMPTY, _A_0
	r_7 := r_6, TRUE
	r_8 := r_7, FALSE
	r_9 := r_8, _A_3
	r_10 := r_9, _A_4
	§RETURN r_10 IF TRUE
