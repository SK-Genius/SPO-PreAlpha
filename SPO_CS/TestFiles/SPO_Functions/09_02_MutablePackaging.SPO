§DEF StructuredTransport... = (
	§DEF aValue € [§VAR §INT]
) => {
	(_, §DEF FromPair) = (0, aValue)
	(#Handle (§DEF FromPrefix)) = (#Handle FromPair)
	{Handle: §DEF FromRecord} = {Handle: FromPrefix, Number: 7}
	
	§RETURN FromRecord
}

§DEF GenericIdentity... = (
	§DEF aValue € [§VAR §INT]
) => {
	§DEF Pass... = §DEF t <=> (§DEF aItem € t) => aItem
	
	§RETURN .Pass aValue
}

§DEF MatchBinding... = (
	§DEF aValue € [§VAR §INT]
) => {
	§DEF Value = §IF aValue MATCH {
		§DEF Item: Item
	}
	
	§RETURN Value
}

§DEF SigPackage... = (
	§DEF aValue € [§VAR §INT]
) => {
	§DEF Contract = [§SIG_WITH t € §TYPE IN t]
	§DEF Package = §SIG Contract WITH [§VAR §INT] IN aValue
	§RETURN §IF Package MATCH {
		§SIG Contract WITH [§VAR §INT] IN §DEF Item: Item
		§SIG Contract WITH _ IN _: aValue
	}
}

§DEF NarrowRecord... = (
	§DEF aValue € [§VAR §INT]
) => {
	§DEF Narrow € [< Number: §INT >] = {Handle: aValue, Number: 7}
	§DEF Pass... = (§DEF aRecord € [< Number: §INT >]) => aRecord
	§DEF Observe = (§DEF aRecord € [< Number: §INT >]) : () {
		§RETURN 0
	}
	
	§RETURN .Pass Narrow
}

§DEF VariableWrapper... = (
	§DEF aValue € [§VAR §INT]
) => {
	§VAR Box := aValue .
	§RETURN Box
}

§DEF ImmutableReconstruction... = (
	§DEF aRecord € [< Handle: [§VAR §INT], Number: §INT >]
) => {
	{Number: §DEF Number} = aRecord
	
	§DEF Projected = {Number: Number}
	§DEF Observe = (§DEF aValue € [< Number: §INT >]) : () {
		§RETURN 0
	}
	
	Projected : Observe .
	
	§RETURN Projected
}

§VAR Cell := 7 .
§VAR Opaque := 9 .

{Number: §DEF Number} = .NarrowRecord Cell
{Number: §DEF ReconstructedNumber} = .ImmutableReconstruction {Handle: Cell, Number: 7}

§DEF Wrapped = §TO_VAL .VariableWrapper Cell

§EXPORT (
	§TO_VAL (.StructuredTransport Cell)
	§TO_VAL (.GenericIdentity Cell)
	§TO_VAL (.MatchBinding Cell)
	§TO_VAL (.SigPackage Cell)
	Number
	§TO_VAL Wrapped
	{Number: ReconstructedNumber}
)