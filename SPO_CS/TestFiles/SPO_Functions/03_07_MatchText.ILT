§TYPES
	t_0 := [#_Char... INT]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [EMPTY_TYPE, t_1]
	t_3 := [#Result INT]
	t_4 := [t_2 => t_3]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [TRUE | FALSE]
	t_7 := [t_2 => t_6]
	t_8 := [EMPTY_TYPE => t_7]
	t_9 := [EMPTY_TYPE, t_5]
	t_10 := [t_9, t_8]
	t_11 := [t_10, t_5]
	t_12 := [t_11 => t_4]
	t_13 := [t_11, t_12]
	t_14 := [EMPTY_TYPE => INT]
	t_15 := [t_13 => t_14]

§DEF d_0 € t_5
	r_7 := §1ST ARG
	r_6 := §2ND ARG
	r_1 := §1ST r_6
	r_2 := §2ND r_6
	r_3 := -#_Char... r_2
	r_4 := 1
	r_5 := +#Result r_4
	§RETURN r_5 IF TRUE

§DEF d_1 € t_8
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := §1ST r_7
	r_2 := §2ND r_7
	r_3 := -#_Char... r_2
	r_4 := 65
	r_5 := §INT r_3 == r_4
	r_6 := §BOOL r_5 ^ TRUE
	§RETURN FALSE IF r_6
	§RETURN TRUE IF TRUE

§DEF d_2 € t_5
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_3 € t_12
	d_2 := §2ND ENV
	r_9 := §1ST ENV
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_7
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_7
	§TRY_RETURN .r_1 r_2 IF r_3
	r_5 := §CLOSURE d_2 EMPTY
	r_6 := EMPTY, r_7
	§TRY_RETURN .r_5 r_6
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_15
	d_3 := §2ND ENV
	r_12 := §1ST ENV
	d_2 := §2ND r_12
	r_13 := §1ST r_12
	d_1 := §2ND r_13
	r_14 := §1ST r_13
	d_0 := §2ND r_14
	r_15 := §1ST r_14
	r_1 := 65
	r_2 := +#_Char... r_1
	r_3 := EMPTY, r_2
	r_4 := EMPTY, d_0
	r_5 := r_4, d_1
	r_6 := r_5, d_2
	r_7 := §CLOSURE d_3 r_6
	r_8 := EMPTY, r_3
	r_9 := OBJ, r_7
	r_10 := §OBJ:r_9 r_8
	r_11 := -#Result r_10
	§RETURN r_11 IF TRUE
