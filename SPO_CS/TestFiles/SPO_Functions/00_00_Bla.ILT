	t_29 := [t_23, t_28]
	t_30 := [EMPTY_TYPE => INT]
	t_31 := [t_29 => t_30]

§DEF d_0 € t_6
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := §1ST r_7
	r_2 := §2ND r_7
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := 1
	r_6 := +#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_1 € t_10
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := §1ST r_7
	r_2 := §2ND r_7
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := 2
	r_6 := +#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_2 € t_15
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := §1ST r_7
	r_2 := §2ND r_7
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := 3
	r_6 := +#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_3 € t_19
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := §1ST r_7
	r_2 := §2ND r_7
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := 4
	r_6 := +#Result r_5
	§RETURN r_6 IF TRUE

§DEF d_4 € t_28
	d_3 := §2ND ENV
	r_11 := §1ST ENV
	d_2 := §2ND r_11
	r_12 := §1ST r_11
	d_1 := §2ND r_12
	r_13 := §1ST r_12
	d_0 := §2ND r_13
	r_14 := §1ST r_13
	r_10 := §1ST ARG
	r_9 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_9
	§TRY_RETURN .r_1 r_2
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_9
	§TRY_RETURN .r_3 r_4
	r_5 := §CLOSURE d_2 EMPTY
	r_6 := EMPTY, r_9
	§TRY_RETURN .r_5 r_6
	r_7 := §CLOSURE d_3 EMPTY
	r_8 := EMPTY, r_9
	§TRY_RETURN .r_7 r_8
	§RETURN EMPTY IF TRUE

§DEF d_5 € t_31
	d_4 := §2ND ENV
	r_16 := §1ST ENV
	d_3 := §2ND r_16
	r_17 := §1ST r_16
	d_2 := §2ND r_17
	r_18 := §1ST r_17
	d_1 := §2ND r_18
	r_19 := §1ST r_18
	d_0 := §2ND r_19
	r_20 := §1ST r_19
	r_1 := 1
	r_2 := §WITH_TYPE t_0 WITH r_1
	_X := r_2
	r_3 := 2
	r_4 := §WITH_TYPE t_0 WITH r_3
	_Y := r_4
	r_5 := EMPTY, _X
	r_6 := r_5, _Y
	r_7 := EMPTY, d_0
	r_8 := r_7, d_1
	r_9 := r_8, d_2
	r_10 := r_9, d_3
	r_11 := §CLOSURE d_4 r_10
	r_12 := EMPTY, r_6
	r_13 := OBJ, r_11
	r_14 := §OBJ:r_13 r_12
	r_15 := -#Result r_14
	§RETURN r_15 IF TRUE
