	t_5 := [t_3 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [t_1, INT]
	t_8 := [EMPTY_TYPE, t_7]
	t_9 := [t_8 => t_4]
	t_10 := [EMPTY_TYPE => t_9]
	t_11 := [EMPTY_TYPE, INT]
	t_12 := [t_11, EMPTY_TYPE]
	t_13 := [EMPTY_TYPE, t_12]
	t_14 := [t_13 => t_4]
	t_15 := [EMPTY_TYPE => t_14]
	t_16 := [t_11, INT]
	t_17 := [EMPTY_TYPE, t_16]
	t_18 := [t_17 => t_4]
	t_19 := [EMPTY_TYPE => t_18]
	t_20 := [EMPTY_TYPE, t_6]
	t_21 := [t_20, t_10]
	t_22 := [t_21, t_15]
	t_23 := [t_22, t_19]
	t_24 := [EMPTY_TYPE, t_0]
	t_25 := [t_24, t_0]
