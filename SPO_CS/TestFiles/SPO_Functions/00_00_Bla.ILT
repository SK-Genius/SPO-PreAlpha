§DEF d_4 € t_28
	d_3 := §2ND ENV
	r_11 := §1ST ENV
	d_2 := §2ND r_11
	r_12 := §1ST r_11
	d_1 := §2ND r_12
	r_13 := §1ST r_12
	d_0 := §2ND r_13
