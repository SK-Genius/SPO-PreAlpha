§TYPES
	t_0 := [#_Box... INT]
	t_1 := [EMPTY_TYPE, t_0]
	t_2 := [#Result INT]
	t_3 := [t_1 => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [TRUE | FALSE]
	t_6 := [t_1 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE, t_4]
	t_9 := [t_8, t_7]
	t_10 := [t_9, t_4]
	t_11 := [t_10 => t_3]
	t_12 := [t_10, t_11]
	t_13 := [EMPTY_TYPE => INT]
	t_14 := [t_12 => t_13]

§DEF d_0 € t_4
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	r_1 := -#_Box... r_4
	r_2 := 1
	r_3 := +#Result r_2
	§RETURN r_3 IF TRUE

§DEF d_1 € t_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := -#_Box... r_5
	r_2 := 1
	r_3 := §INT r_1 == r_2
	r_4 := §BOOL r_3 ^ TRUE
	§RETURN FALSE IF r_4
	§RETURN TRUE IF TRUE

§DEF d_2 € t_4
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := -#_Box... r_3
	_Value := r_1
	r_2 := +#Result _Value
	§RETURN r_2 IF TRUE

§DEF d_3 € t_11
	d_2 := §2ND ENV
	r_9 := §1ST ENV
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_7
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_7
	§TRY_RETURN .r_1 r_2 IF r_3
	r_5 := §CLOSURE d_2 EMPTY
	r_6 := EMPTY, r_7
	§TRY_RETURN .r_5 r_6
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_14
	d_3 := §2ND ENV
	r_11 := §1ST ENV
	d_2 := §2ND r_11
	r_12 := §1ST r_11
	d_1 := §2ND r_12
	r_13 := §1ST r_12
	d_0 := §2ND r_13
	r_14 := §1ST r_13
	r_1 := 5
	r_2 := +#_Box... r_1
	r_3 := EMPTY, d_0
	r_4 := r_3, d_1
	r_5 := r_4, d_2
	r_6 := §CLOSURE d_3 r_5
	r_7 := EMPTY, r_2
	r_8 := OBJ, r_6
	r_9 := §OBJ:r_8 r_7
	r_10 := -#Result r_9
	§RETURN r_10 IF TRUE
