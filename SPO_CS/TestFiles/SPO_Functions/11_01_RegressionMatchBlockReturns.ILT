§TYPES
	t_0 := [EMPTY_TYPE, TRUE]
	t_1 := [INT | FALSE]
	t_2 := [#Result t_1]
	t_3 := [t_0 => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [EMPTY_TYPE, FALSE]
	t_6 := [t_5 => t_2]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE, t_4]
	t_9 := [t_8, t_7]
	t_10 := [TRUE | FALSE]
	t_11 := [EMPTY_TYPE, t_10]
	t_12 := [t_11 => t_2]
	t_13 := [t_9 => t_12]
	t_14 := [t_9, t_13]
	t_15 := [t_10 => t_1]
	t_16 := [t_14 => t_15]
	t_17 := [t_14, t_16]
	t_18 := [EMPTY_TYPE, t_1]
	t_19 := [t_18, t_1]
	t_20 := [EMPTY_TYPE => t_19]
	t_21 := [t_17 => t_20]

§DEF d_0 € t_4
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := 7
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_7
	r_3 := §1ST ARG
	r_2 := §2ND ARG
	r_1 := +#Result FALSE
	§RETURN r_1 IF TRUE

§DEF d_2 € t_13
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_5
	§TRY_RETURN .r_1 r_2
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_5
	§TRY_RETURN .r_3 r_4
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_16
	d_2 := §2ND ENV
	r_8 := §1ST ENV
	d_1 := §2ND r_8
	r_9 := §1ST r_8
	d_0 := §2ND r_9
	r_10 := §1ST r_9
	_aValue := ARG
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := §CLOSURE d_2 r_2
	r_4 := EMPTY, _aValue
	r_5 := OBJ, r_3
	r_6 := §OBJ:r_5 r_4
	r_7 := -#Result r_6
	§RETURN r_7 IF TRUE

§DEF d_4 € t_21
	d_3 := §2ND ENV
	r_9 := §1ST ENV
	d_2 := §2ND r_9
	r_10 := §1ST r_9
	d_1 := §2ND r_10
	r_11 := §1ST r_10
	d_0 := §2ND r_11
	r_12 := §1ST r_11
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := §CLOSURE d_3 r_3
	_Choose... := r_4
	r_5 := ._Choose... TRUE
	r_6 := EMPTY, r_5
	r_7 := ._Choose... FALSE
	r_8 := r_6, r_7
	§RETURN r_8 IF TRUE
