§DEF VarPattern... = (
	§VAR aSelf € §INT
) : (
	§VAR aValue € §INT
) => aValue

§DEF OpaqueMethodTransport... = (
	§VAR aSelf € §INT
) : (
	§DEF aGet € [[§VAR §INT] : [] => [§VAR §INT]]
) {
	aSelf : aGet => §DEF Result .
	
	§RETURN Result
}

§VAR Cell := 7 .
§VAR Opaque := 9 .

§DEF Get = (
	§VAR aTarget € §INT
) : () => aTarget

§VAR Receiver01 :
	= 7
	VarPattern Cell => §DEF Result01
.

§VAR Receiver02 :
	= 7
	OpaqueMethodTransport Get => §DEF Result02
.

§EXPORT (§TO_VAL Result01, §TO_VAL Result02)