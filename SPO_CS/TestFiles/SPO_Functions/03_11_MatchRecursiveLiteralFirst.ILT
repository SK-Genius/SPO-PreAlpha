§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [t_0, EMPTY_TYPE]
	t_2 := [t_1 | INT]
	t_3 := [§REC t_0 => t_2]
	t_4 := [EMPTY_TYPE, INT]
	t_5 := [#Result INT]
	t_6 := [t_4 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [TRUE | FALSE]
	t_9 := [t_4 => t_8]
	t_10 := [EMPTY_TYPE => t_9]
	t_11 := [§FREE TYPE]
	t_12 := [t_11, EMPTY_TYPE]
	t_13 := [t_12 | INT]
	t_14 := [§REC t_11 => t_13]
	t_15 := [t_14, EMPTY_TYPE]
	t_16 := [t_15 | INT]
	t_17 := [EMPTY_TYPE, t_16]
	t_18 := [t_17 => t_5]
	t_19 := [EMPTY_TYPE => t_18]
	t_20 := [EMPTY_TYPE, t_7]
	t_21 := [t_20, t_10]
	t_22 := [t_21, t_19]
	t_23 := [EMPTY_TYPE, t_14]
	t_24 := [t_23 => t_5]
	t_25 := [t_22 => t_24]
	t_26 := [t_22, t_25]
	t_27 := [t_14 => INT]
	t_28 := [t_26 => t_27]
	t_29 := [t_26, t_28]
	t_30 := [t_4, INT]
	t_31 := [EMPTY_TYPE => t_30]
	t_32 := [t_29 => t_31]

§DEF d_0 € t_7
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := 1
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_10
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	r_1 := 1
	r_2 := §INT r_4 == r_1
	r_3 := §BOOL r_2 ^ TRUE
	§RETURN FALSE IF r_3
	§RETURN TRUE IF TRUE

§DEF d_2 € t_19
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_3 € t_25
	d_2 := §2ND ENV
	r_9 := §1ST ENV
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_7
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_7
	§TRY_RETURN .r_1 r_2 IF r_3
	r_5 := §CLOSURE d_2 EMPTY
	r_6 := EMPTY, r_7
	§TRY_RETURN .r_5 r_6
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_28
	d_3 := §2ND ENV
	r_9 := §1ST ENV
	d_2 := §2ND r_9
	r_10 := §1ST r_9
	d_1 := §2ND r_10
	r_11 := §1ST r_10
	d_0 := §2ND r_11
	r_12 := §1ST r_11
	_Value := ARG
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := §CLOSURE d_3 r_3
	r_5 := EMPTY, _Value
	r_6 := OBJ, r_4
	r_7 := §OBJ:r_6 r_5
	r_8 := -#Result r_7
	§RETURN r_8 IF TRUE

§DEF d_5 € t_32
	d_4 := §2ND ENV
	r_12 := §1ST ENV
	d_3 := §2ND r_12
	r_13 := §1ST r_12
	d_2 := §2ND r_13
	r_14 := §1ST r_13
	d_1 := §2ND r_14
	r_15 := §1ST r_14
	d_0 := §2ND r_15
	r_16 := §1ST r_15
	_tRecursive := t_3
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := r_3, d_3
	r_5 := §CLOSURE d_4 r_4
	_Match... := r_5
	r_6 := 2
	r_7 := ._Match... r_6
	r_8 := EMPTY, r_7
	r_9 := 1
	r_10 := ._Match... r_9
	r_11 := r_8, r_10
	§RETURN r_11 IF TRUE
