§IMPORT ()

§DEF DirectPattern... = (
	§VAR aValue € §INT
) => aValue

§DEF TuplePattern... = (
	§DEF aOther € §INT
	§VAR aValue € §INT
) => (aOther, aValue)

§DEF RecordPattern... = {
	Value: §VAR aValue € §INT
} => {Value: aValue}

§DEF PrefixPattern... = (
	#Value (§VAR aValue € §INT)
) => (#Value aValue)

§DEF GuardedPattern... = (
	(§VAR aValue € §INT) & §TRUE
) => aValue

§DEF SigBinder... = (
	§SIG [§SIG_WITH t € §TYPE IN [§VAR t]] WITH §DEF t IN §VAR aValue
) => (
	§SIG [§SIG_WITH u € §TYPE IN [§VAR u]] WITH t IN aValue
)

§DEF AnnotatedHandle... = (
	§DEF aValue € [§VAR §INT]
) => aValue

§DEF AnyArgument... = (
	§DEF aValue € §ANY
) => aValue

§DEF UnionArgument... = (
	§DEF aValue € [[§VAR §INT] | §INT]
) => aValue

§DEF RecursiveDefinition = (
) => {
	§RECURSIVE {
		§DEF Pass... = (§VAR aValue € §INT) => aValue
	}
	
	§VAR Cell := 7 .
	
	§RETURN .Pass Cell
}

§VAR Cell := 7 .
§VAR Opaque := 9 .
§VAR Invalid := 0 .

(§DEF First02, §DEF Cell02) = .TuplePattern (3, Cell)

{Value: §DEF Cell03} = .RecordPattern {Value: Cell}

(#Value §DEF Cell04) = .PrefixPattern (#Value Cell)

(§SIG [§SIG_WITH t € §TYPE IN [§VAR t]] WITH §INT IN §DEF Cell06) = .SigBinder (
	§SIG [§SIG_WITH t € §TYPE IN [§VAR t]] WITH §INT IN Cell
)

§DEF Cell08 = §IF (.AnyArgument Cell) MATCH {
	§DEF Handle € [§VAR §INT]: Handle
	_: Invalid
}

§DEF Cell09 = §IF (.UnionArgument Cell) MATCH {
	§DEF Handle € [§VAR §INT]: Handle
	_: Invalid
}

§EXPORT (
	§TO_VAL .DirectPattern Cell
	(First02, §TO_VAL Cell02)
	§TO_VAL Cell03
	§TO_VAL Cell04
	§TO_VAL .GuardedPattern Cell
	§TO_VAL Cell06
	§TO_VAL .AnnotatedHandle Cell
	§TO_VAL Cell08
	§TO_VAL Cell09
	§TO_VAL .RecursiveDefinition
)