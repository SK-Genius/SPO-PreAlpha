§IMPORT ()

§DEF ArgumentOpaque... = (
	§VAR aSelf € §INT
) : (
	§DEF aOpaque € [§VAR §INT]
) {
	§DEF Pass... = (
		§DEF aValue € [§VAR §INT]
	) => {Handle: aValue, Number: 7}
	
	{Number: §DEF Number} = .Pass aOpaque
	
	§RETURN Number
}

§DEF ArgumentAllowed... = (
	§VAR aSelf € §INT
) : (
	§DEF aOpaque € [§VAR §INT]
) {
	§DEF Pass... = (
		§DEF aValue € [§VAR §INT]
	) => {Handle: aValue, Number: 7}
	
	{Handle: §DEF Result, Number: §DEF Number} = .Pass aSelf
	
	§DEF Read = (
		§VAR aTarget € §INT
	) : (
	) => §TO_VAL aTarget
	
	Result : Read => §DEF Value .
	
	§RETURN (Number, §TO_VAL Result, Value)
}

§VAR Cell := 7 .
§VAR Opaque := 9 .

§VAR Receiver03 :
	= 7
	ArgumentOpaque Opaque => §DEF Result03
.

§VAR Receiver04 :
	= 7
	ArgumentAllowed Opaque => §DEF Result04
.

§EXPORT (Result03, Result04)