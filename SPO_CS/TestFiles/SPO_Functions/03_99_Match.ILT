§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [#Result INT]
	t_2 := [t_0 => t_1]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [TRUE | FALSE]
	t_5 := [t_0 => t_4]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [EMPTY_TYPE, t_3]
	t_8 := [t_7, t_6]
	t_9 := [t_8, t_3]
	t_10 := [t_9 => t_2]
	t_11 := [t_9, t_10]
	t_12 := [EMPTY_TYPE => INT]
	t_13 := [t_11 => t_12]

§DEF d_0 € t_3
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_6
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	r_1 := 1
	r_2 := §INT r_4 == r_1
	r_3 := §BOOL r_2 ^ TRUE
	§RETURN FALSE IF r_3
	§RETURN TRUE IF TRUE

§DEF d_2 € t_3
	r_3 := §1ST ARG
	r_2 := §2ND ARG
	_Z := r_2
	r_1 := +#Result _Z
	§RETURN r_1 IF TRUE

§DEF d_3 € t_10
	d_2 := §2ND ENV
	r_9 := §1ST ENV
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_7
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_7
	§TRY_RETURN .r_1 r_2 IF r_3
	r_5 := §CLOSURE d_2 EMPTY
	r_6 := EMPTY, r_7
	§TRY_RETURN .r_5 r_6
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_13
	d_3 := §2ND ENV
	r_10 := §1ST ENV
	d_2 := §2ND r_10
	r_11 := §1ST r_10
	d_1 := §2ND r_11
	r_12 := §1ST r_11
	d_0 := §2ND r_12
	r_13 := §1ST r_12
	r_1 := 1
	_X := r_1
	r_2 := EMPTY, d_0
	r_3 := r_2, d_1
	r_4 := r_3, d_2
	r_5 := §CLOSURE d_3 r_4
	r_6 := EMPTY, _X
	r_7 := OBJ, r_5
	r_8 := §OBJ:r_7 r_6
	r_9 := -#Result r_8
	_Y := r_9
	§RETURN _Y IF TRUE
