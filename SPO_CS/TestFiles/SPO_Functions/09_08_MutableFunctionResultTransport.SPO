§DEF OpaqueResultTransport... = (
	§VAR aSelf € §INT
) : (
	§DEF aOpaque € [§VAR §INT]
) {
	§DEF Pass... = (
		§DEF aValue € [§VAR §INT]
	) => {Handle: aValue, Number: 7}
	
	{Handle: §DEF Result} = .Pass aOpaque
	
	§RETURN Result
}

§VAR Opaque := 9 .

§VAR Receiver01 :
	= 7
	OpaqueResultTransport Opaque => §DEF Result01
.

§EXPORT §TO_VAL Result01