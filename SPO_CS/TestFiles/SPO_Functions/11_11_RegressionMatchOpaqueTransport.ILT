§TYPES
	t_0 := [§VAR INT]
	t_1 := [t_0, INT]
	t_2 := [#Result t_0]
	t_3 := [t_1 => t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [TRUE | FALSE]
	t_6 := [t_1 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE, t_4]
	t_9 := [t_8, t_7]
	t_10 := [t_9, t_4]
	t_11 := [t_10 => t_3]
	t_12 := [t_10, t_11]
	t_13 := [t_0 => t_0]
	t_14 := [t_12 => t_13]
	t_15 := [t_12, t_14]
	t_16 := [EMPTY_TYPE => INT]
	t_17 := [t_15 => t_16]

§DEF d_0 € t_4
	r_3 := §1ST ARG
	r_2 := §2ND ARG
	_aCell := r_3
	r_1 := +#Result _aCell
	§RETURN r_1 IF TRUE

§DEF d_1 € t_7
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	_aCell := r_5
	r_1 := 0
	r_2 := §INT r_4 == r_1
	r_3 := §BOOL r_2 ^ TRUE
	§RETURN FALSE IF r_3
	§RETURN TRUE IF TRUE

§DEF d_2 € t_4
	r_3 := §1ST ARG
	r_2 := §2ND ARG
	_aCell := r_3
	r_1 := +#Result _aCell
	§RETURN r_1 IF TRUE

§DEF d_3 € t_11
	d_2 := §2ND ENV
	r_9 := §1ST ENV
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	_aCell := r_8
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := _aCell, r_7
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := _aCell, r_7
	§TRY_RETURN .r_1 r_2 IF r_3
	r_5 := §CLOSURE d_2 EMPTY
	r_6 := _aCell, r_7
	§TRY_RETURN .r_5 r_6
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_14
	d_3 := §2ND ENV
	r_10 := §1ST ENV
	d_2 := §2ND r_10
	r_11 := §1ST r_10
	d_1 := §2ND r_11
	r_12 := §1ST r_11
	d_0 := §2ND r_12
	r_13 := §1ST r_12
	_aCell := ARG
	r_1 := 0
	r_2 := EMPTY, d_0
	r_3 := r_2, d_1
	r_4 := r_3, d_2
	r_5 := §CLOSURE d_3 r_4
	r_6 := _aCell, r_1
	r_7 := OBJ, r_5
	r_8 := §OBJ:r_7 r_6
	r_9 := -#Result r_8
	§RETURN r_9 IF TRUE

§DEF d_5 € t_17
	d_4 := §2ND ENV
	r_9 := §1ST ENV
	d_3 := §2ND r_9
	r_10 := §1ST r_9
	d_2 := §2ND r_10
	r_11 := §1ST r_10
	d_1 := §2ND r_11
	r_12 := §1ST r_11
	d_0 := §2ND r_12
	r_13 := §1ST r_12
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := r_3, d_3
	r_5 := §CLOSURE d_4 r_4
	_Pass... := r_5
	r_6 := 7
	_Cell := §VAR r_6
	r_7 := ._Pass... _Cell
	r_8 := §VAR r_7 ->
	§RETURN r_8 IF TRUE
