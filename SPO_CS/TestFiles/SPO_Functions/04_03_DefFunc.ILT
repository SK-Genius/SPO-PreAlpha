§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [EMPTY_TYPE, t_2]
	t_4 := [t_3, INT]
	t_5 := [INT => INT]
	t_6 := [t_4 => t_5]
	t_7 := [#_...*... t_2]
	t_8 := [{EMPTY_TYPE} + t_7]
	t_9 := [t_1, INT]
	t_10 := [t_9, INT]
	t_11 := [t_10, INT]
	t_12 := [t_11, INT]
	t_13 := [t_8 => t_12]
	t_14 := [t_6 => t_13]

§DEF d_0 € t_6
	_K := §2ND ENV
	r_4 := §1ST ENV
	_...*... := §2ND r_4
	r_5 := §1ST r_4
	_a := ARG
	r_1 := EMPTY, _K
	r_2 := r_1, _a
	r_3 := ._...*... r_2
	§RETURN r_3 IF TRUE

§DEF d_1 € t_14
	d_0 := ENV
	r_1 := {ARG} #_...*...
	r_2 := §WITH_TYPE t_2 WITH r_1
	_...*... := r_2
	r_3 := 3
	_K := r_3
	r_4 := EMPTY, _...*...
	r_5 := r_4, _K
	r_6 := §CLOSURE d_0 r_5
	_X... := r_6
	r_7 := 0
	r_8 := ._X... r_7
	r_9 := EMPTY, r_8
	r_10 := 1
	r_11 := ._X... r_10
	r_12 := r_9, r_11
	r_13 := 2
	r_14 := ._X... r_13
	r_15 := r_12, r_14
	r_16 := 3
	r_17 := ._X... r_16
	r_18 := r_15, r_17
	r_19 := 4
	r_20 := ._X... r_19
	r_21 := r_18, r_20
	r_22 := 5
	r_23 := ._X... r_22
	r_24 := r_21, r_23
	§RETURN r_24 IF TRUE
