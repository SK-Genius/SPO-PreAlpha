§TYPES
	t_0 := [EMPTY_TYPE, EMPTY_TYPE]
	t_1 := [TRUE | FALSE]
	t_2 := [t_0, t_1]
	t_3 := [t_2, INT]
	t_4 := [EMPTY_TYPE, INT]
	t_5 := [t_4, t_1]
	t_6 := [#_BLA...BLUB... t_5]
	t_7 := [EMPTY_TYPE, t_2]
	t_8 := [t_7, t_3]
	t_9 := [t_8, t_6]
	t_10 := [t_4, INT]
	t_11 := [#_...<... t_10]
	t_12 := [t_9, t_11]
	t_13 := [EMPTY_TYPE => t_12]
	t_14 := [EMPTY_TYPE => t_13]

§DEF d_0 € t_14
	r_1 := EMPTY, EMPTY
	r_2 := r_1, TRUE
	r_3 := §WITH_TYPE t_2 WITH r_2
	_A_0 := r_3
	r_4 := EMPTY, EMPTY
	r_5 := r_4, TRUE
	r_6 := 1
	r_7 := r_5, r_6
	r_8 := §WITH_TYPE t_3 WITH r_7
	_A_1 := r_8
	r_9 := 1
	r_10 := EMPTY, r_9
	r_11 := r_10, TRUE
	r_12 := +#_BLA...BLUB... r_11
	r_13 := §WITH_TYPE t_6 WITH r_12
	_A_2 := r_13
	r_14 := 1
	r_15 := EMPTY, r_14
	r_16 := 2
	r_17 := r_15, r_16
	r_18 := +#_...<... r_17
	_A_3 := r_18
	r_19 := EMPTY, _A_0
	r_20 := r_19, _A_1
	r_21 := r_20, _A_2
	r_22 := r_21, _A_3
	§RETURN r_22 IF TRUE
