§TYPES
	t_0 := [#Result INT]
	t_1 := [EMPTY_TYPE => t_0]
	t_2 := [EMPTY_TYPE => t_1]
	t_3 := [t_2 => t_1]
	t_4 := [EMPTY_TYPE, t_2]
	t_5 := [t_4, t_3]
	t_6 := [EMPTY_TYPE => INT]
	t_7 := [t_5 => t_6]

§DEF d_0 € t_2
	r_1 := 1
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_3
	d_0 := ENV
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_7
	d_1 := §2ND ENV
	r_4 := §1ST ENV
	d_0 := §2ND r_4
	r_5 := §1ST r_4
	r_1 := .d_1 d_0
	r_2 := .r_1 EMPTY
	r_3 := -#Result r_2
	§RETURN r_3 IF TRUE
