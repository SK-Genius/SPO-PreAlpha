§TYPES
	t_0 := [EMPTY_TYPE, EMPTY_TYPE]
	t_1 := [#Result INT]
	t_2 := [t_0 => t_1]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [t_3 => t_2]
	t_5 := [EMPTY_TYPE, t_3]
	t_6 := [t_5, t_4]
	t_7 := [EMPTY_TYPE => INT]
	t_8 := [t_6 => t_7]

§DEF d_0 € t_3
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := 1
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_4
	d_0 := ENV
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_3
	§TRY_RETURN .r_1 r_2
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_8
	d_1 := §2ND ENV
	r_6 := §1ST ENV
	d_0 := §2ND r_6
	r_7 := §1ST r_6
	r_1 := §CLOSURE d_1 d_0
	r_2 := EMPTY, EMPTY
	r_3 := OBJ, r_1
	r_4 := §OBJ:r_3 r_2
	r_5 := -#Result r_4
	§RETURN r_5 IF TRUE
