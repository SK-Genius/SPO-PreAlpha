§TYPES
	t_0 := [#_X INT]
	t_1 := [{EMPTY_TYPE} + t_0]
	t_2 := [#_Y INT]
	t_3 := [{t_1} + t_2]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [EMPTY_TYPE => t_4]

§DEF d_0 € t_5
	r_1 := 12
	r_2 := +#_X r_1
	r_3 := {EMPTY} + r_2
	r_4 := 34
	r_5 := +#_Y r_4
	r_6 := {r_3} + r_5
	_Point := r_6
	§RETURN _Point IF TRUE
