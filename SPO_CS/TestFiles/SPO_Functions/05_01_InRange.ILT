§DEF d_0 € t_11
	_...<=... := §2ND ENV
	r_16 := §1ST ENV
	_...And... := §2ND r_16
	r_17 := §1ST r_16
	r_1 := §2ND ARG
	_aMax := r_1
	r_2 := §1ST ARG
	r_3 := §2ND r_2
	_aVal := r_3
	r_4 := §1ST r_2
	r_5 := §2ND r_4
	_aMin := r_5
	r_6 := §1ST r_4
	§RETURN r_6 IF_NOT_EMPTY
	r_7 := EMPTY, _aMin
	r_8 := r_7, _aVal
	r_9 := ._...<=... r_8
	r_10 := EMPTY, r_9
	r_11 := EMPTY, _aVal
	r_12 := r_11, _aMax
	r_13 := ._...<=... r_12
	r_14 := r_10, r_13
	r_15 := ._...And... r_14
	§RETURN r_15 IF TRUE

§DEF d_1 € t_21
	d_0 := ENV
	r_1 := {ARG} #_...<=...
	r_2 := §WITH_TYPE t_3 WITH r_1
	_...<=... := r_2
	r_3 := {ARG} #_...And...
	r_4 := §WITH_TYPE t_6 WITH r_3
	_...And... := r_4
	r_5 := EMPTY, _...And...
	r_6 := r_5, _...<=...
	r_7 := §CLOSURE d_0 r_6
	_...<=...<=... := r_7
	r_8 := 1
	r_9 := EMPTY, r_8
	r_10 := 1
	r_11 := r_9, r_10
	r_12 := 1
	r_13 := r_11, r_12
	r_14 := ._...<=...<=... r_13
	r_15 := EMPTY, r_14
	r_16 := 1
	r_17 := EMPTY, r_16
	r_18 := 2
	r_19 := r_17, r_18
	r_20 := 3
	r_21 := r_19, r_20
	r_22 := ._...<=...<=... r_21
	r_23 := r_15, r_22
	r_24 := 3
	r_25 := EMPTY, r_24
	r_26 := 2
	r_27 := r_25, r_26
	r_28 := 1
	r_29 := r_27, r_28
	r_30 := ._...<=...<=... r_29
	r_31 := r_23, r_30
	r_32 := 3
	r_33 := EMPTY, r_32
	r_34 := 1
	r_35 := r_33, r_34
	r_36 := 5
	r_37 := r_35, r_36
	r_38 := ._...<=...<=... r_37
	r_39 := r_31, r_38
	r_40 := 3
	r_41 := EMPTY, r_40
	r_42 := 4
	r_43 := r_41, r_42
	r_44 := 5
	r_45 := r_43, r_44
	r_46 := ._...<=...<=... r_45
	r_47 := r_39, r_46
	r_48 := 3
	r_49 := EMPTY, r_48
	r_50 := 6
	r_51 := r_49, r_50
	r_52 := 5
	r_53 := r_51, r_52
	r_54 := ._...<=...<=... r_53
	r_55 := r_47, r_54
	§RETURN r_55 IF TRUE
