§DEF AnyNarrowing... = (
	§DEF aValue € [§VAR §INT]
) => {
	§DEF Hidden € §ANY = aValue
	§RETURN §IF Hidden MATCH {
		§DEF Item € [§VAR §INT]: Item
		_: aValue
	}
}

§DEF UnionNarrowing... = (
	§DEF aValue € [§VAR §INT]
) => {
	§DEF Hidden € [[§VAR §INT] | §INT] = aValue
	§RETURN §IF Hidden MATCH {
		§DEF Item € [§VAR §INT]: Item
		_: aValue
	}
}

§VAR Cell := 7 .

§EXPORT (
	§TO_VAL .AnyNarrowing Cell
	§TO_VAL .UnionNarrowing Cell
)