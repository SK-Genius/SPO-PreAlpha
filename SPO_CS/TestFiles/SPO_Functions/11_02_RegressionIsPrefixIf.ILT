§TYPES
	t_0 := [#_Paused... EMPTY_TYPE]
	t_1 := [#_Running... EMPTY_TYPE]
	t_2 := [t_0 | t_1]
	t_3 := [EMPTY_TYPE, t_1]
	t_4 := [TRUE | FALSE]
	t_5 := [#Result t_4]
	t_6 := [t_3 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE, t_0]
	t_9 := [t_8 => t_5]
	t_10 := [EMPTY_TYPE => t_9]
	t_11 := [EMPTY_TYPE, t_7]
	t_12 := [t_11, t_10]
	t_13 := [EMPTY_TYPE, t_2]
	t_14 := [t_13 => t_5]
	t_15 := [t_12 => t_14]
	t_16 := [t_13, t_7]
	t_17 := [t_16, t_10]
	t_18 := [t_17, t_15]
	t_19 := [EMPTY_TYPE, EMPTY_TYPE]
	t_20 := [t_19 => INT]
	t_21 := [t_18 => t_20]
	t_22 := [t_12, t_15]
	t_23 := [t_22, t_21]
	t_24 := [t_2 => INT]
	t_25 := [t_23 => t_24]
	t_26 := [INT | EMPTY_TYPE]
	t_27 := [t_19 => t_26]
	t_28 := [t_4 => t_27]
	t_29 := [EMPTY_TYPE | INT]
	t_30 := [t_4 => t_29]
	t_31 := [t_28 => t_30]
	t_32 := [t_23, t_25]
	t_33 := [t_32, t_28]
	t_34 := [t_33, t_31]
	t_35 := [EMPTY_TYPE, INT]
	t_36 := [t_35, INT]
	t_37 := [t_36, t_29]
	t_38 := [t_37, t_29]
	t_39 := [EMPTY_TYPE => t_38]
	t_40 := [t_34 => t_39]

§DEF d_0 € t_7
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := -#_Running... r_3
	r_2 := +#Result TRUE
	§RETURN r_2 IF TRUE

§DEF d_1 € t_10
	r_3 := §1ST ARG
	r_2 := §2ND ARG
	r_1 := +#Result FALSE
	§RETURN r_1 IF TRUE

§DEF d_2 € t_15
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_5
	§TRY_RETURN .r_1 r_2
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_5
	§TRY_RETURN .r_3 r_4
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_21
	d_2 := §2ND ENV
	r_12 := §1ST ENV
	d_1 := §2ND r_12
	r_13 := §1ST r_12
	d_0 := §2ND r_13
	r_14 := §1ST r_13
	_aPhase := §2ND r_14
	r_15 := §1ST r_14
	r_11 := §1ST ARG
	r_10 := §2ND ARG
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := §CLOSURE d_2 r_2
	r_4 := EMPTY, _aPhase
	r_5 := OBJ, r_3
	r_6 := §OBJ:r_5 r_4
	r_7 := -#Result r_6
	r_8 := 1
	§RETURN r_8 IF r_7
	r_9 := 0
	§RETURN r_9 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_25
	d_3 := §2ND ENV
	r_10 := §1ST ENV
	d_2 := §2ND r_10
	r_11 := §1ST r_10
	d_1 := §2ND r_11
	r_12 := §1ST r_11
	d_0 := §2ND r_12
	r_13 := §1ST r_12
	_aPhase := ARG
	r_2 := EMPTY, _aPhase
	r_3 := r_2, d_0
	r_4 := r_3, d_1
	r_5 := r_4, d_2
	r_6 := §CLOSURE d_3 r_5
	r_7 := EMPTY, EMPTY
	r_8 := OBJ, r_6
	r_9 := §OBJ:r_8 r_7
	r_1 := r_9
	§RETURN r_1 IF TRUE

§DEF d_5 € t_28
	_aEnabled := ENV
	r_3 := §1ST ARG
	r_2 := §2ND ARG
	r_1 := 7
	§RETURN r_1 IF _aEnabled
	§RETURN EMPTY IF TRUE

§DEF d_6 € t_31
	d_5 := ENV
	_aEnabled := ARG
	r_2 := §CLOSURE d_5 _aEnabled
	r_3 := EMPTY, EMPTY
	r_4 := OBJ, r_2
	r_5 := §OBJ:r_4 r_3
	r_1 := r_5
	§RETURN r_1 IF TRUE

§DEF d_7 € t_40
	d_6 := §2ND ENV
	r_17 := §1ST ENV
	d_5 := §2ND r_17
	r_18 := §1ST r_17
	d_4 := §2ND r_18
	r_19 := §1ST r_18
	d_3 := §2ND r_19
	r_20 := §1ST r_19
	d_2 := §2ND r_20
	r_21 := §1ST r_20
	d_1 := §2ND r_21
	r_22 := §1ST r_21
	d_0 := §2ND r_22
	r_23 := §1ST r_22
	_tPhase := t_2
	r_1 := EMPTY, d_0
	r_2 := r_1, d_1
	r_3 := r_2, d_2
	r_4 := r_3, d_3
	r_5 := §CLOSURE d_4 r_4
	_Step... := r_5
	r_6 := §CLOSURE d_6 d_5
	_Optional... := r_6
	r_7 := +#_Running... EMPTY
	r_8 := ._Step... r_7
	r_9 := EMPTY, r_8
	r_10 := +#_Paused... EMPTY
	r_11 := ._Step... r_10
	r_12 := r_9, r_11
	r_13 := ._Optional... TRUE
	r_14 := r_12, r_13
	r_15 := ._Optional... FALSE
	r_16 := r_14, r_15
	§RETURN r_16 IF TRUE
