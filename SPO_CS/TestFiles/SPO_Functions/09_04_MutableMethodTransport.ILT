§DEF d_0 € t_3
	_aValue := ARG
	_aSelf := OBJ
	§RETURN _aValue IF TRUE

§DEF d_1 € t_8
	_aGet := ARG
	_aSelf := OBJ
	r_2 := _aSelf, _aGet
	r_1 := §OBJ:r_2 EMPTY
	_Result := r_1
	§RETURN _Result IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_9
	§RETURN ARG IF_NOT_EMPTY
	_aTarget := OBJ
	§RETURN _aTarget IF TRUE

§DEF d_3 € t_16
	d_2 := §2ND ENV
	r_16 := §1ST ENV
	d_1 := §2ND r_16
	r_17 := §1ST r_16
	d_0 := §2ND r_17
	r_18 := §1ST r_17
	r_1 := §CLOSURE d_0 EMPTY
	_VarPattern... := r_1
	r_2 := §CLOSURE d_1 EMPTY
	_OpaqueMethodTransport... := r_2
	r_3 := 7
	_Cell := §VAR r_3
	r_4 := 9
	_Opaque := §VAR r_4
	r_5 := §CLOSURE d_2 EMPTY
	_Get := r_5
	r_6 := 7
	_Receiver01 := §VAR r_6
	r_8 := _Receiver01, _VarPattern...
	r_7 := §OBJ:r_8 _Cell
	_Result01 := r_7
	r_9 := 7
	_Receiver02 := §VAR r_9
	r_11 := _Receiver02, _OpaqueMethodTransport...
	r_10 := §OBJ:r_11 _Get
	_Result02 := r_10
	r_12 := §VAR _Result01 ->
	r_13 := EMPTY, r_12
	r_14 := §VAR _Result02 ->
	r_15 := r_13, r_14
	§RETURN r_15 IF TRUE
