§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [t_1 => INT]
	t_3 := [INT => EMPTY_TYPE]
	t_4 := [§VAR INT]
	t_5 := [t_4 : t_3]
	t_6 := [t_2 => t_5]
	t_7 := [EMPTY_TYPE, t_6]
	t_8 := [t_7, t_6]
	t_9 := [#_...*... t_2]
	t_10 := [{EMPTY_TYPE} + t_9]
	t_11 := [#_...+... t_2]
	t_12 := [{t_10} + t_11]
	t_13 := [t_12 => INT]
	t_14 := [t_8 => t_13]

§DEF d_0 € t_6
	_...+... := ENV
	_i := ARG
	_o := OBJ
	r_1 := §VAR _o ->
	r_2 := EMPTY, r_1
	r_3 := r_2, _i
	r_4 := ._...+... r_3
	§VAR _o <- r_4
	§RETURN EMPTY IF TRUE

§DEF d_1 € t_6
	_...*... := ENV
	_i := ARG
	_o := OBJ
	r_1 := §VAR _o ->
	r_2 := EMPTY, r_1
	r_3 := r_2, _i
	r_4 := ._...*... r_3
	§VAR _o <- r_4
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_14
	d_1 := §2ND ENV
	r_21 := §1ST ENV
	d_0 := §2ND r_21
	r_22 := §1ST r_21
	r_1 := {ARG} #_...+...
	r_2 := §WITH_TYPE t_2 WITH r_1
	_...+... := r_2
	r_3 := {ARG} #_...*...
	r_4 := §WITH_TYPE t_2 WITH r_3
	_...*... := r_4
	r_5 := §CLOSURE d_0 _...+...
	_+... := r_5
	r_6 := §CLOSURE d_1 _...*...
	_*... := r_6
	r_7 := 1
	_x := §VAR r_7
	r_8 := 3
	r_10 := _x, _+...
	r_9 := §OBJ:r_10 r_8
	r_11 := 2
	r_13 := _x, _*...
	r_12 := §OBJ:r_13 r_11
	r_14 := 3
	r_16 := _x, _+...
	r_15 := §OBJ:r_16 r_14
	r_17 := 2
	r_19 := _x, _*...
	r_18 := §OBJ:r_19 r_17
	r_20 := §VAR _x ->
	§RETURN r_20 IF TRUE
