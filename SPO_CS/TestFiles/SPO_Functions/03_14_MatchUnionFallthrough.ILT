§TYPES
	t_0 := [#Result INT]
	t_1 := [EMPTY_TYPE => t_0]
	t_2 := [EMPTY_TYPE => t_1]
	t_3 := [INT => t_0]
	t_4 := [EMPTY_TYPE => t_3]
	t_5 := [EMPTY_TYPE, t_2]
	t_6 := [t_5, t_4]
	t_7 := [INT | EMPTY_TYPE]
	t_8 := [t_7 => t_0]
	t_9 := [t_6 => t_8]
	t_10 := [#_A EMPTY_TYPE]
	t_11 := [t_10 => t_0]
	t_12 := [EMPTY_TYPE => t_11]
	t_13 := [#_B EMPTY_TYPE]
	t_14 := [t_13 => t_0]
	t_15 := [EMPTY_TYPE => t_14]
	t_16 := [EMPTY_TYPE, t_12]
	t_17 := [t_16, t_15]
	t_18 := [t_13 | t_10]
	t_19 := [t_18 => t_0]
	t_20 := [t_17 => t_19]
	t_21 := [t_6, t_9]
	t_22 := [t_21, t_12]
	t_23 := [t_22, t_15]
	t_24 := [t_23, t_20]
	t_25 := [EMPTY_TYPE, INT]
	t_26 := [t_25, INT]
	t_27 := [EMPTY_TYPE => t_26]
	t_28 := [t_24 => t_27]

§DEF d_0 € t_2
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_4
	_Int := ARG
	r_1 := +#Result _Int
	§RETURN r_1 IF TRUE

§DEF d_2 € t_9
	d_1 := §2ND ENV
	r_3 := §1ST ENV
	d_0 := §2ND r_3
	r_4 := §1ST r_3
	r_1 := .d_0 EMPTY
	§TRY_RETURN .r_1 ARG
	r_2 := .d_1 EMPTY
	§TRY_RETURN .r_2 ARG
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_12
	r_1 := -#_A ARG
	r_2 := 1
	r_3 := +#Result r_2
	§RETURN r_3 IF TRUE

§DEF d_4 € t_15
	r_1 := -#_B ARG
	r_2 := 2
	r_3 := +#Result r_2
	§RETURN r_3 IF TRUE

§DEF d_5 € t_20
	d_4 := §2ND ENV
	r_3 := §1ST ENV
	d_3 := §2ND r_3
	r_4 := §1ST r_3
	r_1 := .d_3 EMPTY
	§TRY_RETURN .r_1 ARG
	r_2 := .d_4 EMPTY
	§TRY_RETURN .r_2 ARG
	§RETURN EMPTY IF TRUE

§DEF d_6 € t_28
	d_5 := §2ND ENV
	r_15 := §1ST ENV
	d_4 := §2ND r_15
	r_16 := §1ST r_15
	d_3 := §2ND r_16
	r_17 := §1ST r_16
	d_2 := §2ND r_17
	r_18 := §1ST r_17
	d_1 := §2ND r_18
	r_19 := §1ST r_18
	d_0 := §2ND r_19
	r_20 := §1ST r_19
	r_1 := 2
	_Value := r_1
	r_2 := +#_B EMPTY
	_TaggedValue := r_2
	r_3 := EMPTY, d_0
	r_4 := r_3, d_1
	r_5 := .d_2 r_4
	r_6 := .r_5 _Value
	r_7 := -#Result r_6
	r_8 := EMPTY, r_7
	r_9 := EMPTY, d_3
	r_10 := r_9, d_4
	r_11 := .d_5 r_10
	r_12 := .r_11 _TaggedValue
	r_13 := -#Result r_12
	r_14 := r_8, r_13
	§RETURN r_14 IF TRUE
