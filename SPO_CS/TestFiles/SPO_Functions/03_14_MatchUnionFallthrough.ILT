§TYPES
	t_0 := [EMPTY_TYPE, EMPTY_TYPE]
	t_1 := [#Result INT]
	t_2 := [t_0 => t_1]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [EMPTY_TYPE, INT]
	t_5 := [t_4 => t_1]
	t_6 := [EMPTY_TYPE => t_5]
	t_7 := [EMPTY_TYPE, t_3]
	t_8 := [t_7, t_6]
	t_9 := [INT | EMPTY_TYPE]
	t_10 := [EMPTY_TYPE, t_9]
	t_11 := [t_10 => t_1]
	t_12 := [t_8 => t_11]
	t_13 := [#_A EMPTY_TYPE]
	t_14 := [EMPTY_TYPE, t_13]
	t_15 := [t_14 => t_1]
	t_16 := [EMPTY_TYPE => t_15]
	t_17 := [#_B EMPTY_TYPE]
	t_18 := [EMPTY_TYPE, t_17]
	t_19 := [t_18 => t_1]
	t_20 := [EMPTY_TYPE => t_19]
	t_21 := [EMPTY_TYPE, t_16]
	t_22 := [t_21, t_20]
	t_23 := [t_17 | t_13]
	t_24 := [EMPTY_TYPE, t_23]
	t_25 := [t_24 => t_1]
	t_26 := [t_22 => t_25]
	t_27 := [t_8, t_12]
	t_28 := [t_27, t_16]
	t_29 := [t_28, t_20]
	t_30 := [t_29, t_26]
	t_31 := [t_4, INT]
	t_32 := [EMPTY_TYPE => t_31]
	t_33 := [t_30 => t_32]

§DEF d_0 € t_3
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_6
	r_3 := §1ST ARG
	r_2 := §2ND ARG
	_Int := r_2
	r_1 := +#Result _Int
	§RETURN r_1 IF TRUE

§DEF d_2 € t_12
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_5
	§TRY_RETURN .r_1 r_2
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_5
	§TRY_RETURN .r_3 r_4
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_16
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	r_1 := -#_A r_4
	r_2 := 1
	r_3 := +#Result r_2
	§RETURN r_3 IF TRUE

§DEF d_4 € t_20
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	r_1 := -#_B r_4
	r_2 := 2
	r_3 := +#Result r_2
	§RETURN r_3 IF TRUE

§DEF d_5 € t_26
	d_4 := §2ND ENV
	r_7 := §1ST ENV
	d_3 := §2ND r_7
	r_8 := §1ST r_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §CLOSURE d_3 EMPTY
	r_2 := EMPTY, r_5
	§TRY_RETURN .r_1 r_2
	r_3 := §CLOSURE d_4 EMPTY
	r_4 := EMPTY, r_5
	§TRY_RETURN .r_3 r_4
	§RETURN EMPTY IF TRUE

§DEF d_6 € t_33
	d_5 := §2ND ENV
	r_19 := §1ST ENV
	d_4 := §2ND r_19
	r_20 := §1ST r_19
	d_3 := §2ND r_20
	r_21 := §1ST r_20
	d_2 := §2ND r_21
	r_22 := §1ST r_21
	d_1 := §2ND r_22
	r_23 := §1ST r_22
	d_0 := §2ND r_23
	r_24 := §1ST r_23
	r_1 := 2
	_Value := r_1
	r_2 := +#_B EMPTY
	_TaggedValue := r_2
	r_3 := EMPTY, d_0
	r_4 := r_3, d_1
	r_5 := §CLOSURE d_2 r_4
	r_6 := EMPTY, _Value
	r_7 := OBJ, r_5
	r_8 := §OBJ:r_7 r_6
	r_9 := -#Result r_8
	r_10 := EMPTY, r_9
	r_11 := EMPTY, d_3
	r_12 := r_11, d_4
	r_13 := §CLOSURE d_5 r_12
	r_14 := EMPTY, _TaggedValue
	r_15 := OBJ, r_13
	r_16 := §OBJ:r_15 r_14
	r_17 := -#Result r_16
	r_18 := r_10, r_17
	§RETURN r_18 IF TRUE
