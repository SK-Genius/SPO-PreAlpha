§TYPES
	t_0 := [INT | EMPTY_TYPE]
	t_1 := [#_B EMPTY_TYPE]
	t_2 := [#_A EMPTY_TYPE]
	t_3 := [t_1 | t_2]
	t_4 := [EMPTY_TYPE, EMPTY_TYPE]
	t_5 := [#Result INT]
	t_6 := [t_4 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [EMPTY_TYPE, INT]
	t_9 := [t_8 => t_5]
	t_10 := [EMPTY_TYPE => t_9]
	t_11 := [EMPTY_TYPE, t_7]
	t_12 := [t_11, t_10]
	t_13 := [EMPTY_TYPE, t_0]
	t_14 := [t_13 => t_5]
	t_15 := [t_12 => t_14]
	t_16 := [EMPTY_TYPE, t_2]
	t_17 := [t_16 => t_5]
	t_18 := [EMPTY_TYPE => t_17]
	t_19 := [EMPTY_TYPE, t_1]
	t_20 := [t_19 => t_5]
	t_21 := [EMPTY_TYPE => t_20]
	t_22 := [EMPTY_TYPE, t_18]
	t_23 := [t_22, t_21]
	t_24 := [EMPTY_TYPE, t_3]
	t_25 := [t_24 => t_5]
	t_26 := [t_23 => t_25]
	t_27 := [t_12, t_15]
	t_28 := [t_27, t_18]
	t_29 := [t_28, t_21]
	t_30 := [t_29, t_26]
	t_31 := [t_8, INT]
	t_32 := [EMPTY_TYPE => t_31]
	t_33 := [t_30 => t_32]

§DEF d_0 € t_7
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := 0
	r_2 := +#Result r_1
	§RETURN r_2 IF TRUE

§DEF d_1 € t_10
	r_4 := §1ST ARG
	r_3 := §2ND ARG
	r_1 := §WITH_TYPE INT_TYPE WITH r_3
	_Int := r_1
	r_2 := +#Result _Int
	§RETURN r_2 IF TRUE

§DEF d_2 € t_15
	d_1 := §2ND ENV
	r_7 := §1ST ENV
	d_0 := §2ND r_7
	r_8 := §1ST r_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_5
	§TRY_RETURN .r_1 r_2
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_5
	§TRY_RETURN .r_3 r_4
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_18
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	r_1 := -#_A r_4
	r_2 := 1
	r_3 := +#Result r_2
	§RETURN r_3 IF TRUE

§DEF d_4 € t_21
	r_5 := §1ST ARG
	r_4 := §2ND ARG
	r_1 := -#_B r_4
	r_2 := 2
	r_3 := +#Result r_2
	§RETURN r_3 IF TRUE

§DEF d_5 € t_26
	d_4 := §2ND ENV
	r_7 := §1ST ENV
	d_3 := §2ND r_7
	r_8 := §1ST r_7
	r_6 := §1ST ARG
	r_5 := §2ND ARG
	r_1 := §CLOSURE d_3 EMPTY
	r_2 := EMPTY, r_5
	§TRY_RETURN .r_1 r_2
	r_3 := §CLOSURE d_4 EMPTY
	r_4 := EMPTY, r_5
	§TRY_RETURN .r_3 r_4
	§RETURN EMPTY IF TRUE

§DEF d_6 € t_33
	d_5 := §2ND ENV
	r_21 := §1ST ENV
	d_4 := §2ND r_21
	r_22 := §1ST r_21
	d_3 := §2ND r_22
	r_23 := §1ST r_22
	d_2 := §2ND r_23
	r_24 := §1ST r_23
	d_1 := §2ND r_24
	r_25 := §1ST r_24
	d_0 := §2ND r_25
	r_26 := §1ST r_25
	r_1 := 2
	r_2 := §WITH_TYPE t_0 WITH r_1
	_Value := r_2
	r_3 := +#_B EMPTY
	r_4 := §WITH_TYPE t_3 WITH r_3
	_TaggedValue := r_4
	r_5 := EMPTY, d_0
	r_6 := r_5, d_1
	r_7 := §CLOSURE d_2 r_6
	r_8 := EMPTY, _Value
	r_9 := OBJ, r_7
	r_10 := §OBJ:r_9 r_8
	r_11 := -#Result r_10
	r_12 := EMPTY, r_11
	r_13 := EMPTY, d_3
	r_14 := r_13, d_4
	r_15 := §CLOSURE d_5 r_14
	r_16 := EMPTY, _TaggedValue
	r_17 := OBJ, r_15
	r_18 := §OBJ:r_17 r_16
	r_19 := -#Result r_18
	r_20 := r_12, r_19
	§RETURN r_20 IF TRUE
