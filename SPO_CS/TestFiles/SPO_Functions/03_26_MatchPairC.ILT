§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [EMPTY_TYPE, t_1]
	t_3 := [#Result INT]
	t_4 := [t_2 => t_3]
	t_5 := [EMPTY_TYPE => t_4]
	t_6 := [TRUE | FALSE]
	t_7 := [t_2 => t_6]
	t_8 := [EMPTY_TYPE => t_7]
	t_9 := [EMPTY_TYPE, t_5]
	t_10 := [t_9, t_8]
	t_11 := [t_10, t_5]
	t_12 := [t_11 => t_4]
	t_13 := [t_11, t_12]
	t_14 := [EMPTY_TYPE => INT]
	t_15 := [t_13 => t_14]

§DEF d_0 € t_5
	r_7 := §1ST ARG
	r_6 := §2ND ARG
	r_1 := §1ST r_6
	r_2 := §2ND r_6
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	_Second := r_2
	r_5 := +#Result _Second
	§RETURN r_5 IF TRUE

§DEF d_1 € t_8
	r_9 := §1ST ARG
	r_8 := §2ND ARG
	r_1 := §1ST r_8
	r_2 := §2ND r_8
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	r_5 := 0
	r_6 := §INT r_4 == r_5
	r_7 := §BOOL r_6 ^ TRUE
	§RETURN FALSE IF r_7
	_Second := r_2
	§RETURN TRUE IF TRUE

§DEF d_2 € t_5
	r_7 := §1ST ARG
	r_6 := §2ND ARG
	r_1 := §1ST r_6
	r_2 := §2ND r_6
	r_3 := §1ST r_1
	r_4 := §2ND r_1
	_First := r_4
	r_5 := +#Result _First
	§RETURN r_5 IF TRUE

§DEF d_3 € t_12
	d_2 := §2ND ENV
	r_9 := §1ST ENV
	d_1 := §2ND r_9
	r_10 := §1ST r_9
	d_0 := §2ND r_10
	r_11 := §1ST r_10
	r_8 := §1ST ARG
	r_7 := §2ND ARG
	r_1 := §CLOSURE d_0 EMPTY
	r_2 := EMPTY, r_7
	r_3 := §CLOSURE d_1 EMPTY
	r_4 := EMPTY, r_7
	§TRY_RETURN .r_1 r_2 IF r_3
	r_5 := §CLOSURE d_2 EMPTY
	r_6 := EMPTY, r_7
	§TRY_RETURN .r_5 r_6
	§RETURN EMPTY IF TRUE

§DEF d_4 € t_15
	d_3 := §2ND ENV
	r_13 := §1ST ENV
	d_2 := §2ND r_13
	r_14 := §1ST r_13
	d_1 := §2ND r_14
	r_15 := §1ST r_14
	d_0 := §2ND r_15
	r_16 := §1ST r_15
	r_1 := 0
	r_2 := EMPTY, r_1
	r_3 := 5
	r_4 := r_2, r_3
	r_5 := EMPTY, d_0
	r_6 := r_5, d_1
	r_7 := r_6, d_2
	r_8 := §CLOSURE d_3 r_7
	r_9 := EMPTY, r_4
	r_10 := OBJ, r_8
	r_11 := §OBJ:r_10 r_9
	r_12 := -#Result r_11
	§RETURN r_12 IF TRUE
