	t_35 := [t_34, INT]
	t_36 := [EMPTY_TYPE => t_35]
	t_37 := [t_32 => t_36]

§DEF d_0 € t_20
	§RETURN ARG IF_NOT_EMPTY
	_aSelf := OBJ
	r_1 := §VAR _aSelf ->
	§RETURN r_1 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_1 € t_22
	_aValue := ARG
	_aSelf := OBJ
	§VAR _aSelf <- _aValue
	§RETURN EMPTY IF TRUE

§DEF d_2 € t_26
	§RETURN ARG IF_NOT_EMPTY
	r_1 := §2ND OBJ
	_aOther := r_1
	r_2 := §1ST OBJ
	r_3 := §2ND r_2
	_aSelf := r_3
	r_4 := §1ST r_2
	§RETURN r_4 IF_NOT_EMPTY
	r_5 := §VAR _aSelf ->
	_First := r_5
	r_6 := §VAR _aOther ->
	_Second := r_6
	§VAR _aSelf <- _Second
	§VAR _aOther <- _First
	r_7 := EMPTY, _First
	r_8 := r_7, _Second
	§RETURN r_8 IF TRUE
	§RETURN EMPTY IF TRUE

§DEF d_3 € t_28
	r_1 := §SUBINTERFACE t_18 WITH ARG
	_aCapability := r_1
	§RETURN _aCapability IF TRUE

§DEF d_4 € t_37
	d_3 := §2ND ENV
	r_34 := §1ST ENV
	d_2 := §2ND r_34
	r_35 := §1ST r_34
	d_1 := §2ND r_35
	r_36 := §1ST r_35
	d_0 := §2ND r_36
	r_37 := §1ST r_36
	§RETURN ARG IF_NOT_EMPTY
	_iCell := t_18
	r_1 := §CLOSURE d_0 EMPTY
	_ReadCell := r_1
	r_2 := §CLOSURE d_1 EMPTY
	_WriteCell... := r_2
	r_3 := §CLOSURE d_2 EMPTY
	_ExchangeCells := r_3
	r_4 := 7
	_Cell := §VAR r_4
	r_5 := 9
	_Other := §VAR r_5
	r_6 := +#_Read _ReadCell
	r_7 := {EMPTY} + r_6
	r_8 := +#_Write... _WriteCell...
	r_9 := {r_7} + r_8
	r_10 := +#_Exchange _ExchangeCells
	r_11 := {r_9} + r_10
	r_12 := _Cell, r_11
	r_13 := §INTERFACE t_18 WITH r_12
	r_14 := §SUBINTERFACE t_18 WITH r_13
	_Capability := r_14
	r_15 := §CLOSURE d_3 EMPTY
	r_16 := §SUBINTERFACE t_27 WITH r_15
	_Pass... := r_16
	r_17 := ._Pass... _Capability
	r_18 := §SUBINTERFACE t_18 WITH r_17
	_Relayed := r_18
	r_19 := 11
	r_20 := +#_Write... EMPTY
	r_21 := _Relayed, r_20
	EMPTY := §OBJ:r_21 r_19
	r_22 := EMPTY, _Relayed
	r_23 := r_22, _Other
	r_24 := +#_Exchange EMPTY
	r_26 := r_23, r_24
	r_25 := §OBJ:r_26 EMPTY
	_Before := r_25
	r_27 := +#_Read EMPTY
	r_29 := _Capability, r_27
	r_28 := §OBJ:r_29 EMPTY
	_After := r_28
	r_30 := EMPTY, _Before
	r_31 := r_30, _After
	r_32 := §VAR _Other ->
