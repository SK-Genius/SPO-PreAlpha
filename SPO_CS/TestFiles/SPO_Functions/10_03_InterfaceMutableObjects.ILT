§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [EMPTY_TYPE, INT]
	t_2 := [t_1, INT]
	t_3 := [EMPTY_TYPE => t_2]
	t_4 := [EMPTY_TYPE, t_0]
