	r_1 := EMPTY, _X
	r_2 := 2
	r_3 := r_1, r_2
	r_4 := ._...==... r_3
	r_5 := §BOOL r_4 ^ TRUE
	§RETURN EMPTY IF r_5
	r_6 := 22
	r_7 := +#Result r_6
	§RETURN r_7 IF TRUE

§DEF d_2 € t_15
	d_1 := §2ND ENV
	r_12 := §1ST ENV
	d_0 := §2ND r_12
	r_13 := §1ST r_12
	_X := §2ND r_13
	r_14 := §1ST r_13
