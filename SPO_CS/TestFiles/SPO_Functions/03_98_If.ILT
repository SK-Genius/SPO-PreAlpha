§DEF d_0 € t_11
	_X := §2ND ENV
	r_10 := §1ST ENV
	_...==... := §2ND r_10
	r_11 := §1ST r_10
	r_9 := §1ST ARG
	r_8 := §2ND ARG
	r_1 := EMPTY, _X
	r_2 := 1
	r_3 := r_1, r_2
	r_4 := ._...==... r_3
	r_5 := §BOOL r_4 ^ TRUE
	§RETURN EMPTY IF r_5
	r_6 := 11
	r_7 := +#Result r_6
	§RETURN r_7 IF TRUE

§DEF d_1 € t_11
	_X := §2ND ENV
	r_10 := §1ST ENV
	_...==... := §2ND r_10
	r_11 := §1ST r_10
	r_9 := §1ST ARG
