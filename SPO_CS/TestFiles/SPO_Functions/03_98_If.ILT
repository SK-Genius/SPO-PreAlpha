§TYPES
	t_0 := [EMPTY_TYPE, INT]
	t_1 := [t_0, INT]
	t_2 := [TRUE | FALSE]
	t_3 := [t_1 => t_2]
	t_4 := [EMPTY_TYPE, t_3]
	t_5 := [t_4, INT]
	t_6 := [EMPTY_TYPE, EMPTY_TYPE]
	t_7 := [INT | EMPTY_TYPE]
	t_8 := [t_6 => t_7]
	t_9 := [t_5 => t_8]
	t_10 := [#_...==... t_3]
	t_11 := [{EMPTY_TYPE} + t_10]
	t_12 := [t_11 => INT]
	t_13 := [t_9 => t_12]

§DEF d_0 € t_9
	_X := §2ND ENV
	r_13 := §1ST ENV
	_...==... := §2ND r_13
	r_14 := §1ST r_13
	r_12 := §1ST ARG
	r_11 := §2ND ARG
	r_1 := EMPTY, _X
	r_2 := 1
	r_3 := r_1, r_2
	r_4 := ._...==... r_3
	r_5 := 11
	§RETURN r_5 IF r_4
	r_6 := EMPTY, _X
	r_7 := 2
	r_8 := r_6, r_7
	r_9 := ._...==... r_8
	r_10 := 22
	§RETURN r_10 IF r_9
	§RETURN EMPTY IF TRUE

§DEF d_1 € t_13
	d_0 := ENV
	r_1 := {ARG} #_...==...
	_...==... := r_1
	r_2 := 1
	_X := r_2
	r_4 := EMPTY, _...==...
	r_5 := r_4, _X
	r_6 := §CLOSURE d_0 r_5
	r_7 := EMPTY, EMPTY
	r_8 := OBJ, r_6
	r_9 := §OBJ:r_8 r_7
	r_3 := r_9
	_Y := r_3
	§RETURN _Y IF TRUE
