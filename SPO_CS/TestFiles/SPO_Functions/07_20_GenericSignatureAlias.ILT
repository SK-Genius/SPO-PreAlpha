§TYPES
	t_0 := [§FREE TYPE]
	t_1 := [t_0 => t_0]
	t_2 := [§ALL t_0 => t_1]
	t_3 := [TYPE => TYPE]
	t_4 := [§FREE TYPE]
	t_5 := [t_4 => t_4]
	t_6 := [§ALL t_4 => t_5]
	t_7 := [EMPTY_TYPE => t_6]
	t_8 := [§FREE TYPE]
	t_9 := [t_8 => t_8]
	t_10 := [§ALL t_8 => t_9]
	t_11 := [EMPTY_TYPE, INT]
	t_12 := [t_11, FALSE]
	t_13 := [t_10 => t_12]
	t_14 := [EMPTY_TYPE => t_13]
	t_15 := [EMPTY_TYPE, t_7]
	t_16 := [t_15, t_14]
	t_17 := [t_11, TRUE]
	t_18 := [t_17, t_12]
	t_19 := [EMPTY_TYPE => t_18]
	t_20 := [t_16 => t_19]

§DEF d_0 € t_7
	_Value := ARG
	§RETURN _Value IF TRUE

§DEF d_1 € t_14
	_F... := ARG
	r_1 := 9
	r_2 := ._F... r_1
	r_3 := EMPTY, r_2
	r_4 := ._F... FALSE
	r_5 := r_3, r_4
	§RETURN r_5 IF TRUE

§DEF d_2 € t_20
	d_1 := §2ND ENV
	r_11 := §1ST ENV
	d_0 := §2ND r_11
	r_12 := §1ST r_11
	r_1 := §WITH_TYPE t_3 WITH t_2
	_Signature... := r_1
	r_2 := §CLOSURE d_0 EMPTY
	_Identity... := r_2
	r_3 := §CLOSURE d_1 EMPTY
	_Use... := r_3
	r_4 := 7
	r_5 := ._Identity... r_4
	r_6 := EMPTY, r_5
	r_7 := ._Identity... TRUE
	r_8 := r_6, r_7
	r_9 := ._Use... _Identity...
	r_10 := r_8, r_9
	§RETURN r_10 IF TRUE
