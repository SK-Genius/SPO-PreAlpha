§TYPES
	t := [§FREE TYPE]
	Body := [t => t]
	Identity := [§ALL INT => Body]
	IdDef := [EMPTY_TYPE => Identity]
	Func := [EMPTY_TYPE => TYPE]
	Def := [IdDef => Func]
§DEF identity € IdDef
	§RETURN ARG IF TRUE
§DEF main € Def
	id := .ENV EMPTY
	seven := 7
	value := .id seven
	flag := .id TRUE
	t := [§FREE Type_TYPE]
	Body := [t => t]
	T := [§ALL INT => Body]
	result := .T INT_TYPE
	§RETURN result IF TRUE
