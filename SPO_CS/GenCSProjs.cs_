var BaseFolder = mFS.CWD() / mFS.Path(args.Length > 0 ? args[0] : ".");
var SrcBaseFolder = BaseFolder / "src";
var ProjBaseFolder = BaseFolder / ".proj";
var BinBaseFolder = BaseFolder / "bin";

var ProjectDependenciesMap = mTreeMap.Tree<tText, mStream.tStream<tText>>(
	(a1, a2) => mMath.Sign(tText.CompareOrdinal(a1, a2)),
	[]
);

if (ProjBaseFolder.Exists()) {
	ProjBaseFolder.TryRemove();
	ProjBaseFolder.TryCreate();
}

foreach (
	var                                       CS_File in SrcBaseFolder.GetFiles(
	).Where(
		_ => _.Name.EndsWith(".cs")
	)
) {
	var ProjName = System.IO.Path.GetFileNameWithoutExtension(CS_File.Name);
	var ProjFolder = ProjBaseFolder / (SrcBaseFolder >> CS_File).AssertNotEmpty() / ".." / ProjName;
	
	var ProjDep = CS_File.TryReadLines(
	).ElseThrow(
	).TakeWhile(
		_ => _.StartsWith("// IMPORT ")
	).Map(
		_ => _["// IMPORT ".Length..].Trim()
	);
	
	var ProjectReferences = ProjDep.Map(
		_ => $"""
					<ProjectReference Include="{"../" + _ + '/' + _.Split('/')[^1] + ".csproj"}" />
			"""
	);
	if (!ProjFolder._Path.ToText().Contains("Common")) {
		ProjectReferences = mStream.Stream(
			$"""
					<ProjectReference Include="{(ProjFolder >> BaseFolder).AssertNotEmpty().ToText()}/../TestRunner/FakeTestAdapter/FakeTestAdapter.csproj" />
					<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.3" />
			""",
			ProjectReferences
		);
	}
	var CSProjFile = ProjFolder.GetFile(ProjName + ".csproj");
	var FullProjName = (ProjBaseFolder >> ProjFolder).AssertNotEmpty().ToText();
	
	// build csproj content
	var CSProjContent = $"""
		<Project Sdk="Microsoft.NET.Sdk">
			
			<PropertyGroup>
				{(ProjName == "mRunTests" ? "<OutputType>Exe</OutputType>" : "")}
				<OutputPath>{BinBaseFolder}</OutputPath>
				<Deterministic>true</Deterministic>
			</PropertyGroup>
			
			<ItemGroup>
				<Compile Include="{(ProjFolder >> CS_File).AssertNotEmpty($"{ProjFolder._Path.ToText()} >> {(ProjBaseFolder._Path / CS_File.Name).ToText()}").ToText()}" />
				<Compile Include="{(ProjFolder >> SrcBaseFolder / "_GlobalUsings.cs").AssertNotEmpty($"{ProjFolder._Path.ToText()} >> {SrcBaseFolder._Path.ToText()} / _GlobalUsings.cs").ToText()}" />
			</ItemGroup>
			
			<ItemGroup>
		{tText.Join("\n", ProjectReferences.ToArrayList().ToArray())}
			</ItemGroup>
			
		</Project>
		""";
	
	var LastSlashIndex = FullProjName.LastIndexOf('/');
	var DepPrefix = LastSlashIndex > 0 ? FullProjName[..(LastSlashIndex + 1)] : "";
	
	ProjectDependenciesMap = ProjectDependenciesMap.Set (
		FullProjName,
		ProjDep.Map(_ => DepPrefix + _)
	);
	
	if (!ProjFolder.Exists()) {
		ProjFolder.TryCreate();
	}
	
	System.Console.WriteLine($"  Project: {(ProjFolder._Path / CSProjFile.Name).ToText()}");
	CSProjFile.TryCreate(CSProjContent);
}

foreach (var Proj in ProjectDependenciesMap.ToStream()) {
	UpdateDeps(ref ProjectDependenciesMap, Proj.Key, mStd.cEmpty);
}

System.Console.WriteLine("END");

static mStream.tStream<tText> UpdateDeps(
	ref mTreeMap.tTree<tText, mStream.tStream<tText>> aTree,
	tText aProj,
	mStream.tStream<tText> aDepPath
) {
	var Deps = aTree.TryGet(aProj).AssertNotEmpty(aProj);
	var NewDepPath = mStream.Stream(aProj, aDepPath);
	
	foreach (var Dep in Deps) {
		if (NewDepPath.Any(_ => _ == Dep)) {
			throw mError.Error(
				tText.Join(" -> ", mStream.Stream(Dep, NewDepPath).Reverse().ToArrayList().ToArray())
			);
		}
		
		var NewDeps = UpdateDeps(ref aTree, Dep, NewDepPath);
		Deps = Merge(Deps, NewDeps);
	}
	
	aTree = aTree.Set(aProj, Deps);
	
	return Deps;
}

static mStream.tStream<tText> Merge(
	mStream.tStream<tText> a1,
	mStream.tStream<tText> a2
) {
	if (a2.Is(out var Head, out var Tail)) {
		return Merge(
			a1.Any(_ => _ == Head) ? a1 : mStream.Stream(Head, a1),
			Tail
		);
	} else {
		return a1;
	}
}