§TYPES
	t_0 := [EMPTY_TYPE, BOOL]
	t_1 := [t_0, BOOL]
	t_2 := [t_1 => BOOL]
	t_3 := [#_...&... t_2]
	t_4 := [{EMPTY_TYPE} + t_3]
	t_5 := [EMPTY_TYPE, BOOL]
	t_6 := [t_5, BOOL]
	t_7 := [t_6, BOOL]
	t_8 := [t_7, BOOL]
	t_9 := [t_4 => t_8]
	t_10 := [EMPTY_TYPE => t_9]

§DEF d_0 € t_10
	r_1 := {ARG} #_...&...
	_...&... := r_1
	r_2 := EMPTY, FALSE
	r_3 := r_2, FALSE
	r_4 := ._...&... r_3
	r_5 := EMPTY, r_4
	r_6 := EMPTY, FALSE
	r_7 := r_6, TRUE
	r_8 := ._...&... r_7
	r_9 := r_5, r_8
	r_10 := EMPTY, TRUE
	r_11 := r_10, FALSE
	r_12 := ._...&... r_11
	r_13 := r_9, r_12
	r_14 := EMPTY, TRUE
	r_15 := r_14, TRUE
	r_16 := ._...&... r_15
	r_17 := r_13, r_16
	§RETURN r_17 IF TRUE
