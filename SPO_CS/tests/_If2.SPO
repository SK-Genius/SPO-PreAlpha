§IMPORT (
	{
		...<...: §DEF ...<... € [[§INT, §INT] => §BOOL]
		...==...: §DEF ...==... € [[§INT, §INT] => §BOOL]
		...+...: §DEF ...+... € [[§INT, §INT] => §INT]
		...-...: §DEF ...-... € [[§INT, §INT] => §INT]
	}
	§DEF n € §INT
)

§RECURSIVE {
	§DEF Fib... = (§DEF a € §INT) => §IF {
		a .< 2 => a
		1 .== 1 => ((.Fib(a .- 2)) .+ (.Fib(a .- 1)))
	}
}

§EXPORT .Fib n
