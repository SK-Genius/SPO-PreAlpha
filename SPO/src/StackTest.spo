§DEF tStack... = [§GENERIC t [§RECURSIVE tStack_ [[] | [t, tStack_]]]

§IMPORT {
	Std: {
		...*...: §DEF ...*... € [[§INT, §INT] => §INT]
		...==...: §DEF ...==... € [[§INT, §INT] => §BOOL]
		!...: §DEF !... € [§BOOL => §BOOL]
		...&...: §DEF ...&... € [[§BOOL, §BOOL] => §BOOL]
	}
	Stack: {
		Push...To...: §DEF Push...To... € [§GENERIC t [[t, .tStack t] => [.tStack t]]]
		Map...With...: §DEF Map...With... € [§GENERIC tIn, tOut [.tStack tIn, tIn => tOut] => [.Stack tOut]]
	}
}

§RECURSIVE {
	§DEF StackEq... = (
		t € §TYPE
	) <=> (
		§DEF ...a==... € [[t, t] => §BOOL]
	) => {
		§DEF+ ...==... = ...a==...
		§DEF+ ...==... = .StackEq ...a==...
		§RETURN (
			§DEF a1 € [.tStack t]
			§DEF a2 € [.tStack t]
		) => §IF (a1, a2) MATCH {
			(
				(§DEF Head1, §DEF Tail1)
				(§DEF Head2, §DEF Tail2)
			) => (Head1 .== Head2) .& (Tail1 .== Tail2)
			(
				()
				()
			) => §TRUE
			_ => §FALSE
		}
	}
}

§DEF+ ...==... = .StackEq ...==...

§DEF RunTest = () => (
	.Map (.Push 3 To §< .Push 2 To §< .Push 1 To §< ()) With (§DEF x => x .* x)
) .== (
	.Push 9 To §< .Push 4 To §< .Push 1 To §< ()
)

§EXPORT {
	RunTest: RunTest
}
