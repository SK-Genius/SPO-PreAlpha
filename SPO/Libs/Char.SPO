§IMPORT {
	Std: {
		...+...: §DEF ...+...
		...-...: §DEF ...-...
		...==...: §DEF ...==...
		...!=...: §DEF ...!=...
		...<=...: §DEF ...<=...
		...And...: §DEF ...And...
		...Or...: §DEF ...Or...
	} € [§LOAD "Std.SIG"]
}

§DEF ...<=>... = (
	§DEF aLeft € §INT
	§DEF aRight € §INT
) => §IF {
	aLeft .== aRight: 0
	aLeft .<= aRight: -1
	§TRUE: 1
}

§DEF ...Ord = (
	§DEF a € §CHAR
) => {
	(#Char §DEF Ord) = a
	§RETURN Ord
}

§DEF ...AsChar = (
	§DEF a € §INT
) => #Char a

§DEF ...<=...<=... = (
	§DEF aMin € §INT
	§DEF a € §INT
	§DEF aMax € §INT
) => (aMin .<= a) .And (a .<= aMax)

§DEF ...Char<=...<=... = (
	§DEF aMin € §CHAR
	§DEF a € §CHAR
	§DEF aMax € §CHAR
) => (aMin .Ord) .<= (a .Ord) <= (aMax .Ord)

§DEF ...Char<=>... = (
	§DEF aLeft € §CHAR
	§DEF aRight € §CHAR
) => (aLeft .Ord) .<=> (aRight .Ord)

§DEF ...Char==... = (
	§DEF aLeft € §CHAR
	§DEF aRight € §CHAR
) => §IF (aLeft .Char<=> aRight) MATCH {
	0: §TRUE
	_: §FALSE
}

§DEF ...Char!=... = (
	§DEF aLeft € §CHAR
	§DEF aRight € §CHAR
) => §IF (aLeft .Char<=> aRight) MATCH {
	0: §FALSE
	_: §TRUE
}

§DEF ...Char>... = (
	§DEF aLeft € §CHAR
	§DEF aRight € §CHAR
) => §IF (aLeft .Char<=> aRight) MATCH {
	1: §TRUE
	_: §FALSE
}

§DEF ...Char<... = (
	§DEF aLeft € §CHAR
	§DEF aRight € §CHAR
) => §IF (aLeft .Char<=> aRight) MATCH {
	-1: §TRUE
	_: §FALSE
}

§DEF ...Char>=... = (
	§DEF aLeft € §CHAR
	§DEF aRight € §CHAR
) => §IF (aLeft .Char<=> aRight) MATCH {
	-1: §FALSE
	_: §TRUE
}

§DEF ...Char<=... = (
	§DEF aLeft € §CHAR
	§DEF aRight € §CHAR
) => §IF (aLeft .Char<=> aRight) MATCH {
	1: §FALSE
	_: §TRUE
}

§DEF ...IsSpace = (
	§DEF aCharacter € §CHAR
) => {
	§DEF cTabOrdinal = 9
	§DEF cCarriageReturnOrdinal = 13
	§DEF cSpaceOrdinal = 32
	§DEF Ordinal = aCharacter .Ord
	§RETURN (cTabOrdinal .<= Ordinal <= cCarriageReturnOrdinal) .Or (Ordinal .== cSpaceOrdinal)
}

§DEF ...ToUpper = (
	§DEF a € §CHAR
) => §IF {
	§a .Char<= a <= §z: (
		(((a .Ord) .+ (§A.Ord)) .- (§a.Ord)) .AsChar
	)
	§TRUE: (
		a
	)
}

§DEF ...ToLower = (
	§DEF a € §CHAR
) => §IF {
	§A .Char<= a <= §Z: (
		(((a .Ord) .+ (§a.Ord)) .- (§A.Ord)) .AsChar
	)
	§TRUE: (
		a
	)
}

§DEF cModule € [§LOAD "Char.SIG"] = {
	...<=...<=...: ...Char<=...<=...
	...<=>...: ...Char<=>...
	...==...: ...Char==...
	...!=...: ...Char!=...
	...>...: ...Char>...
	...<...: ...Char<...
	...>=...: ...Char>=...
	...<=...: ...Char<=...
	...Ord: ...Ord
	...AsChar: ...AsChar
	...ToUpper: ...ToUpper
	...ToLower: ...ToLower
	...IsSpace: ...IsSpace
}

§EXPORT cModule