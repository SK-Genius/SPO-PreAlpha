§IMPORT {}

§DEF tStyle = [§LOAD "TextStyle.SIG"]
§DEF tColor = [§LOAD "Color.SIG"]

§DEF cDefaultStyle = {
	Foreground: #Gray
	Background: #Black
	Blink: §FALSE
	Underline: §FALSE
	Inverse: §FALSE
}

§DEF ...WithForeground... = (
	§DEF aStyle € tStyle
	§DEF aColor € tColor
) => {
	{
		Background: §DEF Background
		Blink: §DEF Blink
		Underline: §DEF Underline
		Inverse: §DEF Inverse
	} = aStyle
	§RETURN {
		Foreground: aColor
		Background: Background
		Blink: Blink
		Underline: Underline
		Inverse: Inverse
	}
}

§DEF ...WithBackground... = (
	§DEF aStyle € tStyle
	§DEF aColor € tColor
) => {
	{
		Foreground: §DEF Foreground
		Blink: §DEF Blink
		Underline: §DEF Underline
		Inverse: §DEF Inverse
	} = aStyle
	§RETURN {
		Foreground: Foreground
		Background: aColor
		Blink: Blink
		Underline: Underline
		Inverse: Inverse
	}
}

§DEF ...WithBlink... = (
	§DEF aStyle € tStyle
	§DEF aEnabled € §BOOL
) => {
	{
		Foreground: §DEF Foreground
		Background: §DEF Background
		Underline: §DEF Underline
		Inverse: §DEF Inverse
	} = aStyle
	§RETURN {
		Foreground: Foreground
		Background: Background
		Blink: aEnabled
		Underline: Underline
		Inverse: Inverse
	}
}

§DEF ...WithUnderline... = (
	§DEF aStyle € tStyle
	§DEF aEnabled € §BOOL
) => {
	{
		Foreground: §DEF Foreground
		Background: §DEF Background
		Blink: §DEF Blink
		Inverse: §DEF Inverse
	} = aStyle
	§RETURN {
		Foreground: Foreground
		Background: Background
		Blink: Blink
		Underline: aEnabled
		Inverse: Inverse
	}
}

§DEF ...WithInverse... = (
	§DEF aStyle € tStyle
	§DEF aEnabled € §BOOL
) => {
	{
		Foreground: §DEF Foreground
		Background: §DEF Background
		Blink: §DEF Blink
		Underline: §DEF Underline
	} = aStyle
	§RETURN {
		Foreground: Foreground
		Background: Background
		Blink: Blink
		Underline: Underline
		Inverse: aEnabled
	}
}

§DEF cModule € [§LOAD "Style.SIG"] = {
	DefaultStyle: cDefaultStyle
	...WithForeground...: ...WithForeground...
	...WithBackground...: ...WithBackground...
	...WithBlink...: ...WithBlink...
	...WithUnderline...: ...WithUnderline...
	...WithInverse...: ...WithInverse...
}

§EXPORT cModule