§IMPORT {
	Std: {
		...+...: §DEF ...+...
		...-...: §DEF ...-...
		...*...: §DEF ...*...
		.../...: §DEF .../...
		...%...: §DEF ...%...
		...==...: §DEF ...==...
		...<...: §DEF ...<...
		...And...: §DEF ...And...
		...Or...: §DEF ...Or...
		Not...: §DEF Not...
	} € [§LOAD "../../Libs/Std.SIG"]
	Random: {
		...NextRandom: §DEF ...NextRandom
	} € [§LOAD "../../Libs/Random.SIG"]
}

§DEF tBoard = [§LOAD "Board.SIG"]
§DEF tRow = [§LOAD "Row.SIG"]
§DEF tState = [§LOAD "State.SIG"]
§DEF cBoardSize = 4
§DEF cCellCount = cBoardSize .* cBoardSize

§DEF ...TileAt... = (
	§DEF aBoard € tBoard
	(§DEF aColumn € §INT, §DEF aRow € §INT)
) => {
	(§DEF First, §DEF Second, §DEF Third, §DEF Fourth) = aBoard
	§DEF Row = §IF aRow MATCH {
		0: First
		1: Second
		2: Third
		3: Fourth
		_: (0, 0, 0, 0)
	}
	(§DEF A, §DEF B, §DEF C, §DEF D) = Row
	§RETURN §IF aColumn MATCH {
		0: A
		1: B
		2: C
		3: D
		_: 0
	}
}

§DEF ...WithRandomTile = (
	§DEF aState € tState
) => {
	{Board: §DEF Board, RandomState: §DEF RandomState} = aState
	§RECURSIVE {
		§DEF CountFreeCellsFrom... = (
			§DEF aIndex € §INT
		) => {
			§RETURN 0 IF aIndex .== cCellCount
			§DEF IsEmpty = (Board .TileAt (aIndex .% cBoardSize, aIndex ./ cBoardSize)) .== 0
			§DEF FreeCell = §IF IsEmpty MATCH {
				§TRUE: 1
				§FALSE: 0
			}
			§RETURN FreeCell .+ (.CountFreeCellsFrom (aIndex .+ 1))
		}
	}
	§DEF FreeCellCount = .CountFreeCellsFrom 0
	§RETURN aState IF FreeCellCount .== 0
	§DEF PositionRandom = RandomState .NextRandom
	§DEF ValueRandom = PositionRandom .NextRandom
	§DEF Value = §IF ((ValueRandom .% 10) .== 0) MATCH {
		§TRUE: 4
		§FALSE: 2
	}
	§RECURSIVE {
		§DEF FindFreeCellFrom...Skipping... = (
			§DEF aIndex € §INT
			§DEF aFreeCellsToSkip € §INT
		) => {
			§DEF Position = (aIndex .% cBoardSize, aIndex ./ cBoardSize)
			§DEF IsEmpty = (Board .TileAt Position) .== 0
			§RETURN §IF (IsEmpty, aFreeCellsToSkip) MATCH {
				(§TRUE, 0): Position
				(§TRUE, _): .FindFreeCellFrom (aIndex .+ 1) Skipping (aFreeCellsToSkip .- 1)
				_: .FindFreeCellFrom (aIndex .+ 1) Skipping aFreeCellsToSkip
			}
		}
	}
	§DEF Position € [§INT, §INT] = .FindFreeCellFrom 0 Skipping ((PositionRandom .- 1) .% FreeCellCount)
	(§DEF Column, §DEF Row) = Position
	§DEF ...WithTile = (
		§DEF aRow € tRow
	) => {
		(§DEF A, §DEF B, §DEF C, §DEF D) = aRow
		§RETURN §IF Column MATCH {
			0: (Value, B, C, D)
			1: (A, Value, C, D)
			2: (A, B, Value, D)
			3: (A, B, C, Value)
			_: aRow
		}
	}
	(§DEF A, §DEF B, §DEF C, §DEF D) = Board
	§DEF NextBoard = §IF Row MATCH {
		0: (A .WithTile, B, C, D)
		1: (A, B .WithTile, C, D)
		2: (A, B, C .WithTile, D)
		3: (A, B, C, D .WithTile)
		_: Board
	}
	§RETURN { aState; Board: NextBoard, RandomState: ValueRandom }
}

§DEF NewGameWithSeed... = (
	§DEF aSeed € §INT
) => {
	§DEF cEmptyRow = (0, 0, 0, 0)
	§DEF Empty = {
		Board: (cEmptyRow, cEmptyRow, cEmptyRow, cEmptyRow)
		Score: 0
		RandomState: aSeed
	}
	§RETURN (Empty .WithRandomTile) .WithRandomTile
}

§DEF ...AfterMove... = (
	§DEF aState € tState
	§DEF aDirection € [§LOAD "Direction.SIG"]
) => {
	§DEF ...Transposed = (
		§DEF aBoard € tBoard
	) => {
		(
			(§DEF A, §DEF B, §DEF C, §DEF D)
			(§DEF E, §DEF F, §DEF G, §DEF H)
			(§DEF I, §DEF J, §DEF K, §DEF L)
			(§DEF M, §DEF N, §DEF O, §DEF P)
		) = aBoard
		§RETURN ((A, E, I, M), (B, F, J, N), (C, G, K, O), (D, H, L, P))
	}
	§DEF ...ReversedRows = (
		§DEF aBoard € tBoard
	) => {
		§DEF ...Reversed = (
			(§DEF aA € §INT, §DEF aB € §INT, §DEF aC € §INT, §DEF aD € §INT)
		) => (aD, aC, aB, aA)
		(§DEF A, §DEF B, §DEF C, §DEF D) = aBoard
		§RETURN (A .Reversed, B .Reversed, C .Reversed, D .Reversed)
	}
	§DEF ...SlidLeft = (
		(§DEF aA € §INT, §DEF aB € §INT, §DEF aC € §INT, §DEF aD € §INT)
	) => {
		§DEF ...AppendingNonzero... = (
			§DEF aRow € tRow
			§DEF aValue € §INT
		) => §IF (aValue, aRow) MATCH {
			(0, _): aRow
			(_, (0, _, _, _)): (aValue, 0, 0, 0)
			(_, (§DEF A, 0, _, _)): (A, aValue, 0, 0)
			(_, (§DEF A, §DEF B, 0, _)): (A, B, aValue, 0)
			(_, (§DEF A, §DEF B, §DEF C, _)): (A, B, C, aValue)
		}
		§DEF FirstPair = (0, 0, 0, 0) .AppendingNonzero aA §> .AppendingNonzero aB
		§DEF Compact = FirstPair .AppendingNonzero aC §> .AppendingNonzero aD
		(§DEF First, §DEF Second, §DEF Third, §DEF Fourth) = Compact
		§RETURN §IF ((0 .< First) .And (First .== Second)) MATCH {
			§TRUE: {
				§DEF Merged = First .* 2
				§RETURN §IF ((0 .< Third) .And (Third .== Fourth)) MATCH {
					§TRUE: {Row: (Merged, Third .* 2, 0, 0), Score: Merged .+ (Third .* 2)}
					§FALSE: {Row: (Merged, Third, Fourth, 0), Score: Merged}
				}
			}
			§FALSE: {
				§RETURN {
					Row: (First, Second .* 2, Fourth, 0)
					Score: Second .* 2
				} IF (0 .< Second) .And (Second .== Third)
				§RETURN {
					Row: (First, Second, Third .* 2, 0)
					Score: Third .* 2
				} IF (0 .< Third) .And (Third .== Fourth)
				§RETURN {Row: Compact, Score: 0}
			}
		}
	}
	{Board: §DEF Board, Score: §DEF Score} = aState
	§DEF Oriented = §IF aDirection MATCH {
		#Left: Board
		#Right: Board .ReversedRows
		#Up: Board .Transposed
		#Down: (Board .Transposed) .ReversedRows
	}
	(§DEF A, §DEF B, §DEF C, §DEF D) = Oriented
	{Row: §DEF First, Score: §DEF FirstScore} = A .SlidLeft
	{Row: §DEF Second, Score: §DEF SecondScore} = B .SlidLeft
	{Row: §DEF Third, Score: §DEF ThirdScore} = C .SlidLeft
	{Row: §DEF Fourth, Score: §DEF FourthScore} = D .SlidLeft
	§DEF Slid = (First, Second, Third, Fourth)
	§DEF NextBoard = §IF aDirection MATCH {
		#Left: Slid
		#Right: Slid .ReversedRows
		#Up: Slid .Transposed
		#Down: (Slid .ReversedRows) .Transposed
	}
	§RECURSIVE {
		§DEF ChangedFrom... = (
			§DEF aIndex € §INT
		) => {
			§RETURN §FALSE IF aIndex .== cCellCount
			§DEF Position = (aIndex .% cBoardSize, aIndex ./ cBoardSize)
			§RETURN §TRUE IF .Not ((Board .TileAt Position) .== (NextBoard .TileAt Position))
			§RETURN .ChangedFrom (aIndex .+ 1)
		}
	}
	§RETURN aState IF .Not (.ChangedFrom 0)
	§RETURN {
		aState;
		Board: NextBoard
		Score: (Score .+ FirstScore §> .+ SecondScore §> .+ ThirdScore §> .+ FourthScore)
	} .WithRandomTile
}

§DEF ...CanMove = (
	§DEF aBoard € tBoard
) => {
	§RECURSIVE {
		§DEF CanMoveFrom... = (
			§DEF aIndex € §INT
		) => {
			§RETURN §FALSE IF aIndex .== cCellCount
			§DEF Column = aIndex .% cBoardSize
			§DEF Row = aIndex ./ cBoardSize
			§DEF Tile = aBoard .TileAt (Column, Row)
			§RETURN §TRUE IF Tile .== 0
			§DEF RightMatches = §IF (Column .< (cBoardSize .- 1)) MATCH {
				§TRUE: Tile .== (aBoard .TileAt (Column .+ 1, Row))
				§FALSE: §FALSE
			}
			§DEF DownMatches = §IF (Row .< (cBoardSize .- 1)) MATCH {
				§TRUE: Tile .== (aBoard .TileAt (Column, Row .+ 1))
				§FALSE: §FALSE
			}
			§RETURN §TRUE IF RightMatches .Or DownMatches
			§RETURN .CanMoveFrom (aIndex .+ 1)
		}
	}
	§RETURN .CanMoveFrom 0
}

§DEF ...LargestTile = (
	§DEF aBoard € tBoard
) => {
	§RECURSIVE {
		§DEF LargestFrom...With... = (
			§DEF aIndex € §INT
			§DEF aLargest € §INT
		) => {
			§RETURN aLargest IF aIndex .== cCellCount
			§DEF Tile = aBoard .TileAt (aIndex .% cBoardSize, aIndex ./ cBoardSize)
			§DEF Largest = §IF (aLargest .< Tile) MATCH {
				§TRUE: Tile
				§FALSE: aLargest
			}
			§RETURN .LargestFrom (aIndex .+ 1) With Largest
		}
	}
	§RETURN .LargestFrom 0 With 0
}

§DEF cModule € [§LOAD "Logic.SIG"] = {
	BoardSize: cBoardSize
	NewGameWithSeed...: NewGameWithSeed...
	...AfterMove...: ...AfterMove...
	...TileAt...: ...TileAt...
	...CanMove: ...CanMove
	...LargestTile: ...LargestTile
}
§EXPORT cModule